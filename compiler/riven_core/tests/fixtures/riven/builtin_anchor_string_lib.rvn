# #06.8 T#21 pin fixture — namespace-anchor mode for builtin class names.
#
# Loaded as a hand-rolled bootstrap program: declares a `class String`
# whose body contains only a `lib "riven_runtime"` block. Under
# T#21's anchor mode the resolver MUST NOT replace the existing
# type-scope binding (`String` → `DefKind::TypeAlias { target:
# Ty::String }`) with a fresh `DefKind::Class`. The lib decl's
# C-symbol alias must still land in `HirProgram.ffi_libs` (and
# therefore in MIR's `ffi_alias_map`) keyed on the mangled
# `String_len_via_anchor` so a method call would rewrite to
# `riven_string_len` at lowering time.
#
# The method name is intentionally `len_via_anchor` rather than `len`
# so the pin test can distinguish the anchor-FFI rewrite from any
# existing runtime_table fallback for the canonical `String_len`.

class String
  lib "riven_runtime"
    def len_via_anchor as "riven_string_len"(self) -> Int
  end
end
