use std.time.Instant
use std.time.Duration
use std.thread.sleep

def main
  let start = Instant.now()
  sleep(Duration.from_millis(50))
  let elapsed = start.elapsed()
  # Tolerance band 40–200 ms. CI jitter on macOS can stretch the upper
  # bound; lower bound below 50 catches kernel-side coarse sleep.
  let nanos = elapsed.as_nanos()
  let lo = 40000000  # 40 ms
  let hi = 200000000 # 200 ms
  if nanos >= lo && nanos <= hi
    puts "ok"
  else
    puts "fail nanos=#{nanos}"
  end
end
