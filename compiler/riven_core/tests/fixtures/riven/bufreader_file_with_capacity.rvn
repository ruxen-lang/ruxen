use std.io.File
use std.io.BufReader

def show(line: String)
  puts "line=#{line}"
end

def report(opt: Option[String])
  match opt
    Some(line) -> show(line)
    None       -> puts "eof"
  end
end

def read_one(br: BufReader[File])
  match br.read_line()
    Ok(opt) -> report(opt)
    Err(_)  -> puts "read_fail"
  end
end

def main
  match File.open("__FILE__")
    Ok(f)  -> read_one(BufReader.with_capacity(16, f))
    Err(_) -> puts "open_fail"
  end
end
