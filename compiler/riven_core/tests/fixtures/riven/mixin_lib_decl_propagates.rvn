# Pre-flight spike for #06.95 (stdlib packagization).
#
# Question: does a mixin's `lib "X" ... end` FFI block surface as a
# callable method on a class that `include`s the mixin?
#
# The module + mixin pattern the 06.95 plan depends on (BufReader.File /
# BufReader.Tcp sharing instance methods via `include Reader`) only
# works if this propagation is wired. Today the parser captures the
# mixin lib decls into `MixinDef.lib_decls` and the resolver registers
# them as methods on the mixin's DefId — but it is unclear whether the
# `include` machinery surfaces those methods on the including class.
#
# This fixture asserts the surface: a class `Thing` includes a mixin
# `Adder` whose lib block declares `add_one` aliased to the runtime
# test symbol `riven_test_extern_add_one`. User code calls
# `Thing.add_one(41)` and expects 42.

mixin Adder
  lib "riven_runtime"
    def self.add_one as "riven_test_extern_add_one"(x: Int) -> Int
  end
end

class Thing
  include Adder
end

def main() -> Int
  let r = Thing.add_one(41)
  if r == 42
    0
  else
    1
  end
end
