use std.io.File
use std.bufio.BufWriter

def write_payload(bw: BufWriter.File, bytes: &Array[Int])
  match bw.write_all(bytes)
    Ok(_)  -> puts "write_all=ok"
    Err(_) -> puts "write_all=err"
  end
  match bw.flush()
    Ok(_)  -> puts "flush=ok"
    Err(_) -> puts "flush=err"
  end
end

def write_into(f: File)
  let bw = BufWriter.File.new(f)
  var bytes: Array[Int] = Array.new
  bytes.push(104) # h
  bytes.push(105) # i
  bytes.push(33)  # !
  write_payload(bw, &bytes)
end

def main
  match File.create("__FILE__")
    Ok(f)  -> write_into(f)
    Err(_) -> puts "open_fail"
  end
end
