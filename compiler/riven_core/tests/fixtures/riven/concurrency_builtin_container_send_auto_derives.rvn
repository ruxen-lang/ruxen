## Pin: B2 — built-in containers auto-derive Send/Sync when their
## type params are Send/Sync. Int is primitive → Send + Sync, so
## Array[Int] / Option[Int] / Map[Int, Int] all wrap into Mutex without
## triggering E1101. (Negative auto-derive cases live in
## concurrency_negative.rs.)
## See docs/specs/ownership/send_sync_enforcement.spec.md §B2.

def main
  let arr: Array[Int] = [1, 2, 3]
  let m1 = Mutex.new(arr)
  let s1 = SharedSync.new(arr)
  let _ = m1
  let _ = s1
end
