## Spec docs/specs/stdlib/task_spawn.spec.md §B4 (commit 2 surface):
## `Task.join(handle)` returns a `TaskJoinFuture` value that
## typechecks at the receiver position. Hand-poll usage shown to
## verify the surface is reachable; the .await sugar is gated on
## the deferred async-lowering fix (see lib.rx doc comment +
## 731_class_static_call_await.rx.deferred).
class CountdownFuture
  remaining: Int
  include Future
  type Output = Int

  def init(n: Int)
    self.remaining = n
  end

  def var poll(cx: &var Context) -> Poll[Int]
    if self.remaining == 0
      Poll.Ready(42)
    else
      self.remaining = self.remaining - 1
      Poll.Pending
    end
  end
end

async def driver -> Int
  let fut = CountdownFuture.new(0)
  let h = Task.spawn_raw(fut)
  # Hand-poll the join future once to prove the surface typechecks.
  # In practice the orchestrator drives this in a loop until Ready
  # (see 728 e2e); single-poll here is for typeck coverage.
  let var join = Task.join(h)
  let var cx = Context.test_dummy()
  match (&var join).poll(&var cx)
    Poll.Ready(v) -> v
    Poll.Pending  -> 0
  end
end

def main
  let _r = block_on(driver())
end
