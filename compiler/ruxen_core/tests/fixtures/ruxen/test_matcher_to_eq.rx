use std.test.Tester
use std.test.Runner

def main
  let r = Runner.new("fixture.matcher_to_eq")
  Runner.set_current(r.handle_addr)

  Tester.describe("Matcher") do |t: &var Tester|
    t.it("to_eq passes on equal values") do
      t.expect(1 + 2).to_eq(3)
    end
    t.it("not_to_eq passes on unequal values") do
      t.expect(1 + 2).not_to_eq(4)
    end
  end

  r.execute
  if r.passed == 2
    puts "to_eq_pass"
    puts "not_to_eq_pass"
  end
end
