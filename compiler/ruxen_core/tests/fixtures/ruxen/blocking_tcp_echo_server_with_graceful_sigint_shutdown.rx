use std.net.{TcpListener, TcpStream}
use std.env.get

# Phase 2 #06.5 T5: this fixture used to define inline `TcpListener`
# and `TcpStream` shim classes wrapping the flat `tcp_*` free fns.
# The stdlib now ships those classes as auto-imported stdlib types so
# the demo is just a straight import + match-on-Result.

def echo_back(s: TcpStream, bytes: &Array[Int])
  match s.write(bytes)
    Ok(_)  -> nil
    Err(_) -> nil
  end
end

def close_stream(s: TcpStream)
  match s.close()
    Ok(_)  -> nil
    Err(_) -> nil
  end
end

def handle_client(s: TcpStream)
  var buf: Array[Int] = Array.new
  match s.read(&var buf)
    Ok(_n) -> echo_back(s, &buf)
    Err(_) -> nil
  end
  close_stream(s)
end

def accept_one(l: TcpListener)
  match l.accept()
    Ok(stream) -> handle_client(stream)
    # accept() returns Err(IoError.Interrupted) when SIGINT lands
    # during the blocking call — we don't need to inspect the
    # variant; the signal-flag check in the caller decides whether
    # to break out of the loop.
    Err(_) -> nil
  end
end

def serve(l: TcpListener)
  loop
    accept_one(l)
    if signal_received_sigint() != 0
      break
    end
  end
  match l.close()
    Ok(_)  -> nil
    Err(_) -> nil
  end
end

def main
  let p: String = get("RUXEN_NET_PORT").expect!("port env var")
  let addr = "127.0.0.1:#{p}"

  signal_install_sigint()

  match TcpListener.bind(&addr)
    Ok(listener) -> serve(listener)
    Err(_)       -> eputs "bind failed"
  end

  puts "bye"
end
