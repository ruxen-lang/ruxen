use std.net.TcpStream
use std.env.get
use std.time.Duration

# Read up to `cap` bytes from `s` and push them into `out`.
# Loops a bounded number of times because a single read may return
# < cap bytes; the host sends a 5-byte payload then closes its side
# so we'll converge in 1-2 iterations.
def drain_up_to(s: TcpStream, out: &var Array[Int])
  var done = false
  var attempts = 0
  while !done
    if attempts >= 8
      done = true
    else
      match s.read(out)
        Ok(n)  ->
          if n == 0
            done = true
          end
        Err(_) -> done = true
      end
      attempts = attempts + 1
    end
  end
end

def report(buf: &var Array[Int])
  puts "read_len=#{buf.len}"
  var i = 0
  while i < buf.len
    let b = buf[i]
    puts "b#{i}=#{b}"
    i = i + 1
  end
end

def receive(s: TcpStream)
  let t = Duration.from_secs(5)
  match s.set_read_timeout(&t)
    Ok(_)  -> nil
    Err(_) -> puts "set_read_timeout=err"
  end
  # Brief pause so the host has filled the buffer before our first
  # recv — keeps the test deterministic on slow CI.
  Thread.sleep(Duration.from_millis(50))
  var buf: Array[Int] = Array.new
  drain_up_to(s, &var buf)
  report(&var buf)
end

def main
  let p: String = get("RUXEN_NET_TEST_PORT").expect!("port")
  let addr = "127.0.0.1:#{p}"
  match TcpStream.connect(&addr)
    Ok(s)  -> receive(s)
    Err(_) -> puts "connect=err"
  end
end
