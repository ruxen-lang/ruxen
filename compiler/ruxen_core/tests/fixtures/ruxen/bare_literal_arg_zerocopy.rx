# Bare-literal zero-copy: a string literal passed DIRECTLY (no `&`) to a
# `&String` param lowers to the raw `.rodata` pointer, the same as the explicit
# `&"x"` borrow. `borrow_len` reads the literal's length through the raw `char*`;
# no owned String is created, so nothing is allocated or freed.
def borrow_len(s: &String) -> Int
  s.size() as Int
end

def main
  let a = borrow_len("transient")
  let b = borrow_len("hi")
  let _t = a + b
end
