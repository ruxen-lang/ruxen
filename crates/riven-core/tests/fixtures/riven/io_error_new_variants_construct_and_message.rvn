def show(e: IoError) -> String
  e.message()
end

def main
  let cr  = IoError.ConnectionRefused(message: "no listener")
  let cr2 = IoError.ConnectionReset(message: "rst")
  let ca  = IoError.ConnectionAborted(message: "abort")
  let nc  = IoError.NotConnected(message: "no sock")
  let au  = IoError.AddrInUse(message: "in use")
  let an  = IoError.AddrNotAvailable(message: "unavail")
  let id  = IoError.InvalidData(message: "bad bytes")
  let to  = IoError.TimedOut(message: "timeout")
  let wz  = IoError.WriteZero(message: "wrote 0")
  let un  = IoError.Unsupported(message: "nope")
  let oom = IoError.OutOfMemory(message: "no mem")
  puts show(cr)
  puts show(cr2)
  puts show(ca)
  puts show(nc)
  puts show(au)
  puts show(an)
  puts show(id)
  puts show(to)
  puts show(wz)
  puts show(un)
  puts show(oom)
end
