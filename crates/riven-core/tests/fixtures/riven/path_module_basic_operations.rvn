use std.path.{path_join, path_parent, path_file_name, path_extension, path_is_absolute}

def main
  let p = path_join(&"/usr/local", &"bin/riven.rvn")
  puts p
  puts path_parent(&p)
  puts path_file_name(&p)
  puts path_extension(&p)
  if path_is_absolute(&p)
    puts "abs"
  else
    puts "rel"
  end
end
