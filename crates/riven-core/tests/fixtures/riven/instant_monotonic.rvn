use std.time.Instant
use std.time.Duration
use std.thread.sleep

def main
  let a = Instant.now()
  sleep(Duration.from_millis(1))
  let b = Instant.now()
  # `b - a` panics if `a > b` (monotonic clock contract), so the only
  # way this prints "ok" is a strictly-non-negative elapsed.
  let delta = b - a
  if delta.as_nanos() >= 0
    puts "ok"
  else
    puts "fail nanos=#{delta.as_nanos()}"
  end
end
