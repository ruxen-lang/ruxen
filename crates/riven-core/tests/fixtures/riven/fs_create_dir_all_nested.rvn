use std.fs.{create_dir_all, is_dir}

def main
  match create_dir_all("__NESTED__")
    Ok(_)  -> puts "created"
    Err(_) -> puts "create_fail"
  end
  if is_dir("__A__")
    puts "a_yes"
  else
    puts "a_no"
  end
  if is_dir("__B__")
    puts "b_yes"
  else
    puts "b_no"
  end
  if is_dir("__C__")
    puts "c_yes"
  else
    puts "c_no"
  end
end
