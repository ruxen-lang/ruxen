## Concurrency bench — Mutex lock + release + read (single-threaded).
##
## Pins prompt 14's DoD "100k Mutex acquisitions/release < 100ms"
## via the rivenc bench harness. The Bencher auto-scales until total
## wall time ≥ 100ms; the printed `<N> iters, <T> ns total, <P>
## ns/iter` line proves whether the throughput target (1 µs/op for
## 100k/100ms) holds.
##
## Run with:
##
##   rivenc bench tests/benches/sync_mutex.rvn
##
## A ns/iter under 1000 (1 µs) means 100k operations complete in
## under 100ms — the DoD target.

def bench_mutex_lock_unlock(b: &var Bencher)
  let m: Mutex[Int] = Mutex.new(0)
  b.iter("mutex_lock_unlock", do ||
    let g = m.lock_raw
    let v = g.get
    g.set(v + 1)
    v
  end)
end

def bench_mutex_lock_release_only(b: &var Bencher)
  let m: Mutex[Int] = Mutex.new(0)
  b.iter("mutex_lock_release_only", do ||
    let g = m.lock_raw
    g.get
  end)
end
