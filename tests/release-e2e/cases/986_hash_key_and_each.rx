# Pins Hash key-presence synonyms (has_key?/include?/member? → key?) and
# each_key/each_value/each_pair, added as `.rx` delegating methods on
# `class Hash[K, V]`.
def main
  var h: Hash[String, Int] = Hash.new
  h.insert("a", 1)
  h.insert("b", 2)
  puts(h.has_key?("a"))
  puts(h.include?("z"))
  puts(h.member?("b"))
  var vsum = 0
  h.each_value do |v| vsum = vsum + v end
  puts(vsum)
  var kcount = 0
  h.each_key do |k| kcount = kcount + 1 end
  puts(kcount)
end
