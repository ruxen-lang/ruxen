# Pins more Ruby String method-name parity: `strip`/`lstrip`/`rstrip`
# (aliases of `trim`/`trim_start`/`trim_end`) and `start_with?`/`end_with?`
# (aliases of `starts_with`/`ends_with`), sharing the same C symbols.
def main
  let s = "  hi  "
  puts(s.strip)
  puts(s.lstrip.length)
  puts(s.rstrip.length)
  let t = "hello world"
  puts(t.start_with?("hello"))
  puts(t.end_with?("world"))
  puts(t.start_with?("bye"))
  # Ruxen spellings still work alongside the Ruby ones.
  puts(t.starts_with("hell"))
  puts(s.trim)
end
