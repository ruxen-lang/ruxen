mixin Displayable
  def to_display -> String
end

class Tag
  label: String

  def init(@label: String)
  end

  include Displayable

  def to_display -> String
    self.label.clone
  end
end

def print_it(x: &some Displayable)
  puts "#{x.to_display}"
end

def main
  let t = Tag.new(String.from("hi"))
  print_it(&t)
end
