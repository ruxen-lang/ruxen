use std.fs.{create_dir_all, is_dir, remove_dir_all}

def main
  match create_dir_all("/tmp/ruxen_e2e_532/a/b/c")
    Ok(_)  -> puts "created"
    Err(_) -> puts "create_fail"
  end
  if is_dir("/tmp/ruxen_e2e_532/a")
    puts "a_yes"
  else
    puts "a_no"
  end
  if is_dir("/tmp/ruxen_e2e_532/a/b/c")
    puts "c_yes"
  else
    puts "c_no"
  end
  remove_dir_all("/tmp/ruxen_e2e_532").expect!("cleanup")
end
