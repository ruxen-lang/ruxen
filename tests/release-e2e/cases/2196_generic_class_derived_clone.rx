# `.clone` on a generic class instance links: the derived clone body is
# emitted per monomorphic instance (`Cellish__mono__Int_clone`), and the copy
# shares the SharedSync cell, so a write through either handle is seen by both.
class Cellish[T: Send + Clone]
  id: Int
  cell: SharedSync[Mutex[T]]
  def init(@id: Int, initial: T)
    @cell = SharedSync.new(Mutex.new(initial))
  end
  def peek -> T
    m = @cell.deref
    g = m.lock_raw
    g.get
  end
  def put(v: T) -> nil
    m = @cell.deref
    g = m.lock_raw
    g.set(v)
  end
end

a = Cellish.new(1, 5)
b = a.clone
b.put(9)
puts a.peek
puts b.id
