# Pins `String#count` (Ruby tr-style character sets, including `a-z` ranges
# and `^` negation), `String#codepoints` and `String#bytesize` (batch B08).
def main
  puts "count lo = #{"hello".count("lo")}"
  puts "count a-z = #{"hello world".count("a-z")}"
  puts "count ^l = #{"hello".count("^l")}"
  puts "count empty = #{"hello".count("")}"
  puts "count caret = #{"a^b".count("^")}"
  puts "count 0-9 = #{"a1b22c".count("0-9")}"
  puts "count on empty = #{"".count("a")}"

  let cps = "AB".codepoints
  puts "codepoints = #{cps[0]} #{cps[1]} (#{cps.size})"

  # bytesize counts BYTES; the accented character is two of them.
  puts "bytesize ascii = #{"hello".bytesize}"
  puts "bytesize utf8 = #{"héllo".bytesize}"
end
