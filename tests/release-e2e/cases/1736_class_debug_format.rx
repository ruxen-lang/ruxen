# B74 adjacent derive: `Debug` on a `class`.
#
# The same missing-synthesis hole that broke class equality broke class
# formatting: `mir/lower/mod.rs` never emitted `{Class}_to_debug`, and
# `struct_with_derive_debug` matched `Ty::Struct` only, so `"#{obj}"`
# fell past every interpolation arm and printed the receiver's HEAP
# ADDRESS. That is a silently wrong answer whose value changes run to
# run, which is why pin 139 (a struct) never noticed.
#
# Pinned: a plain class, a class with a String field, and a class with
# an INHERITED field (which must be labelled and ordered ancestor-first,
# matching the storage layout).
class Point
  x: Int
  y: Int

  def init(@x: Int, @y: Int)
  end
end

class Tagged
  label: String
  count: Int

  def init(@label: String, @count: Int)
  end
end

class Base
  id: Int

  def init(@id: Int)
  end
end

class Mid < Base
  tag: Int

  def init(id: Int, tag: Int)
    super(id)
    @tag = tag
  end
end

# A user `impl Display` must still WIN over the derived Debug — the
# interpolation dispatch checks it first (case 070 pins that for a
# class today, and adding class Debug must not displace it).
class Money
  cents: Int

  def init(@cents: Int)
  end

  include Display

  def fmt(f: &var Formatter) -> Result[nil, FmtError]
    let _ = f.write_str("$")
    f.write_str("#{self.cents}")
  end
end

def main
  puts "#{Point.new(1, 2)}"
  puts "#{Tagged.new("hi", 7)}"
  puts "#{Mid.new(7, 42)}"
  puts "#{Money.new(4250)}"
end
