## `Mutex#try_lock`, the `MutexGuard#deref` family and
## `SharedSync#deref`/`#strong_count`/`#weak_count` are real `.rx` methods
## (they used to type-check and then fail to link).

def main
  m = Mutex.new(41)
  guard = m.lock!
  match m.try_lock
    Some(_) -> puts "try_lock while held: acquired"
    nil -> puts "try_lock while held: busy"
  end
  let r: &Int = guard.deref
  puts "deref: #{r}"

  free = Mutex.new(1)
  match free.try_lock
    Some(g) -> puts "try_lock when free: #{g.get}"
    nil -> puts "try_lock when free: busy"
  end

  s = SharedSync.new(5)
  s2 = s.clone
  puts "counts: #{s.strong_count} #{s.weak_count}"
  let v: &Int = s2.deref
  puts "shared deref: #{v}"
end
