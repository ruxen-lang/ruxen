class Picker
  def init
  end

  def mark(value: String, suffix: String = "!") -> String
    "#{value}#{suffix}"
  end

  def pick(value: Int) -> String
    "int"
  end

  def pick(value: String) -> String
    "string"
  end
end

def main
  let picker = Picker.new()
  puts picker.mark("ruxen")
  puts picker.mark("ruxen", "?")
  puts picker.pick(7)
  puts picker.pick("seven")
end
