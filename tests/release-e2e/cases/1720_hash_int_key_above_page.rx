# B73: `Hash[Int, V]` must work for EVERY integer key, not just small ones.
#
# The pre-B73 runtime decided a table's key kind on the first insert by
# calling `ruxen_hash_looks_like_string`, which dereferenced the key value
# as a `char*` and scanned up to 256 bytes for a NUL. It short-circuited
# below 0x1000, so `insert(7, …)` and `insert(4095, …)` worked while
# `insert(5000, …)` and `insert(100000, …)` died with SIGSEGV (exit 139).
# Integer keys are ordinary — ids, ports, status codes, years — so that
# was a crash on plausible input.
#
# The key kind now comes from the static key type, so 5000 is just a
# number. Both sides of the old 4096 boundary are pinned here so a
# regression that merely WIDENS the short-circuit range still fails.
def main
  var h: Hash[Int, Int] = Hash.new
  h.insert(7, 1)
  h.insert(4095, 2)
  h.insert(4096, 3)
  h.insert(5000, 4)
  h.insert(100000, 5)
  h.insert(9007199254740993, 6)
  puts "#{h.size}"
  puts "#{h.key?(7)}"
  puts "#{h.key?(4095)}"
  puts "#{h.key?(5000)}"
  puts "#{h.key?(100000)}"
  puts "#{h.key?(9007199254740993)}"
  puts "#{h.key?(4097)}"
  match h.get(100000)
    Some(v) -> puts "got #{v}"
    nil -> puts "missing"
  end
end
