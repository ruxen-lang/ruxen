use std.net.TcpListener

def close_it(l: TcpListener)
  match l.close()
    Ok(_)  -> puts "close=ok"
    Err(_) -> puts "close=err"
  end
end

def bind_then_close(l: TcpListener)
  puts "bind=ok"
  close_it(l)
end

def main
  let addr = String.from("127.0.0.1:0")
  match TcpListener.bind(&addr)
    Ok(l)  -> bind_then_close(l)
    Err(_) -> puts "bind=err"
  end
end
