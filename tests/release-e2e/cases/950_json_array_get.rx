# Pins JSON.array_get (element access + out-of-range None).
def main
  match JSON.parse(&"{\"xs\":[10,20,30]}")
    Ok(j) ->
      match JSON.object_get(&j, &"xs")
        Some(arr) ->
          let n = match JSON.array_len(&arr)
            Some(k) -> k
            nil -> 0
          end
          puts "len=#{n}"
          match JSON.array_get(&arr, 1)
            Some(el) ->
              match JSON.as_int(&el)
                Some(v) -> puts "xs1=#{v}"
                nil -> puts "notint"
              end
            nil -> puts "noel"
          end
          match JSON.array_get(&arr, 9)
            Some(_x) -> puts "oob=some"
            nil -> puts "oob=none"
          end
        nil -> puts "noxs"
      end
    Err(_) -> puts "parseerr"
  end
end
