# NOTE: `ok_or(...)` binds the Result's error type `E` from its argument, so
# `ok_or("missing")` would yield `Result[Int, &str]`, which does NOT coerce into
# the annotated `Result[Int, String]` — the `&str → String` coercion NESTED
# inside a `Result`/`Option` method-return payload is a known-deferred gap (see
# the TODO in `typeck/infer/mod.rs::unify_or_coerce`; rewriting the inner expr's
# `.ty` to `String` while storage stays `Str` risks a payload drop double-free).
#
# The workaround is to bind an OWNED `String` first (`let miss: String =
# "missing"` — a bare literal in an annotated `String` slot is owned, Q38) and
# pass it. `ok_or` consumes its arg, so each call gets its own owned copy via
# `.clone`. The DIRECT `Err("msg")` constructor form IS already fixed (it coerces
# the literal at construction; pin 24_result/922) — this generic-method-return
# path is the unsolved remainder, tracked by the `&str`-removal task. (Previously
# this case used `String.from("missing")`, which has since been removed from the
# language; the owned-let-binding spelling replaces it.)
def main
  let some_v: Int? = 5
  let none_v: Int? = nil

  let miss: String = "missing"
  let r1: Result[Int, String] = some_v.ok_or(miss.clone)
  let r2: Result[Int, String] = none_v.ok_or(miss.clone)

  match r1
    Ok(v)  -> puts "ok #{v}"
    Err(e) -> puts "err #{e}"
  end
  match r2
    Ok(v)  -> puts "ok #{v}"
    Err(e) -> puts "err #{e}"
  end
end
