# One-string-type ADR (docs/decisions/one-string-type.md): `ok_or(...)` binds
# the Result's error type `E` from its argument. A string literal is now born
# owned `Ty::String`, so `ok_or("missing")` yields `Result[Int, String]`
# DIRECTLY — no nested `&str → String` payload coercion is needed, and the old
# storage-vs-payload drop double-free hazard (a `&str`-typed payload over a heap
# `String` storage) is dissolved with the `&str` type.
#
# This case previously needed a workaround: bind an owned `let miss: String =
# "missing"` and pass `miss.clone` to each call (because the nested coercion was
# deferred). That workaround is no longer necessary — the bare literal works.
def main
  let some_v: Int? = 5
  let none_v: Int? = nil

  let r1: Result[Int, String] = some_v.ok_or("missing")
  let r2: Result[Int, String] = none_v.ok_or("missing")

  match r1
    Ok(v)  -> puts "ok #{v}"
    Err(e) -> puts "err #{e}"
  end
  match r2
    Ok(v)  -> puts "ok #{v}"
    Err(e) -> puts "err #{e}"
  end
end
