# ---- from 1727_hash_runtime_built_table ----
# B73: a table constructed ENTIRELY inside the C runtime states its own
# key kind.
#
# `Env.vars` (and `Match#named_groups`) build their `Hash[String, String]`
# in C, populate it in C, and hand back a finished table. The compiler's
# key-descriptor post-pass never sees a construction site to rewrite, so
# these runtime-internal constructors have to name their own kind — their
# keys are `char*` by definition. Before that fix they came back UNSET and
# the first insert inside the runtime aborted with the protocol's panic.
#
# The lookup below uses a FRESH string literal rather than a key taken out
# of the table, which is the whole point: a table that fell back to raw-bits
# hashing compares keys by pointer identity and would answer `false` here
# even though the entry is present.
#
# `PATH` is set by the e2e harness itself (`run.sh` exports it), so this
# does not depend on the ambient environment beyond that.
def run_1727
  let vars = Env.vars
  puts "empty=#{vars.empty?}"
  puts "path=#{vars.key?("PATH")}"
  puts "absent=#{vars.key?("RUXEN_B73_DEFINITELY_NOT_SET")}"
end

# ---- from 1728_hash_turbofish_construction ----
# B73: both spellings of a table constructor produce a keyed table.
#
# A `Hash` can be constructed two ways, and until this pin only ONE of them
# was covered:
#
#     var a: Hash[String, Int] = Hash.new      # type on the BINDING
#     var b = Hash[String, Int].new            # type on the CONSTRUCTOR
#
# The second erased its type arguments in the parser
# (`parse_type_expr_primary` parsed them into `_generic_args` and dropped
# them, on the reasoning that they are inferred from the call's arguments).
# That reasoning holds for `Point[Int].new(3)` and cannot hold for a
# NO-ARGUMENT constructor: there is nothing to infer from, so the receiver
# kept the declared rigid `K`/`V` and the call's type stayed `Hash[K, V]`
# forever. Pre-B73 the runtime covered for it by guessing the key kind from
# the first key's bits, which was right for strings, right for small
# integers, and a SIGSEGV for an integer key >= 4096.
#
# Both spellings are pinned side by side for every key kind, and for `Set`
# and `with_capacity` too, so a fix that repairs one spelling and not the
# other fails here.
struct Tag
  id: Int
  label: String
end

def run_1728
  # ── String keys ────────────────────────────────────────────────
  var a: Hash[String, Int] = Hash.new
  a.insert("k", 1)
  var b = Hash[String, Int].new
  b["k"] = 1
  puts "str=#{a.key?("k")} #{b.key?("k")} #{b.key?("nope")}"

  # ── Integer keys, both sides of the old 0x1000 probe boundary ──
  var c: Hash[Int, Int] = Hash.new
  c.insert(7, 1)
  c.insert(100000, 2)
  var d = Hash[Int, Int].new
  d.insert(7, 1)
  d.insert(100000, 2)
  puts "int=#{c.key?(100000)} #{d.key?(100000)} #{d.key?(4097)}"

  # A turbofish table whose FIRST key is above the boundary. This exact
  # program segfaulted before B73 (the heuristic dereferenced 5000).
  var e = Hash[Int, Int].new
  e.insert(5000, 1)
  puts "first_big=#{e.size} #{e.key?(5000)}"

  # ── User-type keys, through hash_code + the == derive ──────────
  var f: Hash[Tag, Int] = Hash.new
  f.insert(Tag.new(1, "a"), 1)
  var g = Hash[Tag, Int].new
  g.insert(Tag.new(1, "a"), 1)
  puts "user=#{f.key?(Tag.new(1, "a"))} #{g.key?(Tag.new(1, "a"))} #{g.key?(Tag.new(2, "b"))}"

  # ── Set, both spellings ────────────────────────────────────────
  var h: Set[String] = Set.new
  h.insert("s")
  var i = Set[String].new
  i.insert("s")
  i.insert("s")
  puts "set=#{h.include?("s")} #{i.size} #{i.include?("s")} #{i.include?("t")}"

  # ── with_capacity, both spellings ──────────────────────────────
  var j: Hash[String, Int] = Hash.with_capacity(8)
  j.insert("k", 1)
  var k = Hash[String, Int].with_capacity(8)
  k.insert("k", 1)
  puts "cap=#{j.key?("k")} #{k.key?("k")}"
end

# ---- from 1729_hash_construction_shapes ----
# B73: every place a table can be CONSTRUCTED yields a keyed table.
#
# The key-kind descriptor is installed from a static type, so the shapes
# that matter are the ones where that type is written somewhere other than
# on the constructor itself. Each shape below puts the type in a different
# place; all of them must reach the runtime as a real key kind.
#
#   * a class FIELD, initialised in `init`
#   * a function RETURN, with the type only on the signature
#   * a CLOSURE body
#   * an Array ELEMENT
#
# Both constructor spellings appear (`Hash.new` and `Hash[K, V].new`) so a
# fix that only handles one is caught. `String` keys throughout, because
# raw-bits hashing on a `String` key is the silent-wrong-answer this whole
# protocol exists to prevent: every lookup below uses a FRESH literal, so
# a table that fell back to pointer identity answers `false`.
class Holder
  field: Hash[String, Int]
  tags: Set[String]

  def init
    self.field = Hash.new
    self.tags = Set[String].new
  end

  def put(k: String, v: Int) -> Bool
    self.field.insert(k.clone, v)
    self.tags.insert(k)
    self.field.key?("alpha")
  end

  def tagged -> Bool
    self.tags.include?("alpha")
  end
end

def returns_bare -> Hash[String, Int]
  Hash.new
end

def returns_turbo -> Hash[String, Int]
  Hash[String, Int].new
end

def run_1729
  # class field
  var holder = Holder.new
  puts "field=#{holder.put("alpha", 1)} #{holder.tagged}"

  # function return, both constructor spellings
  var a = returns_bare
  a.insert("alpha", 1)
  var b = returns_turbo
  b.insert("alpha", 1)
  puts "returned=#{a.key?("alpha")} #{b.key?("alpha")} #{b.key?("beta")}"

  # closure body
  let make = { || Hash[String, Int].new }
  var c = make.()
  c.insert("alpha", 1)
  puts "closure=#{c.key?("alpha")}"

  # array element
  var arr: Array[Hash[String, Int]] = []
  arr.push(Hash.new)
  arr[0].insert("alpha", 1)
  puts "element=#{arr[0].key?("alpha")}"
end

def main
  run_1727
  run_1728
  run_1729
end
