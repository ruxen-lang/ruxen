# Pins Ruby's universal `tap` / `then` / `yield_self` block methods.
# `x.tap { |v| ... }` runs the block on `x` for side effects and returns `x`;
# `x.then { |v| ... }` (and `yield_self`) returns the block's result.
class Box
  n: Int
  def init(@n: Int)
  end
end

def main
  # tap returns the receiver; the block runs for side effects.
  let b = Box.new(5).tap do |x|
    puts(x.n)
  end
  puts(b.n)

  # then transforms and returns the block result.
  let doubled = 10.then do |x|
    x * 2
  end
  puts(doubled)

  # then over a String.
  let shout = "hi".then do |s|
    s.upcase
  end
  puts(shout)

  # yield_self is an alias of then.
  let tripled = 4.yield_self do |x|
    x * 3
  end
  puts(tripled)

  # tap on a primitive returns it unchanged.
  let kept = 42.tap do |x|
    puts(x + 1)
  end
  puts(kept)
end
