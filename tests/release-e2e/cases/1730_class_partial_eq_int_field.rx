# B74: structural `==` on a `class` with a single `Int` field.
#
# Before the fix `mir/lower/mod.rs`'s `HirItem::Class` arm synthesized
# `Clone` and nothing else, AND `struct_name_with_partial_eq` matched
# `Ty::Struct` only — so `a == b` on a class skipped the structural
# route in `expr/binops.rs` and lowered to a raw `Compare` of two heap
# ADDRESSES. Every pair of distinct allocations was `false`, however
# equal their fields.
#
# The struct half is pinned alongside on purpose. Every pin cited for
# auto-equality (133 / 206 / 207 / 139) spells a `struct` and none
# spells a `class`, which is exactly how this survived; keeping both
# spellings in one case means neither half can regress unnoticed.
struct SP
  x: Int
end

class C
  x: Int

  def init(@x: Int)
  end
end

def main
  puts "s_eq=#{SP.new(1) == SP.new(1)}"
  puts "s_ne=#{SP.new(1) == SP.new(2)}"

  let a = C.new(1)
  let b = C.new(1)
  let c = C.new(2)
  puts "c_eq=#{a == b}"
  puts "c_ne=#{a == c}"
  # `!=` must invert the SAME structural answer, not fall back to
  # address inequality (which was `true` for every pair).
  puts "c_bang_eq=#{a != b}"
  puts "c_bang_ne=#{a != c}"
  # An alias of one allocation stays equal — the fix must not overshoot
  # into "always compare unequal".
  puts "c_self=#{a == a}"
  # Equality is symmetric in BOTH directions — a fold that reads the
  # lhs's slots against the rhs's would still pass a one-sided check.
  puts "c_sym_eq=#{b == a}"
  puts "c_sym_ne=#{c == a}"
end
