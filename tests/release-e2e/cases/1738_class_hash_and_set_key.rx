# B74 downstream unlock: a `class` can BE a `Hash` / `Set` key.
#
# B73 landed the key-kind protocol and pinned it with a `struct`
# (1722). A class could not use it for two compounding reasons: it had
# no `{Class}_hash_code` / `{Class}_eq` to hand the runtime, and
# `key_desc.rs` matched `Ty::Struct` only — so a class key fell through
# to identity and two equal-by-value keys were two separate entries.
#
# This is the same battery 1722 runs, respelled with a class, plus an
# inherited-field key. Pinned: dedup on re-insert, a hit through a
# DISTINCT instance, and two kinds of miss (one field differs; nothing
# alike) so a "hash everything into one bucket and answer true"
# regression fails.
class K
  ns: Int
  name: String

  def init(@ns: Int, @name: String)
  end
end

class Base
  id: Int

  def init(@id: Int)
  end
end

class Mid < Base
  tag: Int

  def init(id: Int, tag: Int)
    super(id)
    @tag = tag
  end
end

def main
  var h: Hash[K, Int] = Hash.new
  h.insert(K.new(1, "a"), 10)
  h.insert(K.new(2, "b"), 20)
  h.insert(K.new(1, "a"), 11)
  puts "size=#{h.size}"
  puts "hit=#{h.key?(K.new(1, "a"))}"
  puts "hit2=#{h.key?(K.new(2, "b"))}"
  puts "miss_second_field=#{h.key?(K.new(1, "z"))}"
  puts "miss_nothing_alike=#{h.key?(K.new(9, "q"))}"
  match h.get(K.new(1, "a"))
    Some(v) -> puts "got #{v}"
    nil -> puts "missing"
  end

  # A `Set` keys on its ELEMENT, so the same descriptor drives dedup.
  var s: Set[K] = Set.new
  s.insert(K.new(3, "c"))
  s.insert(K.new(3, "c"))
  s.insert(K.new(4, "d"))
  puts "set_size=#{s.size}"
  puts "set_hit=#{s.include?(K.new(3, "c"))}"
  puts "set_miss=#{s.include?(K.new(5, "e"))}"

  # An inherited field is part of the key, not ignored.
  var hm: Hash[Mid, Int] = Hash.new
  hm.insert(Mid.new(1, 2), 100)
  hm.insert(Mid.new(9, 2), 200)
  puts "inherited_size=#{hm.size}"
  puts "inherited_hit=#{hm.key?(Mid.new(9, 2))}"
  puts "inherited_miss=#{hm.key?(Mid.new(5, 2))}"
end
