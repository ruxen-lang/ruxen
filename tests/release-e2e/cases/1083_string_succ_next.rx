# Pins `String#succ` / `#next` (batch B09). The rightmost ALPHANUMERIC is
# incremented, carrying leftwards across alphanumerics and SKIPPING
# non-alphanumerics; a carry out of the leftmost alphanumeric inserts a seed
# character ("1", "a" or "A") in front of it. A string with no alphanumeric
# increments its last character's codepoint instead.
def main
  puts "abcd -> #{"abcd".succ}"
  puts "THX1138 -> #{"THX1138".succ}"
  puts "<<koala>> -> #{"<<koala>>".succ}"
  puts "1999zzz -> #{"1999zzz".succ}"
  puts "zz -> #{"zz".succ}"
  puts "99 -> #{"99".succ}"
  puts "a9 -> #{"a9".succ}"
  puts "Az -> #{"Az".succ}"
  puts "Zz -> #{"Zz".succ}"
  puts "1.9 -> #{"1.9".succ}"
  puts "** -> #{"**".succ}"
  puts "- -> #{"-".succ}"
  puts "empty -> [#{"".succ}]"
  puts "next aa -> #{"aa".next}"
end
