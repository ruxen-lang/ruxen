## B3: derive PartialEq on a struct holding a String field. The
## synthesised `<Type>_eq` walks each field and dispatches to
## `riven_string_eq` for String fields, so two distinct heap copies
## with the same characters compare equal.
struct Person
  name: String
  age: Int
  derive PartialEq
end

def main
  let a = Person.new("Ada", 36)
  let b = Person.new("Ada", 36)
  let c = Person.new("Ada", 37)
  let d = Person.new("Bob", 36)
  let r1 = a == b
  let r2 = a == c
  let r3 = a == d
  puts "ab=#{r1}"
  puts "ac=#{r2}"
  puts "ad=#{r3}"
end
