## Auto-synthesised Hash mixin produces `<Type>_hash_code(self) -> Int`
## so that structurally equal values produce identical hash codes (the
## `equal-keys-equal-hashes` invariant Hash demands). The synthesiser
## walks each field and folds the FNV-1a polynomial over their hashes.
struct Key
  ns: Int
  id: Int
end

def main
  let a = Key.new(7, 42)
  let b = Key.new(7, 42)
  let c = Key.new(7, 43)
  let ha = a.hash_code()
  let hb = b.hash_code()
  let hc = c.hash_code()
  let same = ha == hb
  let differ = ha != hc
  puts "same=#{same}"
  puts "differ=#{differ}"
end
