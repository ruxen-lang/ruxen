## Pin: a class with a `Map[K, V]` field can be cloned via the
## auto-synthesised `<Class>_clone`. Regression check for the
## `riven_hash_clone` runtime helper (added 2026-05-22) that
## `synthesize_clone_field` (mir/lower/derive.rs) emits at codegen
## time. Without the helper the link step fails with
## `Undefined symbols: _riven_hash_clone, referenced from _Box_clone`.

class Box
  data: Map[String, Int]

  def init
    self.data = Map.new
  end
end

def main
  var b1 = Box.new
  b1.data.insert(String.from("alpha"), 10)
  b1.data.insert(String.from("beta"), 20)

  let b2 = b1.clone

  # The runtime contract for `riven_hash_clone` is a shallow copy:
  # the bucket array is fresh, but heap-owned key/value slots alias
  # the source. The point of the pin is that the helper exists and
  # produces a working Map (right len, lookups succeed) — not deep-
  # clone semantics, which Vec / Hash share as a v1 ceiling.
  puts "clone_len=#{b2.data.len}"
  match b2.data.get(String.from("alpha"))
    Some(v) -> puts "alpha=#{v}"
    nil     -> puts "alpha=MISSING"
  end
  match b2.data.get(String.from("beta"))
    Some(v) -> puts "beta=#{v}"
    nil     -> puts "beta=MISSING"
  end
end
