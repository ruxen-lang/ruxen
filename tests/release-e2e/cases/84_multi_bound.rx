mixin Showable
  def to_display -> String
end

mixin Tagged
  def tag -> String
end

class Item
  name: String

  def init(@name: String)
  end

  include Showable

  def to_display -> String
    self.name.clone
  end

  include Tagged

  def tag -> String
    "T:#{self.name}"
  end
end

def show[T: Showable + Tagged](x: &T)
  puts "#{x.to_display}"
  puts "#{x.tag}"
end

def main
  let i = Item.new(String.from("one"))
  show(&i)
end
