## Q1 (gui-stack-v1-issues) — two same-named methods, one taking `&str` and one
## taking `any Fn[...]`. A closure argument must select the closure overload,
## not the `&str` one. Before the fix the closure (often still `Infer` at
## overload-selection time) matched the first-declared `&str` overload and was
## mis-stored as a String → heap corruption / wrong counts.

class Col
  labels: Array[String]
  computes: Array[any Fn[Fn() -> String]]
  def init
    self.labels = Array.new
    self.computes = Array.new
  end
  def var text(label: &str) -> nil
    self.labels.push(String.from(label))
  end
  def var text(f: any Fn[Fn() -> String]) -> nil
    self.computes.push(f)
  end
end

def main
  var c = Col.new
  c.text("Counter")
  c.text({ || String.from("computed") })
  c.text("Second")
  puts "labels=#{c.labels.size} computes=#{c.computes.size}"
  if let Some(s) = c.labels.get(0)
    puts "l0=#{s}"
  end
  if let Some(s) = c.labels.get(1)
    puts "l1=#{s}"
  end
  if let Some(f) = c.computes.get(0)
    puts "c0=#{f.()}"
  end
end
