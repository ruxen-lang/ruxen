# Q28 regression pin — an enum VARIANT carrying `Float32` payloads must
# round-trip through construction and `match` with no precision loss.
#
# This is the exact shape `canvas/src/event.rx` was forced AWAY from (its
# `PointerMove(Int, Int)` carries a TODO: "return to Float32 payloads once
# enum float payloads work"). Sub-pixel values (120.5, 84.25, 0.125) would be
# truncated if the payload were Int, and would read as garbage if the f32 were
# stored as 8 bytes but loaded as 4 (or vice-versa). Both backends share the
# MIR `SetField`/`GetField` typed slot path, so this is a backend-agnostic pin.
enum Event
  PointerMove(Float32, Float32)
  PointerDown(Float32, Float32)
  Single(Float32)
  CloseRequested
end

def handle(e: Event) -> nil
  match e
    Event.PointerMove(x, y) ->
      let sx = x + 0.5f32
      puts "move #{x},#{y} sx=#{sx}"
    Event.PointerDown(x, y) -> puts "down #{x},#{y}"
    Event.Single(v)         -> puts "single #{v}"
    Event.CloseRequested    -> puts "close"
  end
end

def main
  handle(Event.PointerMove(120.5f32, 84.25f32))
  handle(Event.PointerDown(0.125f32, 0.0f32))
  handle(Event.Single(2.5f32))
  handle(Event.CloseRequested)
end
