## Feature #4 Increment 2 (spec §4.4) — `Overflow.DropNewest` (DROPPING): a
## `send` into a FULL bounded queue REJECTS the incoming element and keeps the
## buffer unchanged. The producer NEVER parks and the send still RESOLVES Ok
## (the policy is non-blocking — the value is silently dropped, not an error).
## The buffer keeps the OLDEST `capacity` elements.
##
## Capacity 2; drive everything from the `block_on` ROOT:
##   send 1 → [1]              send 2 → [1,2] (full)
##   send 3 → rejected → [1,2]  send 4 → rejected → [1,2]
##   recv → 1,  recv → 2
## So the two recvs sum to 3 (the two OLDEST), proving DropNewest kept the
## existing buffer and dropped the incoming 3 and 4. (Contrast pin 425
## DropOldest → 3+4 = 7.) Overflow tag DropNewest=2.

async def run(tx: AsyncSender, rx: AsyncReceiver) -> Int
  let _1 = tx.send(1).await
  let _2 = tx.send(2).await
  let _3 = tx.send(3).await
  let _4 = tx.send(4).await
  let a = rx.recv().await
  let b = rx.recv().await
  unwrap_or_neg(a) + unwrap_or_neg(b)
end

def unwrap_or_neg(r: Result[Int, QueueError]) -> Int
  match r
    Ok(v)  -> v
    Err(_) -> -1
  end
end

def main
  puts "queue start"
  var ends = Queue.bounded(2, Overflow.DropNewest)
  let tx = ends.sender
  let rx = ends.receiver
  let sum = block_on(run(tx, rx))
  puts "sum=#{sum}"
  puts "queue done"
end
