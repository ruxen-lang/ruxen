use std.fs.{read_to_string, remove_file}
use std.io.File

def write_msg(f: File)
  match f.write_str("hello")
    Ok(_)  -> puts "wrote_ok"
    Err(_) -> puts "wrote_fail"
  end
end

def main
  match File.create("/tmp/riven_e2e_511_create.txt")
    Ok(f)  -> write_msg(f)
    Err(_) -> puts "create_fail"
  end
  match read_to_string("/tmp/riven_e2e_511_create.txt")
    Ok(s)  -> puts "back=#{s}"
    Err(_) -> puts "read_fail"
  end
  remove_file("/tmp/riven_e2e_511_create.txt").expect!("remove")
end
