def main
  let n = [1, 2, 3].chain([4, 5]).count
  puts "n=#{n}"
  let total = [1, 2, 3].chain([4, 5]).sum
  puts "total=#{total}"
  let empty: Array[Int] = Array.new
  let m = empty.chain([1, 2, 3]).count
  puts "empty_lhs=#{m}"
  let e2: Array[Int] = Array.new
  let k = [1, 2, 3].chain(e2).count
  puts "empty_rhs=#{k}"
end
