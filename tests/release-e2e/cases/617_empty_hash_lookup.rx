# Q25(a): `key?`/`get` on an EMPTY hash must return cleanly, not SIGSEGV.
# The runtime's `string_keys` tristate (-1 unset) was C-truthy, so an
# empty-hash lookup took the string path and dereferenced an int key as a
# char* (e.g. (char*)9). The tristate is gone with B73 — a table's key
# kind now comes from its static key type — but the invariant this pins
# is unchanged: a lookup never dereferences a key the kind says is a
# plain word. Expected: false / none / true / some 99.
def main
  var h: Hash[Int, Int] = Hash.new
  puts "#{h.key?(9)}"
  match h.get(9)
    Some(v) -> puts "some #{v}"
    nil -> puts "none"
  end
  h.insert(9, 99)
  puts "#{h.key?(9)}"
  match h.get(9)
    Some(v) -> puts "some #{v}"
    nil -> puts "none"
  end
end
