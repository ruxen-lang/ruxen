# F-4: Array include?/sort/dedup/== compare String elements by CONTENT.
# Elements are built at run time (interpolation), so two equal strings
# live in distinct allocations: a raw-word compare of the slot pointers
# would answer `false` and leave them unsorted.
def main
  let p = "p"
  let f = "f"
  var a: Array[String] = Array.new
  a.push("#{p}ear")
  a.push("a#{p}ple")
  a.push("a#{p}ple")
  a.push("#{f}ig")
  a.push("#{f}ig")
  a.push("a#{p}ple")

  puts "include_apple=#{a.include?("a#{p}ple")}"
  puts "include_kiwi=#{a.include?("kiwi")}"

  var b: Array[String] = Array.new
  b.push("#{p}ear")
  b.push("a#{p}ple")
  b.push("a#{p}ple")
  b.push("#{f}ig")
  b.push("#{f}ig")
  b.push("a#{p}ple")
  puts "eq=#{a == b}"
  puts "ne=#{a != b}"

  a.dedup
  puts "dedup=#{a.join(",")}"
  puts "eq_after_dedup=#{a == b}"

  let sorted = a.sort
  puts "sort=#{sorted.join(",")}"
  puts "receiver=#{a.join(",")}"
  a.sort!
  puts "sort_bang=#{a.join(",")}"
end
