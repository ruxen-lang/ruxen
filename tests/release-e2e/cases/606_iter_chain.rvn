def main
  let a = array![1, 2, 3]
  let b = array![4, 5]
  let n = a.iter.chain(b.iter).count
  puts "n=#{n}"
  let total = a.iter.chain(b.iter).sum
  puts "total=#{total}"
  let empty: Array[Int] = Array.new
  let m = empty.iter.chain(a.iter).count
  puts "empty_lhs=#{m}"
  let k = a.iter.chain(empty.iter).count
  puts "empty_rhs=#{k}"
end
