# ---- from 1880_bang_free_fn_call ----
# B87 — the exact repro. A free function whose name ends in `!` used to be
# parsed as a MACRO call (`parser/expr/atoms.rs` stripped the `!` and emitted
# `ExprKind::MacroCall`), nothing downstream recognised the name, and MIR's
# macro lowering ended in a `_ => Ok(None)` catch-all that emitted no code at
# all. So `shout!(5)` compiled without a single diagnostic and the call
# vanished: the program printed `before` then `after`.
#
# The pin is the middle line. If the call is ever dropped again the output
# loses `shouting 5` while still "passing" compilation, which is exactly how
# this defect survived.
def shout!(x: Int)
  puts "shouting #{x}"
end

def run_1880
  puts "before"
  shout!(5)
  puts "after"
end

# ---- from 1881_bang_free_fn_return_value ----
# B87 — a `!` function used for its VALUE, which failed worse than the
# statement form: the dropped call left the destination local at its zero
# initialiser, so `let r = twice!(3)` bound `0` with no diagnostic. A pin that
# only checked "the program still runs" would have passed.
#
# Three value positions, because they lower differently: a `let` binding, an
# arithmetic operand inside interpolation, and a `!` call nested as the
# argument of another `!` call.
def twice!(x: Int) -> Int
  x * 2
end

def run_1881
  let r = twice!(3)
  puts "r=#{r}"
  puts "sum=#{twice!(3) + 1}"
  puts "nest=#{twice!(twice!(2))}"
end

# ---- from 1882_bang_free_fn_parenless ----
# B87 — the paren-less spellings. `ping!` (no parens, no arguments) and
# `announce! "now"` (Ruby command-call style with a bare string argument) took
# the same macro-interception path as the parenthesised form and vanished the
# same way, so both are pinned next to the parenthesised call rather than
# assumed to follow from it (QUEUE §0, "pin EVERY spelling").
#
# Not pinned, because it is a pre-existing limitation of paren-less calls in
# general and not a `!` defect: a bare NON-string argument (`shout! 7`) is
# rejected with E0726, exactly as `shout 7` is for a name without the `!`.
def ping!
  puts "ping"
end

def announce!(msg: &String)
  puts "announce #{msg}"
end

def run_1882
  ping!
  announce! "now"
  ping!
end

# ---- from 1883_predicate_free_fn ----
# B87 sibling — the `?` convention. The lexer glues a trailing `?` onto the
# identifier the same way it glues `!`, but only `!` was routed into macro
# parsing, so `?` free functions always worked. Pinned anyway: the two suffixes
# share the lexer rule, and anything that touches it must keep both alive.
#
# Four positions: parens in a value context, explicit empty parens, a bare
# nullary reference in a `let` (which type-directed auto-call turns into a
# call), and an `if` condition.
#
# NOT pinned, and NOT a `?` defect: a bare nullary reference interpolated
# directly (`"#{ready?}"`) is E0729 — the interpolation supplies no expected
# type, so auto-call does not fire and the fn VALUE reaches the formatter.
# That is the general auto-call rule (`tests/autocall_fn_references.rs`) and it
# behaves identically for a name without the `?`. Bind it first, or write the
# parens, which is what this case does.
#
# Independently confirmed on unmodified head, BEFORE the B87 parser change: a
# paren-less `?` reference in a `let` really does auto-call and run its side
# effect (`def ready?() -> Bool; puts "SIDE EFFECT ran"; true; end` then
# `let r = ready?` prints and binds `true`). So the `let bound = ready?` line
# below pins a real call, and the interpolation limitation above is inherited,
# not a regression this batch introduced.
def valid?(x: Int) -> Bool
  x > 0
end

def ready? -> Bool
  true
end

def run_1883
  puts "v=#{valid?(9)}"
  puts "z=#{valid?(0)}"
  puts "r=#{ready?()}"
  let bound = ready?
  puts "bound=#{bound}"
  if valid?(4)
    puts "cond=taken"
  else
    puts "cond=missed"
  end
end

# ---- from 1884_bang_method_call ----
# B87 — `!` and `?` in METHOD position. These take a different parser path
# from a free function (`parse_postfix` reads the name after `.` verbatim, so
# they never reached the macro interception) and were already correct. They are
# pinned so the B87 fix, which changed how a `!` identifier is classified at
# expression head, cannot regress the receiver form.
#
# Covered: `!` method with no arguments, `!` method with arguments, `!` method
# used for its value, `?` predicate method, and a `!` STATIC method
# (`Doc.make!`), which parses as a `.`-name on a type receiver.
class Doc
  n: Int

  def init(@n: Int)
  end

  def self.make!(n: Int) -> Doc
    Doc.new(n)
  end

  def save! -> Bool
    puts "saved #{@n}"
    true
  end

  def bump!(k: Int) -> Int
    puts "bumped #{@n + k}"
    @n + k
  end

  def positive? -> Bool
    @n > 0
  end
end

def run_1884
  let d = Doc.make!(7)
  let s = d.save!
  puts "s=#{s}"
  let b = d.bump!(2)
  puts "b=#{b}"
  puts "pos=#{d.positive?}"
end

# ---- from 1885_bang_negation_still_parses ----
# B87 — the disambiguation target. `!` as a Ruby name suffix and `!` as
# boolean negation are the same character, and the B87 fix changes which of the
# two an identifier-adjacent `!` becomes. This pins the negation side so the
# fix cannot buy bang-names at the cost of `not`.
#
# Covered: negating a variable, a `?` call, a `!` call's comparison, a
# parenthesised comparison, and `!=` (which shares the leading `!` byte and is
# lexed as its own token).
def valid_1885?(x: Int) -> Bool
  x > 0
end

def twice_1885!(x: Int) -> Int
  x * 2
end

def run_1885
  let t = true
  puts "a=#{!t}"
  puts "b=#{!valid_1885?(0)}"
  puts "c=#{!(twice_1885!(2) == 5)}"
  puts "d=#{!(1 == 2)}"
  puts "e=#{5 != 4}"
  if !valid_1885?(0)
    puts "f=taken"
  else
    puts "f=missed"
  end
end

def main
  run_1880
  run_1881
  run_1882
  run_1883
  run_1884
  run_1885
end
