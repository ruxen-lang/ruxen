# F-2: `s[i]` on a String is `String#[]` (string.rx), the character at
# index `i`. It used to fall through the MIR index catch-all and yield an
# unset value.
def first_and_last(s: &String) -> String
  let n: Int = s.size as Int
  "#{s[0]}#{s[n - 1]}"
end

def main
  let word = "ruxen"
  puts word[0]
  puts word[4]
  let i = 2
  puts word[i]
  puts first_and_last(&"hello")
end
