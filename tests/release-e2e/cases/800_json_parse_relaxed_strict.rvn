use std.json.JSON
use std.json.Json
use std.json.JsonKind

def json_source -> String
  """
    {
      // comment
      "name": "riven",
      "answer": 42,
      "items": [1, 2,],
      /* block */
    }
  """
end

def kind_is_object(v: &Json) -> Bool
  match JSON.kind(v)
    JsonKind.Object -> true
    _ -> false
  end
end

def show_int(v: Json, label: &String)
  match JSON.as_int(&v)
    Some(n) -> puts "#{label}=#{n}"
    None -> puts "#{label}=missing"
  end
end

def show_string(v: Json, label: &String)
  match JSON.as_string(&v)
    Some(s) -> puts "#{label}=#{s}"
    None -> puts "#{label}=missing"
  end
end

def main
  let source = json_source()

  match JSON.parse(&source)
    Ok(root) ->
      puts "root-object=#{JSON.is_object(&root)}"
      puts "root-kind-object=#{kind_is_object(&root)}"
      puts "has-name=#{JSON.object_has(&root, "name")}"
      puts "has-missing=#{JSON.object_has(&root, "missing")}"
      match JSON.object_len(&root)
        Some(n) -> puts "object-len=#{n}"
        None -> puts "object-len=missing"
      end
      match JSON.object_get(&root, "answer")
        Some(answer) -> show_int(answer, "answer")
        None -> puts "answer=missing"
      end
      match JSON.object_get(&root, "name")
        Some(name) -> show_string(name, "name")
        None -> puts "name=missing"
      end
      match JSON.object_get(&root, "items")
        Some(items) ->
          puts "items-array=#{JSON.is_array(&items)}"
          match JSON.array_len(&items)
            Some(n) -> puts "items-len=#{n}"
            None -> puts "items-len=missing"
          end
        None -> puts "items=missing"
      end
      puts "root-null=#{JSON.is_null(&root)}"
      puts "root-bool=#{JSON.is_bool(&root)}"
      puts "root-int=#{JSON.is_int(&root)}"
      puts "root-float=#{JSON.is_float(&root)}"
      puts "root-string=#{JSON.is_string(&root)}"
    Err(_) -> puts "parse=err"
  end

  match JSON.parse_strict(&source)
    Ok(_) -> puts "strict=unexpected-ok"
    Err(_) -> puts "strict=err"
  end
end
