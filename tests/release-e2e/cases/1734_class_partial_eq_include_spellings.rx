# B74: both SPELLINGS of asking for structural equality on a `class`
# must agree — an explicit `include PartialEq`, and the implicit
# structural include (ruby-naming.spec.md §3.6) you get by writing no
# include at all.
#
# The bug reproduced under BOTH, so pinning only one would leave half
# the surface unproven. They are side by side here so a fix that wires
# up only the explicit path (the obvious one to notice) fails loudly.
class Explicit
  include PartialEq

  x: Int
  y: String

  def init(@x: Int, @y: String)
  end
end

class Implicit
  x: Int
  y: String

  def init(@x: Int, @y: String)
  end
end

def main
  let e1 = Explicit.new(1, "a")
  let e2 = Explicit.new(1, "a")
  let e3 = Explicit.new(1, "b")
  puts "explicit_eq=#{e1 == e2}"
  puts "explicit_ne=#{e1 == e3}"
  puts "explicit_bang=#{e1 != e3}"

  let i1 = Implicit.new(1, "a")
  let i2 = Implicit.new(1, "a")
  let i3 = Implicit.new(1, "b")
  puts "implicit_eq=#{i1 == i2}"
  puts "implicit_ne=#{i1 == i3}"
  puts "implicit_bang=#{i1 != i3}"
end
