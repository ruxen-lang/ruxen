# Pins std/base64 encode/decode (Ruby Base64 parity, known vectors).
def main
  puts Base64.strict_encode64(&"Man")
  puts Base64.strict_encode64(&"hello")
  puts Base64.strict_decode64(&"aGVsbG8=")
  puts Base64.urlsafe_encode64(&"hello")
  puts Base64.strict_decode64(&Base64.strict_encode64(&"round trip!"))
end
