def main
  let a = vec![1, 2, 3, 4]
  let b = vec![10, 20, 30]
  let n = a.iter.zip(b.iter).count
  puts "n=#{n}"
  let m = b.iter.zip(a.iter).count
  puts "m=#{m}"
  let empty: Vec[Int] = Vec.new
  let z = a.iter.zip(empty.iter).count
  puts "empty_rhs=#{z}"
  let z2 = empty.iter.zip(a.iter).count
  puts "empty_lhs=#{z2}"
end
