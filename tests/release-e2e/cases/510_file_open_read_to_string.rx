use std.fs.{write, remove_file}
use std.io.File

def show(f: File)
  match f.read_to_string()
    Ok(s)  -> puts "contents=#{s}"
    Err(_) -> puts "read_fail"
  end
end

def main
  write("/tmp/ruxen_e2e_510_open.txt", "hello file 510").expect!("write")
  match File.open("/tmp/ruxen_e2e_510_open.txt")
    Ok(f)  -> show(f)
    Err(_) -> puts "open_fail"
  end
  remove_file("/tmp/ruxen_e2e_510_open.txt").expect!("remove")
end
