def main
  var a: Set[Int] = Set.new
  a.insert(1)
  a.insert(2)
  a.insert(3)
  var b: Set[Int] = Set.new
  b.insert(2)
  b.insert(3)
  b.insert(4)
  let i = a.intersection(&b)
  let n = i.size
  puts "len=#{n}"
  puts "has1=#{i.include?(1)}"
  puts "has2=#{i.include?(2)}"
  puts "has3=#{i.include?(3)}"
end
