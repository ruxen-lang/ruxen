## Feature #5 Increment 2 (spec §4.5) — `FilterStream` adapter: keep only
## elements where the predicate holds. A rejected element does NOT end the
## stream — `poll_next` keeps polling the inner (draining rejects in one call)
## until it yields a kept element or the inner ends. Pending passes through so a
## reactor-backed inner still parks correctly.
##
## Source 1..6; keep even → 2,4,6; sum = 12.

class Counter
  n: Int
  limit: Int
  include Stream
  type Item = Int
  def init(limit: Int)
    self.n = 0
    self.limit = limit
  end
  def var poll_next(cx: &var Context) -> Poll[Option[Int]]
    if self.n >= self.limit
      return Poll.Ready(nil)
    end
    self.n = self.n + 1
    Poll.Ready(Some(self.n))
  end
end

def main
  puts "stream start"
  var src = Counter.new(6)
  var f = FilterStream.new(src, { |x| x % 2 == 0 })
  f.for_each do |v|
    puts "got #{v}"
  end
  var src2 = Counter.new(6)
  var f2 = FilterStream.new(src2, { |x| x % 2 == 0 })
  puts "sum=#{f2.sum}"
  puts "stream done"
end
