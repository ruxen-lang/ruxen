# Ruby-parity batch B18 — the `Char` surface. Ruby has no `Char` class (a
# one-character string is a `String`), so each method mirrors the `String`
# method a Ruby developer calls on `str[0]`; the mirror script compares
# against CRuby 3.3 with `"a"`-style receivers.
#
# Two deliberate divergences, both recorded in `docs/ruby-parity/core.md`:
#   * `<=>` only works in METHOD spelling (`a.<=>(b)`). The operator spelling
#     keeps its dedicated comparison route, which rejects `Char` operands
#     with E0707.
#   * `succ` is the next CODEPOINT (`?z.succ == ?{`). CRuby's `String#succ`
#     carries (`"z".succ == "aa"`), which one `Char` cannot represent.
#
# Receivers are let-bound: a char literal used directly as a receiver
# (`?7.digit?`) mis-parses and silently produces nothing.
def main
  let lower = ?a
  let upper = ?Z
  let seven = ?7
  let space = 32.chr
  let bang = 33.chr
  let tilde = 126.chr
  let tab = 9.chr
  puts("ord #{lower.ord} #{upper.ord} #{seven.ord} #{space.ord}")
  puts("to_i #{seven.to_i} #{lower.to_i} #{48.chr.to_i} #{57.chr.to_i}")
  puts("chr #{lower.chr} #{upper.chr}")
  puts("upcase #{lower.upcase} #{upper.upcase} #{seven.upcase} #{bang.upcase}")
  puts("downcase #{lower.downcase} #{upper.downcase} #{seven.downcase}")
  puts("digit? #{seven.digit?} #{lower.digit?} #{space.digit?}")
  puts("alpha? #{lower.alpha?} #{upper.alpha?} #{seven.alpha?} #{bang.alpha?}")
  puts("alnum? #{lower.alnum?} #{seven.alnum?} #{bang.alnum?} #{space.alnum?}")
  puts("space? #{space.space?} #{tab.space?} #{lower.space?} #{bang.space?}")
  puts("whitespace? #{space.whitespace?} #{lower.whitespace?}")
  puts("punct? #{bang.punct?} #{tilde.punct?} #{lower.punct?} #{seven.punct?} #{space.punct?}")
  puts("cmp #{lower.<=>(upper)} #{upper.<=>(lower)} #{lower.<=>(lower)}")
  puts("succ #{lower.succ} #{seven.succ} #{upper.next}")
end
