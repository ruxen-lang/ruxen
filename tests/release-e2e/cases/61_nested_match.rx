def describe(a: Int, b: Int) -> String
  match a
    0 -> match b
      0 -> "both zero"
      _ -> "a zero"
    end
    _ -> match b
      0 -> "b zero"
      _ -> "neither zero"
    end
  end
end

def main
  puts "#{describe(0, 0)}"
  puts "#{describe(0, 5)}"
  puts "#{describe(5, 0)}"
  puts "#{describe(5, 5)}"
end
