def main
  let mut a: HashMap[Int, Int] = HashMap.new
  a.insert(1, 10)
  a.insert(2, 20)
  let mut b: HashMap[Int, Int] = HashMap.new
  b.insert(2, 20)
  b.insert(1, 10)
  let mut c: HashMap[Int, Int] = HashMap.new
  c.insert(1, 99)
  c.insert(2, 20)
  puts "a_eq_b=#{a == b}"
  puts "a_eq_c=#{a == c}"
  puts "a_neq_c=#{a != c}"
end
