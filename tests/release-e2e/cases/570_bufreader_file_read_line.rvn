use std.fs.{write, remove_file}
use std.io.File
use std.bufio.BufReader

def show_line(line: String) -> Bool
  puts "line=#{line}"
  false
end

def handle(opt: String?) -> Bool
  match opt
    Some(line) -> show_line(line)
    None       -> true
  end
end

def drain(br: BufReader.File)
  var done = false
  while !done
    match br.read_line()
      Ok(opt) -> done = handle(opt)
      Err(_)  -> done = true
    end
  end
end

def main
  write("/tmp/riven_e2e_570_bufread.txt", "alpha\nbeta\ngamma").expect!("write")
  match File.open("/tmp/riven_e2e_570_bufread.txt")
    Ok(f)  -> drain(BufReader.File.new(f))
    Err(_) -> puts "open_fail"
  end
  remove_file("/tmp/riven_e2e_570_bufread.txt").expect!("remove")
end
