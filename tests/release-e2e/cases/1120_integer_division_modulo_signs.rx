# Ruby-parity batch B13 — `Integer#div` / `#modulo` / `#remainder` /
# `#divmod` / `#fdiv`, across all four sign combinations.
#
# This pin exists because Ruby and C disagree exactly here:
#   * Ruby FLOORS  — `-7.div(2) == -4`, `-7.modulo(2) == 1` (sign of divisor).
#   * C TRUNCATES  — the machine `/` and `%`, which Ruxen's operators keep:
#     `-7 / 2 == -3`, `-7 % 2 == -1` (sign of dividend).
# `modulo` therefore is NOT the `%` operator, and `remainder` IS. Both
# spellings ship so a Ruby developer gets Ruby's answer from Ruby's name;
# the raw operators keep the machine semantics they always had.
# Diffed against CRuby 3.3. One rendering difference, PRE-EXISTING and not
# from this batch: a whole `Float` prints as `2`, where CRuby prints `2.0`
# (`ruxen_float_to_string`). The `fdiv` VALUES agree.
def main
  let a = -7
  let b = -2
  puts("operators #{7 / 2} #{a / 2} #{7 / b} #{a / b}")
  puts("operator-mod #{7 % 2} #{a % 2} #{7 % b} #{a % b}")
  puts("div #{13.div(4)} #{a.div(2)} #{13.div(b)} #{a.div(b)}")
  puts("modulo #{13.modulo(4)} #{a.modulo(2)} #{13.modulo(b)} #{a.modulo(b)}")
  puts("remainder #{13.remainder(4)} #{a.remainder(2)} #{13.remainder(b)} #{a.remainder(b)}")
  let q1 = 13.divmod(4)
  let q2 = a.divmod(2)
  let q3 = 13.divmod(b)
  let q4 = a.divmod(b)
  puts("divmod #{q1[0]},#{q1[1]} #{q2[0]},#{q2[1]} #{q3[0]},#{q3[1]} #{q4[0]},#{q4[1]}")
  puts("divmod-exact #{q2[0] * 2 + q2[1]} #{q4[0] * -2 + q4[1]}")
  puts("fdiv #{7.fdiv(2)} #{a.fdiv(2)} #{8.fdiv(4)}")
  puts("div-zero-remainder #{8.div(4)} #{8.modulo(4)} #{0.div(4)} #{0.modulo(4)}")
end
