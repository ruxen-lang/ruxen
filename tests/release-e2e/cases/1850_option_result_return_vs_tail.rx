# ---- from 1850_option_return_vs_tail ----
# B84 — `return <value>` from an Option-returning function must produce the
# SAME boxed `Option` the tail-expression spelling produces.
#
# Before the fix the `return` spelling type-checked (the `Return` arm called
# `unify` and DISCARDED the result), skipped the implicit `Option::Some` wrap
# the tail spelling gets for free, and handed the caller a RAW `Int` where it
# dereferenced a tagged-enum pointer. Exit 139, SIGSEGV, from a silent
# miscompile with no diagnostic.
#
# Both spellings are pinned SIDE BY SIDE deliberately: pin 1061 exercised only
# the tail spelling and the whole batch went green while this crashed.

# ── early `return`, bare value (the crashing spelling) ──
def early_ret(x: Int) -> Int?
  if x > 1
    return x * 10
  end
  nil
end

# ── tail expression, bare value (the spelling that always worked) ──
def tail_expr(x: Int) -> Int?
  if x > 1
    x * 10
  else
    nil
  end
end

# ── the long `Option[T]` spelling of the same early return ──
def early_ret_long(x: Int) -> Option[Int]
  if x > 1
    return x * 10
  end
  nil
end

# ── explicit `Some(...)` through `return` (already worked; pinned so a
#    regression in the wrap cannot hide behind the implicit form) ──
def early_ret_some(x: Int) -> Int?
  if x > 1
    return Some(x * 10)
  end
  nil
end

# ── `return nil` — the None side of the same slot ──
def early_ret_nil(x: Int) -> Int?
  if x > 1
    return nil
  end
  Some(x)
end

# ── heap payload: the implicit wrap must box a `String` the same way, so the
#    caller's drop of the payload stays balanced ──
def early_ret_string(x: Int) -> String?
  if x > 1
    return "big"
  end
  nil
end

def run_1850
  puts "early_ret_hit=#{early_ret(5).unwrap_or(0)}"
  puts "early_ret_miss=#{early_ret(0).unwrap_or(-1)}"
  puts "tail_expr_hit=#{tail_expr(5).unwrap_or(0)}"
  puts "tail_expr_miss=#{tail_expr(0).unwrap_or(-1)}"
  puts "early_ret_long=#{early_ret_long(5).unwrap_or(0)}"
  puts "early_ret_some=#{early_ret_some(5).unwrap_or(0)}"
  puts "early_ret_nil=#{early_ret_nil(5).unwrap_or(-1)}"
  puts "early_ret_string=#{early_ret_string(5).unwrap_or("none")}"
  puts "early_ret_string_miss=#{early_ret_string(0).unwrap_or("none")}"
end

# ---- from 1851_option_return_nested ----
# B84 — the same implicit `Option::Some` wrap on a `return` that is NESTED
# inside a loop body or a `match` arm, not just directly under the function's
# top-level `if`. These lower through different enclosing scopes but land in
# the same return slot, so all of them segfaulted before the fix.

# ── `return` from inside a `while` loop ──
def first_multiple(limit: Int, factor: Int) -> Int?
  var i = 1
  while i < limit
    if i % factor == 0
      return i * 100
    end
    i = i + 1
  end
  nil
end

# ── `return` from inside a `for` loop ──
def first_big(xs: Array[Int]) -> Int?
  for x in xs
    if x > 10
      return x * 2
    end
  end
  nil
end

# ── `return` from inside a `match` arm ──
def code_of(x: Int) -> Int?
  match x
    1 -> return 11
    2 -> return 22
    _ -> return nil
  end
end

# ── `return` nested two deep: a `match` arm inside a loop ──
def scan(xs: Array[Int]) -> Int?
  for x in xs
    match x
      7 -> return 700
      _ -> nil
    end
  end
  nil
end

def run_1851
  puts "first_multiple_hit=#{first_multiple(10, 3).unwrap_or(0)}"
  puts "first_multiple_miss=#{first_multiple(3, 99).unwrap_or(-1)}"
  puts "first_big_hit=#{first_big([1, 5, 42, 8]).unwrap_or(0)}"
  puts "first_big_miss=#{first_big([1, 2, 3]).unwrap_or(-1)}"
  puts "code_of_1=#{code_of(1).unwrap_or(0)}"
  puts "code_of_2=#{code_of(2).unwrap_or(0)}"
  puts "code_of_other=#{code_of(9).unwrap_or(-1)}"
  puts "scan_hit=#{scan([1, 7, 9]).unwrap_or(0)}"
  puts "scan_miss=#{scan([1, 2, 3]).unwrap_or(-1)}"
end

# ---- from 1852_result_return_vs_tail ----
# B84 — the `Result` half of the same defect.
#
# `Result` has NO implicit `Ok` wrap in the language: the tail spelling
# `def g(x: Int) -> Result[Int, String]` with a bare `x * 10` tail is a
# type-mismatch DIAGNOSTIC. But the `return` spelling used to skip the check
# entirely (the discarded `unify`), compile clean, and SIGSEGV — the same
# silent miscompile as the `Option` case, hidden behind a type that looked
# well-behaved because its tail spelling was already rejected.
#
# The fix routes both spellings through one return-slot pipeline, so a bare
# `return x * 10` here is now the SAME diagnostic the tail spelling gives.
# This pin locks the spellings that DO compile, side by side, so a future
# change cannot silently re-open the unchecked `return` path.

# ── early `return Ok(...)` / `return Err(...)` ──
def early_ret_1852(x: Int) -> Result[Int, String]
  if x > 1
    return Ok(x * 10)
  end
  Err("small")
end

def early_ret_err(x: Int) -> Result[Int, String]
  if x > 1
    return Err("big")
  end
  Ok(x)
end

# ── the tail spelling of the same function ──
def tail_expr_1852(x: Int) -> Result[Int, String]
  if x > 1
    Ok(x * 10)
  else
    Err("small")
  end
end

# ── `return Ok(...)` nested inside a loop ──
def first_multiple_1852(limit: Int, factor: Int) -> Result[Int, String]
  var i = 1
  while i < limit
    if i % factor == 0
      return Ok(i * 100)
    end
    i = i + 1
  end
  Err("none")
end

# ── `return` from inside a `match` arm ──
#
# NOTE the trailing `Err(...)`: it is NOT dead-code padding. A function body
# that IS a `match` whose every arm diverges via `return` currently types as
# `()` rather than `Never`, so `-> Result[Int, String]` rejects it. That is a
# separate, PRE-EXISTING arm-type-fold gap (reproduced on the pre-fix
# compiler), not part of B84; the `Option` spelling only appears to survive it
# because the implicit `Some` wrap stamps `Option[T]` over the `()`. Keeping
# the match a statement with a real tail sidesteps it so this pin measures the
# `return`-slot behaviour it is actually here for.
def code_of_1852(x: Int) -> Result[Int, String]
  match x
    1 -> return Ok(11)
    2 -> return Ok(22)
    _ -> nil
  end
  Err("unknown")
end

# ── heap payload on both sides ──
def label(x: Int) -> Result[String, String]
  if x > 1
    return Ok("big")
  end
  Err("small")
end

def run_1852
  puts "early_ret_hit=#{early_ret_1852(5).unwrap_or(0)}"
  puts "early_ret_miss=#{early_ret_1852(0).unwrap_or(-1)}"
  puts "early_ret_err_hit=#{early_ret_err(5).unwrap_or(-1)}"
  puts "early_ret_err_miss=#{early_ret_err(0).unwrap_or(-1)}"
  puts "tail_expr_hit=#{tail_expr_1852(5).unwrap_or(0)}"
  puts "tail_expr_miss=#{tail_expr_1852(0).unwrap_or(-1)}"
  puts "first_multiple_hit=#{first_multiple_1852(10, 3).unwrap_or(0)}"
  puts "first_multiple_miss=#{first_multiple_1852(3, 99).unwrap_or(-1)}"
  puts "code_of_1=#{code_of_1852(1).unwrap_or(0)}"
  puts "code_of_other=#{code_of_1852(9).unwrap_or(-1)}"
  puts "label_hit=#{label(5).unwrap_or("none")}"
  puts "label_miss=#{label(0).unwrap_or("none")}"
end

def main
  run_1850
  run_1851
  run_1852
end
