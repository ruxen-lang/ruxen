# Reading an element (`a[0]`, `for x in a`) yields an alias of a slot the
# source still owns. Storing that alias in another collection used to
# leave both collections owning one object: `Array[String]` aborted with
# "free(): double free" at scope exit, and so would `Array[UserClass]`
# once class elements are dropped. The source's drop is now shallow when
# one of its element pointers escapes, so nothing is freed twice.
class P
  x: Int

  def init(@x: Int)
  end
end

def strings
  let a = ["x" + "y", "z" + "w"]
  var b: Array[String] = Array.new
  b.push(a[0])
  b.push(a[0])
  puts "strings #{b.size} #{b[1]}"
end

def objects
  let ps = [P.new(1), P.new(2)]
  var qs: Array[P] = Array.new
  for q in ps
    qs.push(q)
  end
  qs.push(ps[1])
  puts "objects #{qs.size} #{qs[2].x}"
end

strings
objects
puts "done"
