def find(n: Int) -> Option[Int]
  if n > 0
    Some(n)
  else
    None
  end
end

def main
  let r = find(5).map { |n| n + 1 }.map { |n| n * 2 }.map { |n| n - 3 }
  match r
    Some(v) -> puts "some #{v}"
    None    -> puts "none"
  end
  let z = find(-1).map { |n| n + 1 }.map { |n| n * 2 }
  match z
    Some(v) -> puts "some #{v}"
    None    -> puts "none"
  end
end
