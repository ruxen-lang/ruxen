# Pins `String#each_char` / `each_byte` / `each_line` (batch B08). Each takes
# a required block and returns nil: Ruby's block-less Enumerator return has no
# Ruxen surface yet. `each_line` is built on `lines`, which STRIPS the line
# terminator where CRuby keeps it.
def main
  "abc".each_char do |c|
    puts "char #{c}"
  end

  "hi".each_byte do |b|
    puts "byte #{b}"
  end

  "one
two".each_line do |l|
    puts "line #{l}"
  end

  # An empty receiver yields nothing.
  "".each_char do |c|
    puts "unreachable #{c}"
  end
  puts "done"
end
