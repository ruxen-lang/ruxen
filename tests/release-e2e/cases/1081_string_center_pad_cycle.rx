# Pins `String#center` and the multi-character pad CYCLING now shared by
# `center` / `ljust` / `rjust` (batch B09). A multi-character pad used to be
# appended whole per missing character, which OVERSHOT the requested width;
# Ruby cycles it one character at a time, so the result is always exactly
# max(width, length) characters.
def main
  puts "center odd = [#{"hi".center(5)}]"
  puts "center even = [#{"hi".center(6, "-")}]"
  puts "center cycled = [#{"hi".center(7, "12")}]"
  puts "center too narrow = [#{"hello".center(3)}]"
  puts "center empty pad = [#{"hi".center(5, "")}]"

  puts "ljust cycled = [#{"hi".ljust(7, "12")}]"
  puts "rjust cycled = [#{"hi".rjust(7, "12")}]"
  puts "ljust default = [#{"hi".ljust(5)}]"
  puts "rjust default = [#{"hi".rjust(5)}]"
  puts "ljust too narrow = [#{"abcdef".ljust(3, "-")}]"
end
