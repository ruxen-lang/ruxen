# B73: a table's behaviour does not depend on WHICH key was inserted first.
#
# The pre-B73 runtime resolved the key kind on the first insert. For a
# `Hash[String, V]` whose first key was the EMPTY string, the heuristic
# reported "not a string" (it required at least one byte before the NUL),
# latched the table to raw-bits hashing, and every later lookup by content
# missed. Same program, keys swapped, different answer.
#
# Both tables below hold the same three entries and differ only in
# insertion order, so every pair of lines must agree.
def main
  var a: Hash[String, Int] = Hash.new
  a.insert("one", 1)
  a.insert("", 9)
  a.insert("two", 2)

  var b: Hash[String, Int] = Hash.new
  b.insert("", 9)
  b.insert("two", 2)
  b.insert("one", 1)

  puts "#{a.size} #{b.size}"
  puts "#{a.key?("one")} #{b.key?("one")}"
  puts "#{a.key?("two")} #{b.key?("two")}"
  puts "#{a.key?("")} #{b.key?("")}"
  puts "#{a.key?("three")} #{b.key?("three")}"

  # `clear` empties a table; it does not change what its key type is.
  # (Pre-B73 it reset the tristate flag so the table re-guessed.)
  a.clear
  a.insert("", 7)
  a.insert("one", 1)
  puts "#{a.size} #{a.key?("one")} #{a.key?("")}"
end
