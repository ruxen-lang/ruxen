def find(n: Int) -> Int?
  if n > 0
    n
  else
    nil
  end
end

def main
  let r = find(5).map { |n| n + 1 }.map { |n| n * 2 }.map { |n| n - 3 }
  match r
    Some(v) -> puts "some #{v}"
    nil     -> puts "none"
  end
  let z = find(-1).map { |n| n + 1 }.map { |n| n * 2 }
  match z
    Some(v) -> puts "some #{v}"
    nil     -> puts "none"
  end
end
