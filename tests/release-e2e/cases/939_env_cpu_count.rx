# Pins std::env's logical CPU-count FFI (Env.cpu_count -> ruxen_cpu_count).
# The exact core count is machine-dependent, so assert the invariant every
# machine satisfies (>= 1) and emit a deterministic marker for the harness.
def main
  let n = Env.cpu_count
  if n >= 1
    puts "cpu_count_ok"
  else
    puts "cpu_count_bad"
  end
end
