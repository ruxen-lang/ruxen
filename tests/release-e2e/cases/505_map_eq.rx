def main
  var a: Hash[Int, Int] = Hash.new
  a.insert(1, 10)
  a.insert(2, 20)
  var b: Hash[Int, Int] = Hash.new
  b.insert(2, 20)
  b.insert(1, 10)
  var c: Hash[Int, Int] = Hash.new
  c.insert(1, 99)
  c.insert(2, 20)
  puts "a_eq_b=#{a == b}"
  puts "a_eq_c=#{a == c}"
  puts "a_neq_c=#{a != c}"
end
