# Pins the POINT of putting the B07 combinators in `mixin Enumerable[T]`
# rather than on `Array`: one body reaches every including head. `Set` and
# `Hash` get `count` / `entries` / `take` / `drop` / `flat_map` /
# `each_slice` / `each_cons` / `each_with_object` for free, over their own
# `each`.
#
# `Set` and `Hash` iterate in hash-bucket order, not insertion order, so
# this case asserts only ORDER-INDEPENDENT facts (sizes and sums). Order
# is pinned on `Array` in cases 1060 to 1063.
def main
  var s: Set[Int] = Set.new
  s.insert(10)
  s.insert(20)
  s.insert(30)

  puts "set count #{s.count}"
  puts "set entries #{s.entries.size}"
  puts "set take #{s.take(2).size}"
  puts "set drop #{s.drop(2).size}"
  puts "set flat_map #{s.flat_map { |x| [x, x] }.size}"
  puts "set sum #{s.each_with_object(0) { |x, memo| memo + x }}"

  var slices: Int = 0
  s.each_slice(2) { |c| slices = slices + 1 }
  puts "set slices #{slices}"

  var windows: Int = 0
  s.each_cons(2) { |c| windows = windows + 1 }
  puts "set windows #{windows}"

  var reversed: Int = 0
  s.reverse_each { |x| reversed = reversed + 1 }
  puts "set reversed #{reversed}"

  # `Hash`'s element type is the `(K, V)` pair, so every combinator sees a
  # tuple. Small integer values only: `Hash[Int, V]` keys are a separate
  # known runtime issue, so the KEYS here are strings.
  var h: Hash[String, Int] = Hash.new
  h.insert("a", 1)
  h.insert("b", 2)
  h.insert("c", 3)

  puts "hash count #{h.count}"
  puts "hash entries #{h.entries.size}"
  puts "hash take #{h.take(1).size}"
  puts "hash drop #{h.drop(1).size}"
  puts "hash values #{h.flat_map { |pair| [pair.1] }.size}"
  puts "hash sum #{h.each_with_object(0) { |pair, memo| memo + pair.1 }}"
  puts "hash big #{h.select { |pair| pair.1 > 1 }.size}"
end
