use std.fs.{write, symlink, metadata, remove_file}

def describe(m: Metadata)
  if m.is_symlink
    puts "is_symlink=true"
  else
    puts "is_symlink=false"
  end
end

def main
  write("/tmp/ruxen_e2e_537_target.txt", "x").expect!("write")
  match symlink("/tmp/ruxen_e2e_537_target.txt", "/tmp/ruxen_e2e_537_link.txt")
    Ok(_)  -> puts "linked"
    Err(_) -> puts "symlink_fail"
  end
  match metadata("/tmp/ruxen_e2e_537_link.txt")
    Ok(m)  -> describe(m)
    Err(_) -> puts "metadata_fail"
  end
  remove_file("/tmp/ruxen_e2e_537_link.txt").expect!("rm link")
  remove_file("/tmp/ruxen_e2e_537_target.txt").expect!("rm target")
end
