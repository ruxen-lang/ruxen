# The derive check walks a type's fields with a recursion stack and a
# memo: a recursive type (`Node` holding `Array[Node]`) is assumed to
# support a derive while it is being checked, a type reached along many
# paths is checked once, and a class with more than 32 distinct field
# types is checked in full. All three clone through their derived bodies.
class Node
  name: String
  children: Array[Node]

  def init(@name: String, @children: Array[Node])
  end

  def first_child -> String
    @children[0].name.clone
  end
end

struct S1
  v: Int
end

