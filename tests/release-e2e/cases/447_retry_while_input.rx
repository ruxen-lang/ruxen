## Feature #6 Increment 3 (spec §4.6) — `while_input` predicate flows through the
## ASYNC RetryFuture driver: an Err is retried ONLY while the predicate holds; a
## non-matching error stops immediately (no backoff, no further attempts).
##
## Policy: recurs(5).while_input { |e| e < 5 }. The source returns Err(2) on
## attempt 0 (e<5 → retry), then Err(9) on attempt 1 (e>=5 → predicate rejects →
## STOP with Err(9), even though 4 attempts remain in the budget). Proves the
## predicate short-circuits the async retry. No backoff (recurs → 0 delay), so it
## resolves in a single drive-through poll — no TestClock needed.

class Seq
  i: Int
  include Future
  type Output = Result[Int, Int]
  def init(i: Int)
    self.i = i
  end
  def var poll(cx: &var Context) -> Poll[Result[Int, Int]]
    if self.i == 0
      Poll.Ready(Result.Err(2))
    else
      Poll.Ready(Result.Err(9))
    end
  end
end

class Src
  n: Int
  def init
    self.n = 0
  end
  def var make_next -> Seq
    let f = Seq.new(self.n)
    self.n = self.n + 1
    f
  end
end

def main
  puts "wi start"
  var cx = Context.executor
  var src = Src.new

  var rf = AsyncRetry.retry(Schedule.recurs(5).while_input { |e| e < 5 }, { || src.make_next })
  match (&var rf).poll(&var cx)
    Poll.Ready(r) ->
      match r
        Ok(v)  -> puts "ok=#{v}"
        Err(e) -> puts "err=#{e}"
      end
    Poll.Pending -> puts "pending"
  end
  Context.drop(cx)
  puts "wi done"
end
