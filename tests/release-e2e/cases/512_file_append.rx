use std.fs.{write, read_to_string, remove_file}
use std.io.File

def append_bar(f: File)
  match f.write_str("bar")
    Ok(_)  -> puts "appended_ok"
    Err(_) -> puts "append_fail"
  end
end

def main
  write("/tmp/ruxen_e2e_512_append.txt", "foo").expect!("write")
  match File.append("/tmp/ruxen_e2e_512_append.txt")
    Ok(f)  -> append_bar(f)
    Err(_) -> puts "open_fail"
  end
  match read_to_string("/tmp/ruxen_e2e_512_append.txt")
    Ok(s)  -> puts "result=#{s}"
    Err(_) -> puts "read_fail"
  end
  remove_file("/tmp/ruxen_e2e_512_append.txt").expect!("remove")
end
