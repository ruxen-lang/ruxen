def main
  var h: Hash[String, Int] = Hash.new
  h.insert("alpha", 10)
  h.insert("beta", 20)
  h.insert("gamma", 30)
  puts "len=#{h.size}"
  match h.get("alpha")
    Some(v) -> puts "alpha=#{v}"
    nil     -> puts "alpha=missing"
  end
  match h.get("missing")
    Some(v) -> puts "missing=#{v}"
    nil     -> puts "missing=missing"
  end
end
