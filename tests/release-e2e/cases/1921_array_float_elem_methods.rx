# F-4: Array sum/sort/include?/dedup/== use Float arithmetic and
# ordering, not the raw 64-bit words. Negative floats sort backwards
# and add to garbage under an integer kernel; `0.0 == -0.0` is false
# bitwise but true as Floats.
def main
  var a: Array[Float] = Array.new
  a.push(-1.5)
  a.push(2.25)
  a.push(-3.5)
  a.push(0.0)
  puts "sum=#{a.sum}"
  puts "include_neg_zero=#{a.include?(-0.0)}"

  puts "sort=#{a.sort.join(",")}"
  puts "receiver=#{a.join(",")}"
  a.sort!
  puts "sort_bang=#{a.join(",")}"

  var b: Array[Float] = Array.new
  b.push(-3.5)
  b.push(-1.5)
  b.push(-0.0)
  b.push(2.25)
  puts "eq=#{a == b}"

  var c: Array[Float] = Array.new
  c.push(0.0)
  c.push(-0.0)
  c.push(1.5)
  c.dedup
  puts "dedup_len=#{c.size}"

  let empty: Array[Float] = Array.new
  puts "empty_sum=#{empty.sum}"
end
