## Feature #3 Increment 2 (spec §4.3) — loser-cancel runs the loser's `def
## drop`. When the winning arm completes, the C race step CANCELS the losing
## arm — firing its `def drop` via the §4.1 `Drop_dynamic_drop` path (reactor
## deregister / fd close / free) — BEFORE the winner's value is returned.
##
## The losing `Leaker` arm stays Pending forever and has an OBSERVABLE drop.
## `Quick` wins immediately; the race must drop `Leaker` (its "loser dropped"
## prints) before `block_on` returns the winner. Exact-match stdout (one drop
## line, then the winner) proves the loser's drop fired exactly once, on the
## win path.

class Quick3
  payload: Int
  include Future
  type Output = Int
  def init(p: Int)
    self.payload = p
  end
  def self.make(p: Int) -> Quick3
    Quick3.new(p)
  end
  def var poll(cx: &var Context) -> Poll[Int]
    Poll.Ready(self.payload)
  end
end

class Leaker3
  tag: Int
  include Future
  type Output = Int
  def init(t: Int)
    self.tag = t
  end
  def self.make(t: Int) -> Leaker3
    Leaker3.new(t)
  end
  def var poll(cx: &var Context) -> Poll[Int]
    Poll.Pending
  end
  def drop
    puts "loser dropped tag=#{self.tag}"
  end
end

def main
  puts "race start"
  let r = block_on(Race.of(Quick3.make(11), Leaker3.make(7)))
  match r
    Race2.First(p)  -> puts "first won p=#{p}"
    Race2.Second(p) -> puts "second won p=#{p}"
  end
  puts "race done"
end
