# B74: structural `==` on a `class` holding `String` fields.
#
# A `String` field is a heap buffer, so a slot-by-slot compare of the
# raw words is a POINTER compare and would report two equal-by-value
# names unequal. The derived body routes a `String` slot through the
# value comparison instead.
#
# Every compared string on the right-hand side is BUILT BY
# CONCATENATION rather than written as a literal, so the two objects
# genuinely hold distinct buffers. A pin that wrote `"Ada"` on both
# sides could pass on literal sharing alone and prove nothing.
class Name
  first: String
  last: String

  def init(@first: String, @last: String)
  end
end

def main
  let a = Name.new("Ada", "Lovelace")
  let b = Name.new("Ad" + "a", "Love" + "lace")
  let c = Name.new("Ada", "Byron")
  let d = Name.new("Grace", "Lovelace")

  puts "eq_distinct_buffers=#{a == b}"
  puts "ne_last=#{a == c}"
  puts "ne_first=#{a == d}"
  puts "bang_eq=#{a != b}"
  puts "bang_ne=#{a != c}"

  # An empty string is a value like any other, not a null slot.
  let e = Name.new("", "")
  let f = Name.new("", "")
  puts "empty_eq=#{e == f}"
  puts "empty_vs_set=#{e == a}"
end
