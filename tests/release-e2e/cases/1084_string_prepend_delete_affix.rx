# Pins `String#prepend`, `#delete_prefix` and `#delete_suffix` (batch B09).
# Ruby's `prepend` mutates the receiver and returns self; a `.rx` body cannot
# rewrite the caller's string (the receiver is a buffer pointer held by
# value), so this returns a new String instead.
def main
  puts "prepend = #{"world".prepend("hello ")}"
  puts "prepend onto empty = #{"".prepend("ab")}"
  puts "prepend empty = #{"ab".prepend("")}"

  puts "delete_prefix hit = #{"hello".delete_prefix("he")}"
  puts "delete_prefix miss = #{"hello".delete_prefix("z")}"
  puts "delete_prefix whole = [#{"hello".delete_prefix("hello")}]"

  puts "delete_suffix hit = #{"hello".delete_suffix("lo")}"
  puts "delete_suffix miss = #{"hello".delete_suffix("z")}"
  puts "delete_suffix whole = [#{"hello".delete_suffix("hello")}]"
end
