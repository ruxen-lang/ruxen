mixin Greater
  def greater_than(other: &Self) -> Bool
end

extension Int
  include Greater

  def greater_than(other: &Int) -> Bool
    self > *other
  end
end

def max[T: Greater](a: T, b: T) -> T
  if a.greater_than(&b)
    a
  else
    b
  end
end

def main
  let m = max(7, 3)
  puts "#{m}"
end
