mixin Showable
  def to_display -> String
end

class Tag
  label: String

  def init(@label: String)
  end

  include Showable

  def to_display -> String
    self.label.clone
  end
end

def print_any(x: &any Showable)
  puts "#{x.to_display}"
end

def main
  let t = Tag.new(String.from("any"))
  print_any(&t)
end
