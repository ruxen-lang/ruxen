# F-22 guard. `.unwrap` / `.nil?` / `.present?` on an `Option[C]` returned by
# a stdlib method, where `C` is a stdlib class (JSON.object_get -> Json,
# Regex#find -> Match, Mutex#try_lock -> MutexGuard), type-check and run
# without a typed binding.
def main
  let j = JSON.parse("{\"a\": 1}").unwrap
  let v = JSON.object_get(j, "a")
  puts v.nil?
  puts v.present?
  puts JSON.stringify(v.unwrap).unwrap
  puts JSON.object_get(j, "b").nil?
  let re = Regex.new("a+", "").unwrap
  let found = re.find("baaa")
  puts found.present?
  puts found.unwrap.matched
  puts re.find("xyz").nil?
  let m = Mutex.new(5)
  puts m.try_lock.present?
end
