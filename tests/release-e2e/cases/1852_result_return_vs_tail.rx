# B84 — the `Result` half of the same defect.
#
# `Result` has NO implicit `Ok` wrap in the language: the tail spelling
# `def g(x: Int) -> Result[Int, String]` with a bare `x * 10` tail is a
# type-mismatch DIAGNOSTIC. But the `return` spelling used to skip the check
# entirely (the discarded `unify`), compile clean, and SIGSEGV — the same
# silent miscompile as the `Option` case, hidden behind a type that looked
# well-behaved because its tail spelling was already rejected.
#
# The fix routes both spellings through one return-slot pipeline, so a bare
# `return x * 10` here is now the SAME diagnostic the tail spelling gives.
# This pin locks the spellings that DO compile, side by side, so a future
# change cannot silently re-open the unchecked `return` path.

# ── early `return Ok(...)` / `return Err(...)` ──
def early_ret(x: Int) -> Result[Int, String]
  if x > 1
    return Ok(x * 10)
  end
  Err("small")
end

def early_ret_err(x: Int) -> Result[Int, String]
  if x > 1
    return Err("big")
  end
  Ok(x)
end

# ── the tail spelling of the same function ──
def tail_expr(x: Int) -> Result[Int, String]
  if x > 1
    Ok(x * 10)
  else
    Err("small")
  end
end

# ── `return Ok(...)` nested inside a loop ──
def first_multiple(limit: Int, factor: Int) -> Result[Int, String]
  var i = 1
  while i < limit
    if i % factor == 0
      return Ok(i * 100)
    end
    i = i + 1
  end
  Err("none")
end

# ── `return` from inside a `match` arm ──
#
# NOTE the trailing `Err(...)`: it is NOT dead-code padding. A function body
# that IS a `match` whose every arm diverges via `return` currently types as
# `()` rather than `Never`, so `-> Result[Int, String]` rejects it. That is a
# separate, PRE-EXISTING arm-type-fold gap (reproduced on the pre-fix
# compiler), not part of B84; the `Option` spelling only appears to survive it
# because the implicit `Some` wrap stamps `Option[T]` over the `()`. Keeping
# the match a statement with a real tail sidesteps it so this pin measures the
# `return`-slot behaviour it is actually here for.
def code_of(x: Int) -> Result[Int, String]
  match x
    1 -> return Ok(11)
    2 -> return Ok(22)
    _ -> nil
  end
  Err("unknown")
end

# ── heap payload on both sides ──
def label(x: Int) -> Result[String, String]
  if x > 1
    return Ok("big")
  end
  Err("small")
end

def main
  puts "early_ret_hit=#{early_ret(5).unwrap_or(0)}"
  puts "early_ret_miss=#{early_ret(0).unwrap_or(-1)}"
  puts "early_ret_err_hit=#{early_ret_err(5).unwrap_or(-1)}"
  puts "early_ret_err_miss=#{early_ret_err(0).unwrap_or(-1)}"
  puts "tail_expr_hit=#{tail_expr(5).unwrap_or(0)}"
  puts "tail_expr_miss=#{tail_expr(0).unwrap_or(-1)}"
  puts "first_multiple_hit=#{first_multiple(10, 3).unwrap_or(0)}"
  puts "first_multiple_miss=#{first_multiple(3, 99).unwrap_or(-1)}"
  puts "code_of_1=#{code_of(1).unwrap_or(0)}"
  puts "code_of_other=#{code_of(9).unwrap_or(-1)}"
  puts "label_hit=#{label(5).unwrap_or("none")}"
  puts "label_miss=#{label(0).unwrap_or("none")}"
end
