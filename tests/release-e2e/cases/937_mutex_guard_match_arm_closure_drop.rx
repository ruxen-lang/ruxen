# Q52 — a user-drop MutexGuard bound inside a match arm in a stored closure
# unlocks exactly once on the taken arm. Calling the closure twice proves the
# first guard really unlocked; leaking/no-op'ing its drop would deadlock here.
def main
  let m = Mutex.new("twice")
  let reader = { ||
    match m.lock
      Ok(g)  -> g.get.clone
      Err(_) -> "poisoned"
    end
  }
  puts "first=#{reader.()}"
  puts "second=#{reader.()}"
end
