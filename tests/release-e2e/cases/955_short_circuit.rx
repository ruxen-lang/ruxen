# Pins short-circuit evaluation of `&&` / `||`: the RHS is evaluated ONLY when
# the LHS does not already decide the result. `flag` prints when evaluated, so
# a missing line proves the operand was skipped.
def flag(tag: String, val: Bool) -> Bool
  puts "eval #{tag}"
  val
end

def main
  # `||` with a true LHS skips the RHS.
  let a = flag(&"A", true) || flag(&"B", true)
  puts "a=#{a}"

  # `&&` with a false LHS skips the RHS.
  let b = flag(&"C", false) && flag(&"D", true)
  puts "b=#{b}"

  # The non-deciding path still evaluates the RHS.
  let c = flag(&"E", false) || flag(&"F", true)
  puts "c=#{c}"
end
