# Pins `String#delete`, `#squeeze` (both arities), `#tr` and `#tr_s`
# (batch B09). All four read Ruby's tr-style set syntax through the shared
# `tr_set_expand` / `tr_set_negated?` building blocks: `a-z` ranges, a leading
# `^` negation, and `\` escapes.
def main
  puts "delete l = #{"hello".delete("l")}"
  puts "delete range = [#{"hello".delete("a-y")}]"
  puts "delete negated = #{"hello".delete("^aeiou")}"

  puts "squeeze all = #{"aaabbbccc".squeeze}"
  puts "squeeze set = #{"aaabbbccc".squeeze("a")}"
  puts "squeeze sp = #{"mississippi".squeeze("sp")}"
  puts "squeeze empty = [#{"".squeeze}]"

  puts "tr pair = #{"hello".tr("el", "ip")}"
  puts "tr range = #{"hello".tr("a-y", "b-z")}"
  puts "tr negated = #{"hello".tr("^aeiou", "*")}"
  puts "tr deletes = #{"hello".tr("el", "")}"
  puts "tr padded = #{"hello".tr("el", "x")}"

  puts "tr_s runs = #{"hello".tr_s("l", "r")}"
  puts "tr_s merged = #{"hello".tr_s("el", "*")}"
end
