# Pins the String-side Regex bridge (batch B11): `match`, `match?`, `scan`,
# and the `Regex` overloads of `sub` / `gsub` / `split` / `index`. Each regex
# form is selected by ARGUMENT TYPE against its string-argument sibling from
# B10, so one Ruby name covers both, and the string forms must keep working.
def main
  puts "match? hit = #{"a1".match?(/\d/)}"
  puts "match? miss = #{"ab".match?(/\d/)}"

  match "code=42".match(/code=(\d+)/)
    Some(m) ->
      match m.group(1)
        Some(g) -> puts "match capture = #{g}"
        nil     -> puts "match capture = none"
      end
    nil -> puts "match = none"
  end
  match "ab".match(/\d/)
    Some(m) -> puts "match miss = #{m.matched}"
    nil     -> puts "match miss = nil"
  end

  let found = "a1b22c".scan(/\d+/)
  puts "scan count = #{found.size}"
  puts "scan 0 = #{found[0]}"
  puts "scan 1 = #{found[1]}"

  puts "sub regex = #{"a1b2".sub(/\d/, "#")}"
  puts "gsub regex = #{"a1b2".gsub(/\d/, "#")}"

  let parts = "a1b22c".split(/\d+/)
  puts "split regex = [#{parts[0]}] [#{parts[1]}] [#{parts[2]}]"

  # Ruby's `=~` answer, under Ruby's other name for it. `=~` itself cannot be
  # defined: Ruxen's lexer has no such token (its match operator is `~=`).
  match "abc1".index(/\d/)
    Some(i) -> puts "index regex = #{i}"
    nil     -> puts "index regex = nil"
  end
  match "abc".index(/\d/)
    Some(i) -> puts "index regex miss = #{i}"
    nil     -> puts "index regex miss = nil"
  end
  # A CHARACTER index, so the two-byte accented character counts once.
  match "héllo1".index(/\d/)
    Some(i) -> puts "index regex utf8 = #{i}"
    nil     -> puts "index regex utf8 = nil"
  end

  # The string-argument overloads still resolve.
  puts "gsub string = #{"a-b".gsub("-", "+")}"
  puts "sub string = #{"a-b-c".sub("-", "+")}"
  puts "split string = #{"a,b".split(",").size}"
  puts "tilde-eq operator = #{"a1" ~= /\d/}"
end
