# B72 — `Hash[k] = v` subscript-assign, INT key half.
#
# Same three-way assertion as 1710 (`size`, `key?`, subscript read-back) on an
# `Hash[Int, String]`, so the fix is pinned as key-type-agnostic rather than
# String-key-shaped. The VALUE is a String here, the mirror of 1710's String
# key / Int value, so the ownership half is pinned in both directions: the
# subscript-assign must transfer the value allocation into the table exactly
# once (a delegating `def []=` body instead of the `alias` would leave the
# caller freeing a value the table had already taken, double-freeing at scope
# exit — this case would abort rather than print).
#
# Keys are deliberately kept BELOW 4096: `Hash[Int, V]` segfaults at or above
# that (B73 — the C runtime's key-kind heuristic dereferences the key as a
# pointer), which is a separate defect. This pin must not depend on it.
def main
  var h: Hash[Int, String] = Hash.new
  h[1] = "one"
  puts h.size
  puts h.key?(1)
  puts h[1]

  h[42] = "forty-two"
  h[4095] = "edge"
  puts h.size
  puts h[42]
  puts h[4095]

  # Overwrite on an Int key.
  h[1] = "uno"
  puts h.size
  puts h[1]

  puts h.key?(2)
end
