## Feature #7 Increment 2 (spec §4.7) — `TestClock.advance_to_next` (step to the
## next pending timer's deadline, firing it) + `TestClock.set` (absolute jump).
## Lets a test drive time deterministically deadline-by-deadline.
##
## Two sleeps are registered: A at 10s, B at 25s (each hand-polled once to
## register its virtual timer + park). Then:
##   * advance_to_next → jumps to A's deadline (10s), fires A, returns the ns
##     advanced (10s = 10_000_000_000). B (25s) is NOT yet due.
##   * advance_to_next → jumps to B's deadline (25s), fires B, returns the delta
##     from 10s to 25s (15s = 15_000_000_000).
##   * advance_to_next → nothing pending → returns -1.
## Poll each after its deadline is reached to confirm Ready. Proves
## advance_to_next steps to the exact next deadline and reports the delta.

use std.time.Duration

def main
  puts "atn start"
  var guard = TestClock.install
  var cx = Context.executor

  var a = Async.sleep(Duration.from_secs(10))
  var b = Async.sleep(Duration.from_secs(25))

  # Register both (first poll parks each, registering its virtual timer).
  match (&var a).poll(&var cx)
    Poll.Ready(_) -> puts "a1=ready (BUG)"
    Poll.Pending  -> puts "a1=pending"
  end
  match (&var b).poll(&var cx)
    Poll.Ready(_) -> puts "b1=ready (BUG)"
    Poll.Pending  -> puts "b1=pending"
  end

  # Step to A's deadline (10s).
  let d1 = TestClock.advance_to_next
  puts "d1=#{d1}"
  match (&var a).poll(&var cx)
    Poll.Ready(_) -> puts "a2=ready"
    Poll.Pending  -> puts "a2=pending (BUG)"
  end

  # Step to B's deadline (25s) — delta from 10s is 15s.
  let d2 = TestClock.advance_to_next
  puts "d2=#{d2}"
  match (&var b).poll(&var cx)
    Poll.Ready(_) -> puts "b2=ready"
    Poll.Pending  -> puts "b2=pending (BUG)"
  end

  # Nothing left pending.
  let d3 = TestClock.advance_to_next
  puts "d3=#{d3}"

  puts "atn done"
end
