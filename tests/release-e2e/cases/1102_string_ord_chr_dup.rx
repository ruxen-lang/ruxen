# Pins `String#ord`, `#chr`, `#to_str` and `#dup` (batch B11). `ord` on an
# EMPTY receiver aborts (Ruby raises ArgumentError and Ruxen has no exception
# surface), so it is exercised here only on non-empty strings.
def main
  puts "ord A = #{"A".ord}"
  puts "ord first of many = #{"abc".ord}"
  puts "ord utf8 = #{"é".ord}"

  puts "chr = #{"hello".chr}"
  puts "chr utf8 = #{"étude".chr}"
  puts "chr empty = [#{"".chr}]"

  puts "to_str = #{"hi".to_str}"
  puts "to_str empty = [#{"".to_str}]"
  puts "dup = #{"hi".dup}"
  puts "dup empty = [#{"".dup}]"

  # `dup` is an independent copy: mutating it leaves the source alone.
  var copy = "hello".dup
  copy.push_str(" world")
  puts "dup is independent = #{copy}"
end
