# B74: a user-written `def ==` on a `class` still WINS over the
# synthesized structural one.
#
# `expr/binops.rs` tries the operator-to-method desugar before the
# structural-derive route, so adding class synthesis must not shadow a
# hand-written `==`. The class below deliberately compares only ONE of
# its two fields, so the two answers are distinguishable: structural
# equality would say `false` for `a == b` (the minors differ) while the
# user's method says `true`. A regression that reorders the routes
# flips these lines rather than merely changing a message.
#
# `!=` is pinned too: it must invert the USER's answer, not compute a
# separate structural one.
class Ver
  major: Int
  minor: Int

  def init(@major: Int, @minor: Int)
  end

  def ==(other: Ver) -> Bool
    self.major == other.major
  end
end

def main
  let a = Ver.new(1, 0)
  let b = Ver.new(1, 9)
  let c = Ver.new(2, 0)

  puts "user_eq_same_major=#{a == b}"
  puts "user_eq_diff_major=#{a == c}"
  puts "user_bang_same_major=#{a != b}"
  puts "user_bang_diff_major=#{a != c}"

  # The METHOD spelling takes a different route through the lowerer
  # than the OPERATOR spelling, so pin both (QUEUE.md §0).
  puts "method_same_major=#{a.==(b)}"
  puts "method_diff_major=#{a.==(c)}"
end
