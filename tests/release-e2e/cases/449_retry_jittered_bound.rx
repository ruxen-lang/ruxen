## Feature #6 Increment 3 (spec §4.6) — `jittered` flows through the ASYNC
## RetryFuture driver. Full-jitter makes the actual backoff a uniform random in
## [0, base]; we assert the BOUND deterministically under TestClock: with
## exponential(50ms).max_attempts(2).jittered there is exactly ONE backoff, in
## [0, 50ms]. Advancing virtual time by the FULL 50ms (the max) ALWAYS fires the
## jittered timer (jitter <= base), so the 2nd attempt runs and succeeds. This
## proves jitter stays within [0, base] (the max advance always covers it) and
## that the jittered policy drives the async retry. (We can't assert the exact
## random delay — that's the point of jitter — but the bound + success is the
## deterministic, meaningful invariant.)

class Once
  i: Int
  include Future
  type Output = Result[Int, Int]
  def init(i: Int)
    self.i = i
  end
  def var poll(cx: &var Context) -> Poll[Result[Int, Int]]
    if self.i == 0
      Poll.Ready(Result.Err(1))
    else
      Poll.Ready(Result.Ok(8))
    end
  end
end

class Src
  n: Int
  def init
    self.n = 0
  end
  def var make_next -> Once
    let f = Once.new(self.n)
    self.n = self.n + 1
    f
  end
end

def poll_phase(rf: &var RetryFuture, cx: &var Context) -> Int
  match (&var rf).poll(&var cx)
    Poll.Ready(r) ->
      match r
        Ok(v)  -> v
        Err(_) -> -1
      end
    Poll.Pending -> -2
  end
end

def main
  puts "jit start"
  TestClock.install
  var cx = Context.executor
  var src = Src.new

  var rf = AsyncRetry.retry(Schedule.exponential(Duration.from_millis(50)).max_attempts(2).jittered, { || src.make_next })

  puts "p1=#{poll_phase(&var rf, &var cx)}"     # attempt 0 Err → parks on a jittered backoff in [0,50ms]
  TestClock.advance(Duration.from_millis(50))   # full base — always >= the jittered delay
  puts "p2=#{poll_phase(&var rf, &var cx)}"     # backoff fired → attempt 1 → Ok(8)
  puts "slots_after=#{ruxen_reactor_registered_count()}"

  TestClock.uninstall
  puts "jit done"
end
