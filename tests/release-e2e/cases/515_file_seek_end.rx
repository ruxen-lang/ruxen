use std.fs.{write, remove_file}
use std.io.File
use std.io.SeekFrom

def end_pos(f: File)
  match f.seek(SeekFrom.End(offset: 0))
    Ok(p)  -> puts "pos=#{p}"
    Err(_) -> puts "seek_fail"
  end
end

def main
  write("/tmp/ruxen_e2e_515_seekend.bin", "0123456789ABCDEF").expect!("write")
  match File.open("/tmp/ruxen_e2e_515_seekend.bin")
    Ok(f)  -> end_pos(f)
    Err(_) -> puts "open_fail"
  end
  remove_file("/tmp/ruxen_e2e_515_seekend.bin").expect!("remove")
end
