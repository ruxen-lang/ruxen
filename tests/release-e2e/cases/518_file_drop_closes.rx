use std.fs.{write, remove_file}
use std.io.File

# Open a fresh File inside a loop body 1024 times. Each iteration's
# `_f` falls out of scope at the loop-body brace, triggering the
# scope-exit drop pass to emit `File_drop(_f) + ruxen_dealloc(_f)`.
# Without that wiring the loop would exhaust fds (EMFILE) somewhere
# under the iteration count on most systems.
def open_one() -> Int
  match File.open("/tmp/ruxen_e2e_518_touch.txt")
    Ok(_)  -> 1
    Err(_) -> 0
  end
end

def main
  write("/tmp/ruxen_e2e_518_touch.txt", "x").expect!("write")
  var i = 0
  var opened = 0
  while i < 1024
    opened = opened + open_one()
    i = i + 1
  end
  puts "opened=#{opened}"
  remove_file("/tmp/ruxen_e2e_518_touch.txt").expect!("remove")
end
