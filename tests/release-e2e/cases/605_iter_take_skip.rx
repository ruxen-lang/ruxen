def main
  let v = [10, 20, 30, 40, 50]
  let head = v.take(3).sum
  puts "head=#{head}"
  let tail = v.drop(2).sum
  puts "tail=#{tail}"
  let mid = v.drop(1).take(3).sum
  puts "mid=#{mid}"
  let over = v.take(99).count
  puts "over=#{over}"
  let drop_all = v.drop(99).count
  puts "drop_all=#{drop_all}"
end
