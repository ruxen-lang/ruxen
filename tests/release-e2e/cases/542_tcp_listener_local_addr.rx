use std.net.TcpListener

def report(s: String)
  # The kernel-chosen port varies per run, so we only assert the
  # IPv4 host portion. The presence of `127.0.0.1:` is what locks
  # the format in.
  if s.starts_with("127.0.0.1:")
    puts "prefix_ok=true"
  else
    puts "prefix_ok=false"
  end
end

def show_prefix(l: TcpListener)
  match l.local_addr()
    Ok(s)  -> report(s)
    Err(_) -> puts "addr=err"
  end
end

def main
  match TcpListener.bind(&"127.0.0.1:0")
    Ok(l)  -> show_prefix(l)
    Err(_) -> puts "bind=err"
  end
end
