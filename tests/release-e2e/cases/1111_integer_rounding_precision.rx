# Ruby-parity batch B12 — `Integer#ceil` / `#floor` / `#round` / `#truncate`,
# including the negative-`ndigits` precision forms where the four differ.
#
# The four rounding directions only diverge on a negative receiver, so those
# rows are the point of this pin:
#   (-25).floor(-1) == -30   (toward negative infinity)
#   (-25).ceil(-1)  == -20   (toward positive infinity)
#   (-25).round(-1) == -30   (half AWAY from zero, CRuby's default)
#   (-25).truncate(-1) == -20 (toward zero)
# Diffed against CRuby 3.3. Receivers are let-bound because `-25.floor(-1)`
# would parse as `-(25.floor(-1))`.
def main
  let a = -1234
  let b = -25
  let c = -24
  puts("identity #{1234.ceil} #{1234.floor} #{1234.round} #{1234.truncate}")
  puts("positive-ndigits #{1234.ceil(2)} #{1234.floor(2)} #{1234.round(2)} #{1234.truncate(2)}")
  puts("ceil #{1234.ceil(-2)} #{a.ceil(-2)} #{25.ceil(-1)} #{b.ceil(-1)}")
  puts("floor #{1234.floor(-2)} #{a.floor(-2)} #{25.floor(-1)} #{b.floor(-1)}")
  puts("round #{1234.round(-2)} #{a.round(-2)} #{25.round(-1)} #{b.round(-1)} #{24.round(-1)} #{c.round(-1)}")
  puts("truncate #{1234.truncate(-2)} #{a.truncate(-2)} #{25.truncate(-1)} #{b.truncate(-1)}")
  puts("zero-receiver #{0.ceil(-3)} #{0.floor(-3)} #{0.round(-3)} #{0.truncate(-3)}")
  # Guards the half-detection in `round`: rounding the i64 MAXIMUM at the
  # 10**18 place overflows if the half is found by rounding `a + m / 2`,
  # so it is found by `rest * 2 >= m` instead. CRuby agrees on this one.
  let max = 9223372036854775807
  # `ceil` is left out on purpose: rounding the maximum UP at any negative
  # ndigits leaves the i64 range, where CRuby answers with a Bignum.
  puts("i64-max #{max.round(-18)} #{max.floor(-18)} #{max.truncate(-18)}")
end
