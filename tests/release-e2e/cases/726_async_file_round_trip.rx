## Spec docs/specs/stdlib/async_io.spec.md Milestone 4B (B4–B6):
## AsyncFile end-to-end — write a tempfile, read it back, assert
## equality. Exercises:
##
##   B4 — AsyncFile.create / AsyncFile.open return an AsyncOpenFuture
##        that resolves Ready(Ok(AsyncFile)) on first poll. Regular
##        files don't block; the future shape exists for surface
##        symmetry with AsyncTcpStream.connect (where the wait is
##        real).
##   B5 — AsyncFile.read_to_string reads until EOF, accumulating into
##        a heap buffer; on a fresh regular file the read completes
##        synchronously. The fixture verifies roundtrip equality.
##   B6 — AsyncFile.write_all writes all of `content`. Loops on EAGAIN
##        with reactor write-readiness registration.
##
## Drives each future directly through `block_on(...)`. We avoid
## chaining via `async def`+`.await` because that path is reserved
## for free-fn-call awaitees today (async_lowering's describe_await
## requires the awaitee to be a direct top-level call); hand-written
## futures returned by instance methods drive through block_on, one
## future per call.

## Open-for-write + write_all. Returns 1 on success, 0 on failure.
def write_payload(path: &String, contents: &String) -> Int
  let opened_w = block_on(AsyncFile.create(path))
  match opened_w
    Ok(f)  -> finish_write(f, contents)
    Err(_) -> 0
  end
end

def finish_write(f: AsyncFile, contents: &String) -> Int
  var fv = f
  let w = block_on(fv.write_all(contents))
  match w
    Ok(_)  -> 1
    Err(_) -> 0
  end
end

## Open-for-read + read_to_string. Returns 1 if the contents match
## `expected`, 0 otherwise (incl. error paths).
def read_check(path: &String, expected: &String) -> Int
  let opened_r = block_on(AsyncFile.open(path))
  match opened_r
    Ok(f)  -> finish_read_check(f, expected)
    Err(_) -> 0
  end
end

## Manual poll loop. block_on's AST rewrite types its result-carrying
## local as Int (the rewriter declares `var __block_on_res_N = 0` and
## doesn't yet learn the future's Output type), so a `Result[String,
## IoError]` flowing out of block_on would be observed as Int and
## subsequent destructuring would lose the inner String type. We
## hand-drive the poll loop here while typeck retains the typed
## Ready payload.
##
## Spec-compliant: the future is owned by `fut` and dropped at this
## function's scope exit; the reactor handle (if any was acquired on
## EAGAIN) deregisters in the future's `def drop`. For regular files
## the read completes on the first poll without ever parking.
def finish_read_check(f: AsyncFile, expected: &String) -> Int
  var fv = f
  var fut = fv.read_to_string
  var ctx = Context.executor
  var matched = 0
  var done = 0
  while done == 0
    matched = poll_once_check(&var fut, &var ctx, expected)
    if matched >= 0
      done = 1
    end
  end
  matched
end

## Single-step driver: poll once, return the comparison result (1 or 0)
## on Ready, or -1 on Pending (caller loops). Wraps the match arms with
## single-expression bodies — match arms with multi-statement bodies
## need explicit do..end blocks that the current parser stumbles on
## when they appear inside an assignment RHS.
def poll_once_check(fut: &var AsyncReadToStringFuture, ctx: &var Context, expected: &String) -> Int
  match fut.poll(ctx)
    Poll.Ready(r) -> read_result_to_int(r, expected)
    Poll.Pending  -> yield_and_neg1
  end
end

def yield_and_neg1 -> Int
  Thread.yield_now
  0 - 1
end

def read_result_to_int(r: Result[String, IoError], expected: &String) -> Int
  match r
    Ok(s)  -> compare_strings(s, expected)
    Err(_) -> 0
  end
end

def compare_strings(a: String, b: String) -> Int
  ruxen_async_str_equals(a, b)
end

def main
  let path = String.from("/tmp/ruxen_async_file_test_726.txt")
  let contents = String.from("async file round trip\n")

  let wrote = write_payload(path, contents)
  if wrote == 1
    puts "write_ok"
  else
    puts "write_fail"
  end

  let matched = read_check(path, contents)
  if matched == 1
    puts "ok"
  else
    puts "fail_mismatch"
  end
end
