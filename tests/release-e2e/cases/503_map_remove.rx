def main
  var h: Hash[Int, Int] = Hash.new
  h.insert(1, 10)
  h.insert(2, 20)
  match h.remove(1)
    Some(v) -> puts "got=#{v}"
    nil     -> puts "got=missing"
  end
  match h.remove(99)
    Some(v) -> puts "miss=#{v}"
    nil     -> puts "miss=none"
  end
  let n = h.size
  puts "len=#{n}"
end
