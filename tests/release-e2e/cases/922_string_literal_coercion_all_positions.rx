# Bare string literals are born owned `String` and work in EVERY position — the
# invariant that let us DELETE `String.from` from the language entirely (the old
# `String.from("literal")` idiom across docs + stdlib + the four repos), and
# that lets a bare literal satisfy a `&String` borrow param at the call site
# (the call site auto-refs). One string type only: `&str` is removed
# (one-string-type ADR). Converting a runtime `&String` value to owned is
# spelled `x.clone` / `x.to_string`, never a literal. This pin RUNS and asserts
# stdout so the model can never silently regress (a regression would break the
# whole swept corpus across the four repos).
#
# Positions covered (OWNED direction): function param, struct/class field,
# static-method arg, Err(...) into Result[T, String], Array[String].push, var
# reassignment + interpolation, function return, heap String dropped at scope
# exit. (BORROW direction): bare literal into a `&String` param, and as the
# borrowed `&String` needle of `include?` — the bare form is the idiom (the
# call site borrows the owned literal; no leading `&` needed).

class Person
  name: String              # field holds an owned String
  def init(n: String)       # param is an owned String
    self.name = n
  end
  def greeting -> String    # return position
    "hi #{self.name}"
  end
end

# static method taking a String arg
def label(s: String) -> String
  s
end

# BORROW direction: a bare (owned `String`) literal satisfies a `&String` param
# at the call site (the call site auto-refs). Write the BARE literal — the bare
# form is the idiom for borrow positions.
def borrow_string(s: &String) -> USize
  s.size
end

# Err(literal) into Result[T, String]. The Ok branch is `Ok(a / b)` (NOT a
# concrete `Ok(1)`) on purpose: that inference order is what exposes the
# `Err("literal")` → `Result[_, String]` payload-coercion gap — without the
# typeck fix, `Err("nope")` builds `Result[Int, &str]` and fails to unify with
# the declared `Result[Int, String]`.
def check(a: Int, b: Int) -> Result[Int, String]
  if b == 0
    Err("nope")
  else
    Ok(a / b)
  end
end

def main
  # param + field (constructor)
  let p = Person.new("Ada")
  puts p.greeting

  # static-method arg + return
  puts label("badge")

  # Array[String].push — a literal lands as a real owned String element.
  # `.get` returns `Option[&String]`; match it out so we print the String
  # content (interpolating the Option wrapper itself would print a pointer).
  var xs: Array[String] = []
  xs.push("one")
  xs.push("two")
  match xs.get(0)
    Some(a) -> puts "#{a}"
    nil     -> puts "none"
  end

  # var reassignment + interpolation
  var msg = "start"
  msg = "now #{label("end")}"
  puts msg

  # Err(literal) into Result[T, String]
  let r = check(1, 0)
  match r
    Ok(n)  -> puts "ok #{n}"
    Err(e) -> puts "err #{e}"
  end

  # borrow direction: bare literal into a &String param (call site auto-refs)
  puts "#{borrow_string("abcd")}"

  # borrowed needle arg: a bare literal coerces to the `&String` needle of
  # `include?` (the idiom — no leading `&` needed)
  let hay = "haystack"
  puts "#{hay.include?("st")}"

  # a heap String local, dropped at scope exit (no leak, no double-free)
  let owned = "scoped"
  puts owned
end
