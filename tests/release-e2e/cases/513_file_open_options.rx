use std.fs.{read_to_string, remove_file}
use std.io.File
use std.io.OpenOptions

def write_msg(f: File)
  match f.write_str("opts")
    Ok(_)  -> puts "wrote_ok"
    Err(_) -> puts "wrote_fail"
  end
end

def main
  let opts = OpenOptions.new().read(true).write(true).create(true)
  match File.open_options("/tmp/ruxen_e2e_513_opts.txt", opts)
    Ok(f)  -> write_msg(f)
    Err(_) -> puts "open_fail"
  end
  match read_to_string("/tmp/ruxen_e2e_513_opts.txt")
    Ok(s)  -> puts "back=#{s}"
    Err(_) -> puts "read_fail"
  end
  remove_file("/tmp/ruxen_e2e_513_opts.txt").expect!("remove")
end
