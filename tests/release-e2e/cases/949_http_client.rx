# Pins std::http's pure response parser + HttpResponse.ok? (no network).
def main
  let resp = "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n\r\n{\"count\":7}"
  puts "status=#{http_response_status(&resp)}"
  puts "body=#{http_response_body(&resp)}"
  let r404 = "HTTP/1.1 404 Not Found\r\n\r\nnope"
  puts "s404=#{http_response_status(&r404)}"
  let hr = HttpResponse.new(200, "hi")
  puts "ok=#{hr.ok?}"
  let hr2 = HttpResponse.new(500, "err")
  puts "ok500=#{hr2.ok?}"
end
