# Pins the B07 combinators whose block returns a COLLECTION or an
# `Option`: `flat_map` / `collect_concat` (concatenate one level deep) and
# `filter_map` (map, dropping the `nil` results). Also pins `find_index`,
# the predicate form of Ruby's index lookup.
#
# `flat_map` additionally pins the codegen fix that goes with this batch:
# it used to sit on the `lang_intrinsics.rs` blocklist of unimplemented Vec
# combinators, which made the emitted `Array_flat_map` body unreachable.
def dup_pair(x: Int) -> Array[Int]
  [x, x * 10]
end

def only_odd(x: Int) -> Int?
  if x % 2 == 1
    x
  else
    nil
  end
end

def main
  let a = [1, 2, 3]

  let fm = a.flat_map { |x| dup_pair(x) }
  puts "flat_map #{fm.size}"
  fm.each { |x| puts "fm #{x}" }

  let cc = a.collect_concat { |x| dup_pair(x) }
  puts "collect_concat #{cc.size}"

  # An empty inner array contributes nothing, so `flat_map` doubles as
  # Ruby's flatten-and-filter idiom.
  let none: Array[Int] = Array.new
  let fe = a.flat_map { |x| none.clone }
  puts "flat_map_empty #{fe.size}"

  let odd = a.filter_map { |x| only_odd(x) }
  puts "filter_map #{odd.size}"
  odd.each { |x| puts "odd #{x}" }

  let hit = a.find_index { |x| x == 3 }
  match hit
    Some(i) -> puts "find_index #{i}"
    nil     -> puts "find_index none"
  end

  let miss = a.find_index { |x| x == 99 }
  match miss
    Some(i) -> puts "miss #{i}"
    nil     -> puts "miss none"
  end
end
