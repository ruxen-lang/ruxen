{
  "name": "ruxen",
  "displayName": "Ruxen",
  "description": "Language support for Ruxen",
  "version": "0.0.1",
  "publisher": "ruxen",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:ruxen"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [{
      "id": "ruxen",
      "aliases": ["Ruxen", "ruxen"],
      "extensions": [".rx"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "ruxen",
      "scopeName": "source.ruxen",
      "path": "./syntaxes/ruxen.tmLanguage.json"
    }],
    "configuration": {
      "title": "Ruxen",
      "properties": {
        "ruxen.server.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the ruxen-lsp binary. If empty, falls back to 'ruxen-lsp' on PATH."
        },
        "ruxen.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace LSP communication with the server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.0"
  }
}
