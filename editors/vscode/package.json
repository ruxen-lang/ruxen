{
  "name": "ruxen",
  "displayName": "Ruxen",
  "description": "Language support for Ruxen — syntax highlighting and LSP (completion, hover, diagnostics, go-to-definition).",
  "version": "0.1.0",
  "publisher": "ruxen",
  "license": "(MIT OR Apache-2.0)",
  "icon": "icon.png",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "keywords": ["ruxen", "rx", "language server", "lsp"],
  "repository": { "type": "git", "url": "https://github.com/ruxen-lang/ruxen.git", "directory": "editors/vscode" },
  "bugs": { "url": "https://github.com/ruxen-lang/ruxen/issues" },
  "homepage": "https://github.com/ruxen-lang/ruxen#readme",
  "activationEvents": ["onLanguage:ruxen"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [{
      "id": "ruxen",
      "aliases": ["Ruxen", "ruxen"],
      "extensions": [".rx"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "ruxen",
      "scopeName": "source.ruxen",
      "path": "./syntaxes/ruxen.tmLanguage.json"
    }],
    "configuration": {
      "title": "Ruxen",
      "properties": {
        "ruxen.server.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the 'ruxen' executable that hosts the language server. If empty, uses 'target/release/ruxen' in the workspace, then 'ruxen' on PATH."
        },
        "ruxen.server.args": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["lsp"],
          "description": "Arguments passed to the server executable. The language server is the 'lsp' subcommand of the 'ruxen' binary, so the default is [\"lsp\"]."
        },
        "ruxen.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace LSP communication with the server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run check-types && node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "package": "vsce package",
    "publish": "vsce publish",
    "publish:openvsx": "ovsx publish"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "ovsx": "^0.10.0",
    "typescript": "^5.3.0"
  }
}
