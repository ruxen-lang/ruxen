{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ruxen",
  "scopeName": "source.ruxen",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#constants" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.number-sign.ruxen", "match": "#.*$" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ruxen",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.ruxen", "match": "\\\\." },
            { "name": "meta.interpolation.ruxen", "begin": "#\\{", "end": "\\}", "patterns": [{ "include": "$self" }] }
          ]
        },
        {
          "name": "string.quoted.single.ruxen",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.ruxen", "match": "\\\\." }]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.ruxen", "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b" },
        { "name": "constant.numeric.hex.ruxen", "match": "\\b0x[0-9a-fA-F_]+\\b" },
        { "name": "constant.numeric.integer.ruxen", "match": "\\b[0-9][0-9_]*\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ruxen",
          "match": "\\b(if|elsif|else|end|match|for|in|while|loop|do|break|continue|return|yield|async|await)\\b"
        },
        {
          "name": "keyword.declaration.ruxen",
          "match": "\\b(let|var|def|init|class|struct|enum|mixin|module|newtype|extension|type|include|exclude|consume|inline|public|private|protected|use|package|unsafe|lib|move|ref|static|const|layout|where|actor|spawn|send|receive)\\b"
        },
        {
          "name": "keyword.operator.word.ruxen",
          "match": "\\b(and|or|not|as|self|Self|super|some|any)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.ruxen", "match": "\\b(true|false|nil|Some|Ok|Err)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "storage.type.ruxen", "match": "\\b(Int|Float|Bool|String|Char|Array|Map|Set|Option|Result|Box|Shared|SharedSync)\\b" },
        { "name": "entity.name.type.ruxen", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.definition.ruxen",
          "match": "\\b(def)\\s+([a-z_][A-Za-z0-9_]*[!?]?)",
          "captures": {
            "1": { "name": "keyword.declaration.ruxen" },
            "2": { "name": "entity.name.function.ruxen" }
          }
        },
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*[!?]?)\\s*\\(",
          "captures": { "1": { "name": "entity.name.function.call.ruxen" } }
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.ruxen", "match": "(==|!=|<=|>=|<|>|\\+|-|\\*|/|%|=|&&|\\|\\||!|\\?\\.|::|->|=>)" }
      ]
    }
  }
}
