# Wave 1.5 (#06.8 Phase 3) proof-of-life stdlib file.
#
# This is the FIRST file ever pulled in by the bootstrap loader. Its
# sole job is to prove the parse → merge → resolve → MIR → link
# pipeline works end-to-end with a tiny payload. The aliased symbol
# `riven_test_extern_add_one` lives in `library/runtime/test_extern.c`
# (it was already linked into the runtime `.o` for Phase 2's link
# smoke test), so this file imposes no new linkage on production
# binaries.
#
# DO NOT rely on `bootstrap_smoke_add_one` outside of bootstrap tests.
# Wave 2 will replace this file with real stdlib modules.

lib "../core/runtime/test_extern.c"
  def bootstrap_smoke_add_one as "riven_test_extern_add_one"(x: Int) -> Int
end

# Wave 1.5 (#06.8 Phase 4) full-surface proof. Bootstrap-loaded
# classes now register their class-method FFI decls into the prelude
# scope exactly like user-written classes do. A user program can
# call `BootstrapSmokeClass.add_one(41)` and the linker will resolve
# the underlying `riven_test_extern_add_one` C symbol from
# `library/runtime/test_extern.c`.
class BootstrapSmokeClass
  lib "../core/runtime/test_extern.c"
    def self.add_one as "riven_test_extern_add_one"(x: Int) -> Int
    def self.double as "riven_test_extern_double"(x: Int) -> Int
  end
end
