## std::path — POSIX path manipulation, Linux-style forward-slash
## separators only. Windows backslash support is a non-goal for v1.
##
## Wave 2 (#06.8) — migrated from resolve/stdlib/mod.rs Rust
## registrations into self-hosted library/std/src/path.rvn.
##
## See docs/specs/stdlib/path.spec.md for the behavioural contract.
## The runtime C implementations live in library/runtime/fs.c (paired
## with the fs surface — same translation unit, no separate
## `path.c`).

lib "riven_runtime"
  def path_join as "riven_path_join"(a: &String, b: &String) -> String
  def path_parent as "riven_path_parent"(path: &String) -> String
  def path_file_name as "riven_path_file_name"(path: &String) -> String
  def path_extension as "riven_path_extension"(path: &String) -> String
  def path_is_absolute as "riven_path_is_absolute"(path: &String) -> Bool
end
