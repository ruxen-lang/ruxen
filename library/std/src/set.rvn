## std::set — Set (formerly `HashSet`) method surface.
##
## #06.8 T#16: every method here was a `Set[T]_<m>` / `HashSet[T]_<m>`
## entry in the `name.starts_with("Set[") || ...` arm of
## `compiler/riven_core/src/codegen/runtime_table/mod.rs` until T#14's
## anchor-extension. Same shape as the Map migration: `Set` is NOT in
## type-scope (`resolve_type_expr` builds `Ty::Set(_)` from a
## hardcoded arm); the anchor branch creates a parent DefId for FFI
## bookkeeping without touching type-scope.
##
## Runtime C symbols carry the original `riven_set_*` prefix; the
## `Lowerer::resolve_ffi_alias_callee` fallback handles both `Set.new`
## (surface) and `HashSet.new` (legacy value-scope alias) by retrying
## the lookup with the base_type-mangled key after the runtime_base
## form misses.

class Set
  lib "riven_runtime"
    # ── Constructors (no `self`) ──────────────────────────────────
    def self.new as "riven_set_new"() -> Int
    def self.with_capacity as "riven_set_with_capacity"(cap: Int) -> Int
    def self.from_iter as "riven_set_from_iter"(items: Int) -> Int

    # ── Read-only queries ─────────────────────────────────────────
    def len as "riven_set_len"(self) -> Int
    def is_empty as "riven_set_is_empty"(self) -> Bool
    def contains as "riven_set_contains"(self, item: Int) -> Bool
    def iter as "riven_set_iter"(self) -> Int

    # ── Set algebra ───────────────────────────────────────────────
    def union as "riven_set_union"(self, other: Int) -> Int
    def intersection as "riven_set_intersection"(self, other: Int) -> Int
    def difference as "riven_set_difference"(self, other: Int) -> Int

    # ── Mutating ops ──────────────────────────────────────────────
    def insert as "riven_set_insert"(self, item: Int)
    def remove as "riven_set_remove"(self, item: Int) -> Bool
    def clear as "riven_set_clear"(self)
  end
end
