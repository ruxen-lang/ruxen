## std::env — process environment access.
##
## Wave 2 (#06.8) — migrated from resolve/stdlib/mod.rs Rust
## registrations into self-hosted library/std/src/env.rvn.
##
## ruby-naming.spec.md §3.14: `var` is a reserved keyword, so the
## var-read fn is spelled `env.get` (consistent with the rest of the
## stdlib's collection-lookup verb). The internal C symbol keeps its
## legacy `riven_env_var` name.
##
## `vars` snapshots the process environment at call time; mutations
## after the call do not propagate into the returned map.

lib "riven_runtime"
  def args as "riven_env_args"() -> Array[String]
  def get as "riven_env_var"(name: &String) -> Result[String, IoError]
  def vars as "riven_env_vars"() -> Map[String, String]
  def current_dir as "riven_env_current_dir"() -> Result[String, IoError]
end
