## std::net — TcpListener / TcpStream class lib-decl surface + Shutdown enum.
##
## Phase E-rest 2 of #06.95 migrated most TcpListener / TcpStream
## methods from `codegen/runtime_table/mod.rs` arms into class-body
## lib decls. The FFI alias map populated by `as "..."` clauses
## rewrites the MIR-mangled callee (`TcpListener_bind` →
## `riven_tcp_listener_bind`) BEFORE codegen consults runtime_table.
##
## Three method surfaces stay on runtime_table dispatch for now:
##   - `TcpStream.set_read_timeout(&Duration)` /
##     `.set_write_timeout(&Duration)` — Duration is declared in
##     `library/std/time/src/lib.rvn`, which loads AFTER net.rvn in
##     BOOTSTRAP_FILES. Forward-referencing Duration here fails at
##     net.rvn parse time. Migrating needs Duration to land in a
##     package that loads before net, or net to load after time
##     (which would break time-uses-no-net).
##   - `TcpListener.set_nonblocking(Bool)` — the C runtime takes
##     `int8_t` for the Bool arg; the cranelift verifier rejects
##     the typed Bool→int8_t coercion through the FFI alias path.
##     Same OpenOptions setter ABI mismatch.
##
## The Shutdown variant order is the load-bearing contract: tag
## indices must match `RIVEN_SHUTDOWN_{READ,WRITE,BOTH}` in
## `library/std/net/runtime/tcp.c`. The `shutdown_tag_stability`
## pin test scans this file.

# Shutdown declared FIRST so TcpStream.shutdown's `how: Shutdown`
# param type resolves at net.rvn parse time.
enum Shutdown
  Read
  Write
  Both
end

## std::net::TcpStream — owning wrapper around a connected POSIX fd.
## Declared BEFORE TcpListener so TcpListener.accept's `-> Result[
## TcpStream, IoError]` return type resolves at parse time.
class TcpStream
  lib "runtime/tcp.c"
    def self.connect as "riven_tcp_stream_connect"(addr: &String) -> Result[TcpStream, IoError]
    def read as "riven_tcp_stream_read"(self, buf: &var Array[Int]) -> Result[Int, IoError]
    def write as "riven_tcp_stream_write"(self, bytes: &Array[Int]) -> Result[Int, IoError]
    def peer_addr as "riven_tcp_stream_peer_addr"(self) -> Result[String, IoError]
    def shutdown as "riven_tcp_stream_shutdown"(self, how: Shutdown) -> Result[(), IoError]
    def close as "riven_tcp_stream_close"(self) -> Result[(), IoError]
    def drop as "riven_tcp_stream_drop"(self) -> ()
  end
end

## std::net::TcpListener — owning wrapper around a listening POSIX
## fd. The `def drop` lib decl drives user_drop_classes auto-detect.
class TcpListener
  lib "runtime/tcp.c"
    def self.bind as "riven_tcp_listener_bind"(addr: &String) -> Result[TcpListener, IoError]
    def accept as "riven_tcp_listener_accept"(self) -> Result[TcpStream, IoError]
    def local_addr as "riven_tcp_listener_local_addr"(self) -> Result[String, IoError]
    def close as "riven_tcp_listener_close"(self) -> Result[(), IoError]
    def drop as "riven_tcp_listener_drop"(self) -> ()
  end
end
