## --- AsyncWriteAllFuture (B6) --------------------------------------
##
## Writes the entire `content` to `fd`, looping on EAGAIN with reactor
## registration for write-readiness. Returns Ok(()) once flushed,
## Err(IoError) on hard failure.
class AsyncWriteAllFuture
  state_ptr: Int
  handle: Int
  done: Int
  include Future
  type Output = Result[(), IoError]

  def init(fd: Int, content: &String)
    self.state_ptr = riven_async_write_state_new(fd, content)
    self.handle = 0
    self.done = 0
  end

  def var poll(cx: &var Context) -> Poll[Result[(), IoError]]
    if self.done != 0
      return Poll.Ready(riven_async_write_state_take_result(self.state_ptr))
    end
    let step = riven_async_write_step(self.state_ptr)
    if step == 1
      if self.handle == 0
        let fd = riven_async_write_state_get_fd(self.state_ptr)
        self.handle = riven_reactor_register_fd_write(riven_reactor_current_handle(), fd)
      end
      return Poll.Pending
    end
    if self.handle != 0
      riven_reactor_deregister(riven_reactor_current_handle(), self.handle)
      self.handle = 0
    end
    self.done = 1
    Poll.Ready(riven_async_write_state_take_result(self.state_ptr))
  end

  def drop
    if self.handle != 0
      riven_reactor_deregister(riven_reactor_current_handle(), self.handle)
      self.handle = 0
    end
    if self.state_ptr != 0
      riven_async_write_state_free(self.state_ptr)
      self.state_ptr = 0
    end
  end
end
