## --- AsyncWriteAllFuture (B6) --------------------------------------
##
## Writes the entire `content` to `fd`, looping on EAGAIN with reactor
## registration for write-readiness. Returns Ok(()) once flushed,
## Err(IoError) on hard failure.
class AsyncWriteAllFuture
  state_ptr: Int
  handle: Int
  done: Int

  def init(fd: Int, content: &String)
    self.state_ptr = ruxen_async_write_state_new(fd, content)
    self.handle = 0
    self.done = 0
  end

  def var poll(cx: &var Context) -> Poll[Result[(), IoError]]
    if self.done != 0
      return Poll.Ready(ruxen_async_write_state_take_result(self.state_ptr))
    end
    let step = ruxen_async_write_step(self.state_ptr)
    if step == 1
      if self.handle == 0
        let fd = ruxen_async_write_state_get_fd(self.state_ptr)
        self.handle = ruxen_reactor_register_fd_write(ruxen_reactor_current_handle, fd)
      end
      let w = cx.waker
      ruxen_reactor_set_waker(ruxen_reactor_current_handle, self.handle, w)
      return Poll.Pending
    end
    if self.handle != 0
      ruxen_reactor_deregister(ruxen_reactor_current_handle, self.handle)
      self.handle = 0
    end
    self.done = 1
    Poll.Ready(ruxen_async_write_state_take_result(self.state_ptr))
  end

  def drop
    if self.handle != 0
      ruxen_reactor_deregister(ruxen_reactor_current_handle, self.handle)
      self.handle = 0
    end
    if self.state_ptr != 0
      ruxen_async_write_state_free(self.state_ptr)
      self.state_ptr = 0
    end
  end

  include Future
end
