## --- AsyncWriteAllFuture (B6) --------------------------------------
##
## Writes the entire `content` to `fd`, looping on EAGAIN with reactor
## registration for write-readiness. Returns Ok(nil) once flushed,
## Err(IoError) on hard failure.
class AsyncWriteAllFuture
  state_ptr: Int
  handle: Int
  done: Int
  include Future
  type Output = Result[nil, IoError]

  def init(fd: Int, content: &String)
    self.state_ptr = ruxen_async_write_state_new(fd, content)
    self.handle = 0
    self.done = 0
  end

  def var poll(cx: &var Context) -> Poll[Result[nil, IoError]]
    if self.done == 0
      if ruxen_async_write_step(self.state_ptr) == 1
        let fd = ruxen_async_write_state_get_fd(self.state_ptr)
        self.handle = StepFuture.park_fd(cx, self.handle, fd, true)
        return Poll.Pending
      end
      self.handle = StepFuture.release(self.handle)
      self.done = 1
    end
    Poll.Ready(ruxen_async_write_state_take_result(self.state_ptr))
  end

  def drop
    self.handle = StepFuture.release(self.handle)
    if self.state_ptr != 0
      ruxen_async_write_state_free(self.state_ptr)
      self.state_ptr = 0
    end
  end
end
