## TaskHandle namespace class for static-method handle ops. Same
## pattern as `JoinHandle` in library/std/sync — handle is held as
## `Int` at the user surface; ops are static methods that take the
## raw handle. v1 surface:
##   TaskHandle.is_done(h)  -> Int (1 if ready, 0 if pending)
##   TaskHandle.result(h)   -> Int (valid only when is_done returns 1)
##   TaskHandle.drop_handle(h) -> ()  (releases caller-side refcount)
##
## `drop_handle` is named explicitly (not `drop`) because Ruxen's
## `def drop` discipline reserves that name for class-instance drop
## hooks. Here we're acting on a raw Int handle — closer to a free
## function in spirit. Match the JoinHandle.join_raw shape.
class TaskHandle
  lib "runtime/scheduler.c"
    def self.is_done as "ruxen_task_handle_is_done"(h: Int) -> Int
    def self.result as "ruxen_task_handle_result"(h: Int) -> Int
    def self.drop_handle as "ruxen_task_handle_drop"(h: Int) -> ()
  end
end

## Scheduler internal entries. These exist as module-level lib decls
## so the AST-level block_on rewriter can synthesise calls to them
## via a plain `Identifier(...)` reference (matches how Thread.yield_now
## gets emitted from the Pending arm today).
##
## `ruxen_executor_pump_tasks` is called by the block_on inline loop
## once per iteration when the queue is non-empty (cheap: a single
## thread-local pointer compare via `ruxen_executor_queue_nonempty`).
## `ruxen_executor_drain_remaining` would be called by Context.drop —
## but plumbing through Context.drop requires a follow-up commit; v1
## ships with the leak-on-block_on-exit behaviour acknowledged in
## scheduler.c's header. Tasks that complete cleanly via the pump
## free themselves; only abandoned tasks leak.
lib "runtime/scheduler.c"
  def ruxen_executor_pump_tasks -> Int
  def ruxen_executor_queue_nonempty -> Int
  def ruxen_executor_ready_nonempty -> Int
  def ruxen_executor_drain_remaining -> ()
end
