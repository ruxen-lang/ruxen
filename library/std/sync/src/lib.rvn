## std::sync — thread / Mutex / SharedSync surface (partial).
##
## Wave 2 (#06.8) — 9 class shells migrated from Rust registrations
## (Thread, ThreadId, JoinHandle[T: Send], Mutex[T], MutexGuard[T],
## SharedSync[T], PoisonError, ThreadPanic, plus Context / Waker
## from std::task). Methods on every shell still flow through the
## runtime_table mangled-name dispatch until T#21 lands.
##
## Phase D-2 of #06.95 deleted the Rust-side `Arc[T]` backward-compat
## alias entirely — `SharedSync[T]` is the only canonical name
## (TEC-13 / §10a) and Arc has no remaining call sites in the tree.
## The Rust-side `ThreadId` value-scope shim was also deleted;
## fixtures only use `ThreadId` as a type, never as a sentinel
## value, so the `class ThreadId end` bootstrap-loaded registration
## below is the complete surface.
##
## Context / Waker belong to std::task (async runtime plumbing) but
## live here in `sync.rvn` for now because the standalone task.rvn
## module hasn't been split out — they are still indexed under
## `std.sync.{Context, Waker}` per the legacy registration.

class Context
end

class Waker
end

class Thread
  ## Phase C of #06.95 absorbed the Rust-side `sleep(&Duration)` free
  ## fn into `Thread.sleep` — the duration-typed counterpart to the
  ## bare-int `Thread.sleep_ns` still served by runtime_table.
  ## Phase E Slice B.4 added `yield_now` (no-arg cooperative yield);
  ## the runtime_table `Thread_yield_now -> riven_thread_yield`
  ## entry was deleted at the same commit.
  ##
  ## `Thread.sleep(Int)` — the bare-int convenience overload that
  ## maps to `riven_thread_sleep_ns` — stays in runtime_table for
  ## now. typeck's method_resolver returns `Ty::Unit` for both
  ## `Thread.sleep(&Duration)` and `Thread.sleep(Int)`, so adding
  ## a second `def self.sleep as "riven_thread_sleep_ns"(ns: Int)`
  ## lib decl here would create two FFI aliases keyed on the same
  ## `Thread_sleep` mangled name — runtime_table's existing entry
  ## for the Int form is the cleanest disambiguation point until
  ## the lib-decl grammar grows parameter-type-keyed dispatch.
  lib "runtime/time.c"
    def self.sleep as "riven_thread_sleep_duration"(d: &Duration) -> ()
    def self.yield_now as "riven_thread_yield"() -> ()
  end

  ## Multithreading round — Thread.spawn / current_id runtime.
  ## Both surfaces declared at the i64 ABI; the Riven-level type
  ## wrappers (`Thread.spawn` returning `JoinHandle[T]`) are layered
  ## on top via the same generic-stripping pattern that Array uses
  ## (see library/std/array/src/lib.rvn).
  lib "runtime/thread.c"
    def self.current_id as "riven_thread_current_id"() -> Int
    def self.spawn_raw as "riven_thread_spawn"(closure: Int) -> Int
  end
end

## Thread.spawn free-fn shim. Declared at module scope (not inside
## the class) historically because static-method dispatch through
## `Thread.spawn` was prepending an implicit self arg, breaking the
## FFI signature. That bug has since been fixed (see commit
## 153e5c9 — module+mixin reshape touched the same dispatch path).
## Kept here for backward-compat with existing callers; new code
## should prefer `Thread.spawn_raw(closure)`.
lib "runtime/thread.c"
  def thread_spawn_raw as "riven_thread_spawn"(closure: Int) -> Int
end

## Signal namespace class — absorbs the Rust-side
## `signal_install_sigint` / `signal_received_sigint` free fns into
## `Signal.install_sigint` / `Signal.received_sigint` static methods.
## Phase C of #06.95.
class Signal
  lib "runtime/signal.c"
    def self.install_sigint as "riven_signal_install_sigint"() -> ()
    def self.received_sigint as "riven_signal_received_sigint"() -> Int
  end
end

# Phase D transition shims for the three Rust-side free fns deleted
# from `compiler/riven_core/src/resolve/stdlib/mod.rs`. Existing
# fixtures call `sleep(d)` / `signal_install_sigint()` /
# `signal_received_sigint()` via `use std.thread.sleep` etc.; these
# bare entries keep them resolving until a follow-up sweep migrates
# call sites to `Thread.sleep` / `Signal.install_sigint` / …
lib "runtime/time.c"
  def sleep as "riven_thread_sleep_duration"(d: &Duration) -> ()
end

lib "runtime/signal.c"
  def signal_install_sigint as "riven_signal_install_sigint"() -> ()
  def signal_received_sigint as "riven_signal_received_sigint"() -> Int
end

class ThreadId
end

## Typed FFI return surface (docs/specs/types/typed_ffi_returns.spec.md).
## `join_raw` reports the closure's actual `T` return type. The
## codegen still treats the value as i64 at the C ABI; only the
## typeck-reported surface type changes.
class JoinHandle[T: Send]
  lib "runtime/thread.c"
    def join_raw as "riven_thread_join"(self) -> T
    def __drop as "riven_thread_join_handle_drop"(self) -> ()
  end
end

## Typed FFI return surface (docs/specs/types/typed_ffi_returns.spec.md).
## `def self.new` declares `-> Mutex[T]`; the codegen still treats the
## return value as i64 at the C ABI (see `ty_to_cranelift`), so
## `riven_mutex_new(int64_t initial)` is called unchanged. Per B1+B3
## of the spec, T is bound from the constructor's first arg type;
## `Mutex.new(7)` reports `Mutex[Int]` at the let-binding site.
class Mutex[T]
  lib "runtime/mutex.c"
    def self.new as "riven_mutex_new"(initial: T) -> Mutex[T]
    def lock_raw as "riven_mutex_lock"(self) -> MutexGuard[T]
    def try_lock_raw as "riven_mutex_try_lock"(self) -> MutexGuard[T]
    def is_poisoned as "riven_mutex_is_poisoned"(self) -> Int
    def clear_poison as "riven_mutex_clear_poison"(self) -> ()
    def into_inner_raw as "riven_mutex_into_inner"(self) -> T
    def __drop as "riven_mutex_drop"(self) -> ()
  end
end

class MutexGuard[T]
  lib "runtime/mutex.c"
    def get as "riven_mutex_guard_get"(self) -> T
    def set as "riven_mutex_guard_set"(self, value: T) -> ()
    def __drop as "riven_mutex_guard_drop"(self) -> ()
  end
end

## Typed FFI return surface (docs/specs/types/typed_ffi_returns.spec.md).
## All non-Int-shaped returns lifted: `.new` -> SharedSync[T] with T
## inferred from the constructor's first arg (B1+B3); `.clone` ->
## SharedSync[T] (B5: Self in return); `.get` -> T (B4).
class SharedSync[T]
  lib "runtime/sharedsync.c"
    def self.new as "riven_sharedsync_new"(initial: T) -> SharedSync[T]
    def clone as "riven_sharedsync_clone"(self) -> SharedSync[T]
    def strong_count as "riven_sharedsync_strong_count"(self) -> Int
    def get as "riven_sharedsync_get"(self) -> T
    def __drop as "riven_sharedsync_drop"(self) -> ()
  end
end

class PoisonError
end

class ThreadPanic
end

## Atomic primitives — sequentially consistent.
##
## Typed FFI return surface (docs/specs/types/typed_ffi_returns.spec.md).
## These classes are non-generic, so spec B10 says their `.new` does NOT
## auto-lift. We declare each constructor's return type explicitly so
## the chain `AtomicI64.new(0).load` typechecks (without the explicit
## declaration, `.new` would report `Int` per the lib decl and `.load`
## would error with "no field on Int"). The `load`/`fetch_*` methods
## are declared raw `Int` because the underlying value is i64 — there
## is no `T` to recover.
class AtomicI64
  lib "runtime/atomic.c"
    def self.new as "riven_atomic_i64_new"(initial: Int) -> AtomicI64
    def load as "riven_atomic_i64_load"(self) -> Int
    def store as "riven_atomic_i64_store"(self, value: Int) -> ()
    def fetch_add as "riven_atomic_i64_fetch_add"(self, delta: Int) -> Int
    def fetch_sub as "riven_atomic_i64_fetch_sub"(self, delta: Int) -> Int
    def compare_and_swap as "riven_atomic_i64_compare_and_swap"(self, current: Int, new_val: Int) -> Int
    def __drop as "riven_atomic_i64_drop"(self) -> ()
  end
end

## Param/return types kept as Int to preserve the existing wire
## ABI (riven_atomic_bool_* takes/returns int64_t). Only `.new`'s
## return is lifted so the chain `AtomicBool.new(0).load` reports
## a sensible class type at the let-binding.
class AtomicBool
  lib "runtime/atomic.c"
    def self.new as "riven_atomic_bool_new"(initial: Int) -> AtomicBool
    def load as "riven_atomic_bool_load"(self) -> Int
    def store as "riven_atomic_bool_store"(self, value: Int) -> ()
    def fetch_and as "riven_atomic_bool_fetch_and"(self, value: Int) -> Int
    def fetch_or as "riven_atomic_bool_fetch_or"(self, value: Int) -> Int
    def compare_and_swap as "riven_atomic_bool_compare_and_swap"(self, current: Int, new_val: Int) -> Int
    def __drop as "riven_atomic_bool_drop"(self) -> ()
  end
end

class AtomicUsize
  lib "runtime/atomic.c"
    def self.new as "riven_atomic_usize_new"(initial: Int) -> AtomicUsize
    def load as "riven_atomic_usize_load"(self) -> Int
    def store as "riven_atomic_usize_store"(self, value: Int) -> ()
    def fetch_add as "riven_atomic_usize_fetch_add"(self, delta: Int) -> Int
    def fetch_sub as "riven_atomic_usize_fetch_sub"(self, delta: Int) -> Int
    def compare_and_swap as "riven_atomic_usize_compare_and_swap"(self, current: Int, new_val: Int) -> Int
    def __drop as "riven_atomic_usize_drop"(self) -> ()
  end
end

## MPSC channel — multi-producer single-consumer unbounded queue.
##
## Typed FFI return surface (docs/specs/types/typed_ffi_returns.spec.md).
## `Sender[T].clone` reports `Sender[T]` (B5); `Receiver[T].recv_raw`
## reports `T` (B4 — the item type). `send_raw`'s return stays raw
## `Int` because it carries a success/error code, not a typed value.
class Sender[T: Send]
  lib "runtime/channel.c"
    def send_raw as "riven_channel_send"(self, value: T) -> Int
    def clone as "riven_channel_sender_clone"(self) -> Sender[T]
    def __drop as "riven_channel_sender_drop"(self) -> ()
  end
end

class Receiver[T: Send]
  lib "runtime/channel.c"
    def recv_raw as "riven_channel_recv"(self) -> T
    def try_recv_raw as "riven_channel_try_recv"(self) -> T
    def __drop as "riven_channel_receiver_drop"(self) -> ()
  end
end

class SendError
end

class RecvError
end
