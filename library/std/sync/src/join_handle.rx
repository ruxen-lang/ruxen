## Typed FFI return surface (docs/specs/types/typed_ffi_returns.spec.md).
## `join_raw` reports the closure's actual `T` return type. The
## codegen still treats the value as i64 at the C ABI; only the
## typeck-reported surface type changes.
class JoinHandle[T: Send]
  include Send

  include Sync

  lib "runtime/thread.c"
    def self.spawn_closure as "ruxen_thread_spawn"(closure: any Fn[Fn() -> T]) -> JoinHandle[T]
    def join_raw as "ruxen_thread_join" -> T
    def thread_id_raw as "ruxen_thread_join_handle_id" -> Int
    def drop as "ruxen_thread_join_handle_drop" -> nil
  end

  ## Wait for the thread and return its value. A panic inside the thread
  ## aborts the whole process (there is no unwinding yet), so a join that
  ## returns always carries `Ok`.
  def join -> Result[T, ThreadPanic]
    Ok(self.join_raw)
  end

  ## Wait for the thread and return its value (the `!` form of `join`).
  def join! -> T
    self.join_raw
  end

  ## The id of the spawned thread.
  def thread_id -> ThreadId
    ThreadId.new(self.thread_id_raw)
  end
end
