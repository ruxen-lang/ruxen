## Typed FFI return surface (docs/specs/types/typed_ffi_returns.spec.md).
## All non-Int-shaped returns lifted: `.new` -> SharedSync[T] with T
## inferred from the constructor's first arg (B1+B3); `.clone` ->
## SharedSync[T] (B5: Self in return); `.get` -> T (B4).
class SharedSync[T]
  include Send
  include Sync

  lib "runtime/sharedsync.c"
    def self.new as "riven_sharedsync_new"(initial: T) -> SharedSync[T]
    def clone as "riven_sharedsync_clone"(self) -> SharedSync[T]
    def strong_count as "riven_sharedsync_strong_count"(self) -> Int
    def get as "riven_sharedsync_get"(self) -> T
    def drop as "riven_sharedsync_drop"(self) -> ()
  end
end
