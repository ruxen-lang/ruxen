## Signal namespace class — absorbs the Rust-side
## `signal_install_sigint` / `signal_received_sigint` free fns into
## `Signal.install_sigint` / `Signal.received_sigint` static methods.
## Phase C of #06.95.
class Signal
  lib "runtime/signal.c"
    def self.install_sigint as "ruxen_signal_install_sigint" -> ()
    def self.received_sigint as "ruxen_signal_received_sigint" -> Int
  end
end

# Phase D transition shim for `signal_install_sigint` /
# `signal_received_sigint` — bare module-scope free-fn lib decls kept
# for back-compat. The `def sleep` shim that used to live here was
# deleted during the sub-phase 4A async-naming sweep (commit history
# around `Async.sleep` introduction); call sites use `Thread.sleep`
# (sync) or `Async.sleep` (async, returns TimeSleepFuture).
lib "runtime/signal.c"
  def signal_install_sigint as "ruxen_signal_install_sigint" -> ()
  def signal_received_sigint as "ruxen_signal_received_sigint" -> Int
end
