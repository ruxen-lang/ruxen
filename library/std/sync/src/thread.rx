class Thread
  id_raw: Int

  def init(id_raw: Int)
    self.id_raw = id_raw
  end

  lib "runtime/time.c"
    def self.sleep as "ruxen_thread_sleep_duration"(d: &Duration) -> nil
    def self.yield_now as "ruxen_thread_yield" -> nil
  end

  lib "runtime/thread.c"
    def self.current_id as "ruxen_thread_current_id" -> Int
    def self.spawn_raw as "ruxen_thread_spawn"(closure: Int) -> Int
  end

  ## Run `f` on a new OS thread and return a handle to join it. Every value
  ## the closure captures must be `Send` (E1100).
  def self.spawn[T](f: any Fn[Fn() -> T] + Send) -> JoinHandle[T]
    JoinHandle.spawn_closure(f)
  end

  ## The thread this code is running on.
  def self.current -> Thread
    Thread.new(Thread.current_id)
  end

  ## This thread's id.
  def id -> ThreadId
    ThreadId.new(self.id_raw)
  end

  ## Threads are unnamed (`Thread.spawn` takes no name), so this is `nil`.
  def name -> Option[String]
    nil
  end
end

## Phase C of #06.95 absorbed the Rust-side `sleep(&Duration)` free
## fn into `Thread.sleep` — the duration-typed counterpart to the
## bare-int `Thread.sleep_ns` still served by runtime_table.
## Phase E Slice B.4 added `yield_now` (no-arg cooperative yield);
## the runtime_table `Thread_yield_now -> ruxen_thread_yield`
## entry was deleted at the same commit.
##
## `Thread.sleep(Int)` — the bare-int convenience overload that
## maps to `ruxen_thread_sleep_ns` — stays in runtime_table for
## now. Adding a second `def self.sleep as "ruxen_thread_sleep_ns"(ns: Int)`
## lib decl here would create two FFI aliases keyed on the same
## `Thread_sleep` mangled name — runtime_table's existing entry
## for the Int form is the cleanest disambiguation point until
## the lib-decl grammar grows parameter-type-keyed dispatch.
## `Thread.spawn(closure)` — the high-level surface a Rubyist
## reaches for first. It is a `.rx` body over
## `JoinHandle.spawn_closure`, the same `ruxen_thread_spawn` entry
## point `spawn_raw` uses; the typed `JoinHandle[T]` comes from the
## typed-FFI return mechanism
## (docs/specs/types/typed_ffi_returns.spec.md). The `+ Send` on its
## closure parameter makes typeck check every capture (E1100).
# Accept-loop shape:
#
#   loop
#     match listener.accept
#       Ok(stream) -> Thread.spawn({ || handle(stream) })
#       Err(_)     -> break
#     end
#   end
## Thread.spawn free-fn shim. Declared at module scope (not inside
## the class) historically because static-method dispatch through
## `Thread.spawn` was prepending an implicit self arg, breaking the
## FFI signature. That bug has since been fixed (see commit
## 153e5c9 — module+mixin reshape touched the same dispatch path).
## Kept here for backward-compat with existing callers; new code
## should prefer `Thread.spawn_raw(closure)`.
lib "runtime/thread.c"
  def thread_spawn_raw as "ruxen_thread_spawn"(closure: Int) -> Int
end
