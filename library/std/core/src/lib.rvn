## std::core — primitive trait declarations shared by every stdlib
## package. Phase D-3 of #06.95 moved these from Rust registrations
## in resolve/stdlib/mod.rs into self-hosted .rvn.
##
## Each declaration preserves the EXACT required-method list the
## Rust registration carried; aspirational broader surfaces are
## intentionally left out — adding required methods today would
## break every user impl that doesn't provide them. They'll
## expand once default-method lowering for mixins ships.

mixin Displayable
  def to_display
end

mixin Error
  def message
end

mixin Comparable
  def compare
end

# Marker mixins (no required methods).
mixin Iterable
end

mixin Copy
end

mixin Send
end

mixin Sync
end

mixin Clone
  def clone
end

mixin PartialEq
  def eq
end

mixin Eq
end

# `Hash` here is the historic trait NAME (one method `hash`). The
# Ruby-naming canonical name is `Hashable` (in library/std/hash/);
# the `Hash → Hashable` alias is re-established by the resolver's
# TYPE_ALIASES table after bootstrap merge.
mixin Hash
  def hash
end

mixin Default
  def default
end

mixin Ord
  def cmp
end

mixin PartialOrd
  def partial_cmp
end

mixin Drop
  def drop
end

# Future — async-runtime polling surface. Moved to
# `library/std/future/src/lib.rvn` by async sub-phase 1 (see
# docs/specs/stdlib/async.spec.md B1 + B10), along with the
# associated `Poll[T]` enum and `Context` / `Waker` class shells.
# Co-locating the four keeps the cross-references between
# Future's `def poll(cx: &var Context) -> Poll[Self.Output]`
# signature and Context/Poll inside a single bootstrap file.

# Into[T] — generic conversion mixin used by `?` to coerce source
# errors into the outer function's declared error type. The MIR
# `try_op` lowering looks up `into_impls[(Src, Dst)]` (populated by
# `include Into[Dst]` blocks in `collect.rs`) and emits a call to
# `{Src}_into`. See docs/tutorial/11-error-handling.md.
mixin Into[T]
  def into
end
