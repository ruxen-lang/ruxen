Tester.describe("Base64") do |t: &var Tester|
  t.it("encodes known vectors") do
    t.expect(Base64.strict_encode64(&"Man")).to_eq("TWFu")
    t.expect(Base64.strict_encode64(&"hello")).to_eq("aGVsbG8=")
    t.expect(Base64.urlsafe_encode64(&"hello")).to_eq("aGVsbG8=")
  end

  t.it("decodes what it encodes") do
    t.expect(Base64.strict_decode64(&"aGVsbG8=")).to_eq("hello")
    t.expect(Base64.strict_decode64(&Base64.strict_encode64(&"round trip!"))).to_eq("round trip!")
  end
end
