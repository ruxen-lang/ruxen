Tester.describe("Array mutation") do |t: &var Tester|
  t.it("push and pop, with pop on empty returning nil") do
    var v: Array[Int] = Array.new
    t.expect(v.pop.unwrap_or(-1)).to_eq(-1)
    v.push(1)
    v.push(2)
    v.push(3)
    t.expect(v.size).to_eq(3)
    t.expect(v.pop.unwrap_or(-1)).to_eq(3)
    t.expect(v.size).to_eq(2)
  end

  t.it("with_capacity reserves room") do
    var v: Array[Int] = Array.with_capacity(8)
    v.push(1)
    v.push(2)
    v.push(3)
    t.expect(v.size).to_eq(3)
    t.expect(v.capacity >= 3).to_eq(true)
  end

  t.it("truncate and clear") do
    var v = [10, 20, 30, 40]
    v.truncate(2)
    t.expect(v.size).to_eq(2)
    v.clear
    t.expect(v.size).to_eq(0)
    t.expect(v.empty?).to_eq(true)
  end

  t.it("swap, insert and remove") do
    var v = [1, 2, 3, 4]
    v.swap(0, 3)
    t.expect(v.join(",")).to_eq("4,2,3,1")
    var w = [1, 3, 4]
    w.insert(1, 2)
    t.expect(w.join(",")).to_eq("1,2,3,4")
    let removed = w.remove(0)
    t.expect(removed).to_eq(1)
    t.expect(w.join(",")).to_eq("2,3,4")
  end

  t.it("extend appends another array") do
    var a = [1, 2]
    let b = [3, 4]
    a.extend(&b)
    t.expect(a.join(",")).to_eq("1,2,3,4")
  end

  t.it("reverse reverses in place") do
    var v = [1, 2, 3]
    v.reverse
    t.expect(v.join(",")).to_eq("3,2,1")
  end

  t.it("clone is independent of the original") do
    let v = [1, 2, 3]
    var copy = v.clone
    copy.push(4)
    t.expect(v.count).to_eq(3)
    t.expect(copy.count).to_eq(4)
  end

  t.it("dedup drops consecutive duplicates only") do
    var v = [1, 1, 2, 2, 2, 3, 1]
    v.dedup
    t.expect(v.join(",")).to_eq("1,2,3,1")
  end

  t.it("select! keeps matching elements") do
    var v = [1, 2, 3, 4, 5]
    v.select! { |x| x > 2 }
    t.expect(v.join(",")).to_eq("3,4,5")
  end
end
