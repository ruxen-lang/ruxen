## std.test.Tester — one group in the spec tree.
##
## A Tester is created by `Tester.describe` and passed (by mutable
## reference) to the user's block. Nested `context` calls create child
## Testers inheriting the parent's before-hook chain. Cases (`it`) execute
## immediately during the block traversal — no deferred tree is built,
## avoiding self-referential `Array[Tester]` type cycles. Pass/fail/pending
## counts are accumulated on the active Runner via the C-static slot.
class Tester
  name: String
  hooks_before: Array[any Fn[Fn() -> nil]]
  hooks_after: Array[any Fn[Fn() -> nil]]

  def init(name: &String)
    self.name = name.clone
    self.hooks_before = Array.new
    self.hooks_after = Array.new
  end

  def self.describe(name: &String, body: any Fn[Fn(&var Tester) -> nil]) -> nil
    let addr = Runner.get_current
    if addr != 0
      let r = Runner.from_handle(addr)
      r.note_group(name)
    end
    var root = Tester.new(name)
    body.(&var root)
  end

  def context(name: &String, body: any Fn[Fn(&var Tester) -> nil]) -> nil
    var child = Tester.new(name)
    for h in &self.hooks_before
      child.hooks_before.push(h)
    end
    for h in &self.hooks_after
      child.hooks_after.push(h)
    end
    body.(&var child)
  end

  def before(hook: any Fn[Fn() -> nil]) -> nil { self.hooks_before.push(hook) }

  def after(hook: any Fn[Fn() -> nil]) -> nil { self.hooks_after.push(hook) }

  def it(name: &String, body: any Fn[Fn() -> nil]) -> nil
    let runner_addr = Runner.get_current
    if runner_addr == 0
      return
    end
    let packed = self.run_case(body, "")
    let r = Runner.from_handle(runner_addr)
    if (packed & 1) == 1
      r.passed = r.passed + 1
      r.note_pass(name)
    else
      r.failed = r.failed + 1
      r.note_fail(name, packed)
    end
  end

  ## Passes only when the body panics AND the panic output on stderr
  ## contains `expected_substr`. The child's stderr is captured in a temp
  ## file so the parent can check the message after the child exits.
  def it_panics(name: &String, expected_substr: &String, body: any Fn[Fn() -> nil]) -> nil
    let runner_addr = Runner.get_current
    if runner_addr == 0
      return
    end
    let dir = match get("TMPDIR")
      Ok(v)  -> v
      Err(_) -> "/tmp"
    end
    let capture = dir + "/ruxen-it-panics-" + random_u64().to_s + ".stderr"
    let packed = self.run_case(body, &capture)
    let output = match read_to_string(&capture)
      Ok(text) -> text
      Err(_)   -> ""
    end
    let _ = remove_file(&capture)
    let r = Runner.from_handle(runner_addr)
    if (packed & 1) == 0 && output.include?(expected_substr)
      r.passed = r.passed + 1
      r.note_pass(name)
    else
      eputs(&output)
      r.failed = r.failed + 1
      r.note_fail(name, packed)
    end
  end

  ## Runs one case in a forked child: before hooks, the body, after hooks.
  ## The child exits 0 when no matcher failed. A non-empty `capture` path
  ## receives the child's stderr. Returns the packed `Runner.wait` status.
  def run_case(body: any Fn[Fn() -> nil], capture: &String) -> Int
    let pid = Runner.fork
    if pid == 0
      if capture.length > 0
        Tester.redirect_stderr(capture, capture.length)
      end
      Runner.case_reset
      for hook in &self.hooks_before
        hook.()
      end
      body.()
      for hook in &self.hooks_after
        hook.()
      end
      let code: Int = if Runner.case_get_failed == 0
          0
        else
          1
        end
      Runner.child_exit(code)
    end
    Runner.wait(pid)
  end

  def xit(name: &String, body: any Fn[Fn() -> nil]) -> nil
    let runner_addr = Runner.get_current
    if runner_addr == 0
      return
    end
    let r = Runner.from_handle(runner_addr)
    r.pending = r.pending + 1
    r.note_pending(name)
  end

  def expect[T](actual: T) -> Matcher[T] { Matcher.new(actual) }

  lib "runtime/test.c"
    def self.redirect_stderr as "ruxen_test_redirect_stderr"(path: &String, len: Int) -> Int
  end
end
