use std.env.get

## std.test.Runner — accumulates pass/fail/pending counts for one test file.
##
## Constructed by the synthesised `def main` (see ruxen test in
## `src/ruxenc/src/test_runner.rs`). The Runner is registered in a
## process-static C slot before any `Tester.describe` calls so that
## `Tester#it` can find and mutate the active runner's counts directly.
## Execution is eager (immediate) — no deferred group tree is built.
##
## Per-test reporting: as each `it`/`xit` runs, the Tester appends to
## `self.report` (in-memory, parent-side — no per-test I/O, no fork/stdio
## duplication). `execute` emits the whole report once, on stderr, so it
## survives the runner's per-file stdout capture. `report_mode` is read
## from `RUXEN_TEST_FORMAT` (set by the `ruxen test` runner per spawn):
##   1 = progress (RSpec-style dots: `.` pass, `F` fail, `*` pending)
##   2 = documentation (group name + `✓`/`✗`/`-` per case)
##   0 = quiet (tap/json renderers own the output)
class Runner
  passed: Int
  failed: Int
  pending: Int
  name: String
  report_mode: Int
  report: String

  def init(test_path: &String)
    self.passed = 0
    self.failed = 0
    self.pending = 0
    self.name = test_path.clone
    self.report = ""
    let fmt = match get("RUXEN_TEST_FORMAT")
      Ok(v)  -> v
      Err(_) -> "progress"
    end
    self.report_mode = match fmt
      "documentation" -> 2
      "progress"      -> 1
      _               -> 0
    end
  end

  def handle_addr -> Int { Runner.self_addr(self) }

  def var note_group(name: &String)
    if self.report_mode == 2
      self.report = self.report + name.clone + "\n"
    end
  end

  def var note_pass(name: &String)
    if self.report_mode == 1
      self.report = self.report + "."
    else
      if self.report_mode == 2
        self.report = self.report + "  ✓ " + name.clone + "\n"
      end
    end
  end

  def var note_fail(name: &String)
    if self.report_mode == 1
      self.report = self.report + "F"
    else
      if self.report_mode == 2
        self.report = self.report + "  ✗ " + name.clone + "\n"
      end
    end
  end

  def var note_pending(name: &String)
    if self.report_mode == 1
      self.report = self.report + "*"
    else
      if self.report_mode == 2
        self.report = self.report + "  - " + name.clone + " (pending)\n"
      end
    end
  end

  def execute -> nil
    if self.report.size() > 0
      eputs "#{self.report}"
    end
    puts("#{self.passed} passed, #{self.failed} failed, #{self.pending} pending")
  end

  lib "runtime/test.c"
    def self.set_current as "ruxen_test_current_set"(handle: Int) -> Int
    def self.get_current as "ruxen_test_current_get" -> Int
    def self.self_addr as "ruxen_test_runner_addr"(r: Runner) -> Int
    def self.from_handle as "ruxen_test_runner_from_addr"(addr: Int) -> &var Runner
    def self.case_reset as "ruxen_test_case_reset" -> Int
    def self.case_mark_failed as "ruxen_test_case_mark_failed" -> Int
    def self.case_get_failed as "ruxen_test_case_get_failed" -> Int
    def self.fork as "ruxen_test_fork" -> Int
    def self.wait as "ruxen_test_wait"(pid: Int) -> Int
    def self.child_exit as "ruxen_test_child_exit"(code: Int) -> nil
    def self.panic as "ruxen_test_panic" -> nil
  end
end
