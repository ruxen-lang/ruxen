## std::set — Set (formerly `HashSet`) method surface.
##
## #06.8 T#16: every method here was a `Set[T]_<m>` / `HashSet[T]_<m>`
## entry in the `name.starts_with("Set[") || ...` arm of
## `compiler/ruxen_core/src/codegen/runtime_table/mod.rs` until T#14's
## anchor-extension. Same shape as the Map migration: `Set` is NOT in
## type-scope (`resolve_type_expr` builds `Ty::Set(_)` from a
## hardcoded arm); the anchor branch creates a parent DefId for FFI
## bookkeeping without touching type-scope.
##
## Runtime C symbols carry the original `ruxen_set_*` prefix; the
## `Lowerer::resolve_ffi_alias_callee` fallback handles both `Set.new`
## (surface) and `HashSet.new` (legacy value-scope alias) by retrying
## the lookup with the base_type-mangled key after the runtime_base
## form misses.
class Set
  lib "../hash/runtime/hash.c"
    def self.new as "ruxen_set_new" -> Int
    def self.with_capacity as "ruxen_set_with_capacity"(cap: Int) -> Int
    def size as "ruxen_set_len" -> Int
    def empty? as "ruxen_set_is_empty" -> Bool
    def include? as "ruxen_set_contains"(item: Int) -> Bool
    def to_a as "ruxen_set_iter" -> Int
    def union as "ruxen_set_union"(other: Int) -> Int
    def intersection as "ruxen_set_intersection"(other: Int) -> Int
    def difference as "ruxen_set_difference"(other: Int) -> Int
    def insert as "ruxen_set_insert"(item: Int)
    def remove as "ruxen_set_remove"(item: Int) -> Bool
    def clear as "ruxen_set_clear"
  end
end
