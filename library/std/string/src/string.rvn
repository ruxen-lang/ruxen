class String
  lib "runtime/string.c"
    # ── Constructors (no `self`) ──────────────────────────────────
    def self.from as "riven_string_from"(s: &String) -> String
    def self.new as "riven_string_new"() -> String
    def self.with_capacity as "riven_string_with_capacity"(cap: Int) -> String
    # `from_bytes` reads each i64 slot's low byte and concatenates
    # them into a fresh String. Used by IO callers that pull raw
    # bytes (`TcpStream.read` / `BufReader.read`) and need a
    # String back — e.g. an HTTP request body that arrives as
    # `Content-Length` bytes after the header block.
    def self.from_bytes as "riven_string_from_bytes"(bytes: &Array[Int]) -> String

    # ── Read-only queries ─────────────────────────────────────────
    def len as "riven_string_len"(self) -> Int
    def is_empty as "riven_string_is_empty"(self) -> Bool
    def contains as "riven_string_contains"(self, needle: &String) -> Bool
    def starts_with as "riven_string_starts_with"(self, needle: &String) -> Bool
    def ends_with as "riven_string_ends_with"(self, needle: &String) -> Bool
    # `find` is typeck'd as `Option[USize]` but the runtime returns a
    # void* tagged Option box. Declaring `Int` keeps the cranelift
    # import signature wire-compatible (8 bytes either way); the MIR
    # decoder reads the boxed tag.
    def find as "riven_string_find"(self, needle: &String) -> Int

    # ── Pure transforms (return new String) ───────────────────────
    # `clone` is intentionally NOT migrated: it aliases the SAME C
    # symbol as `String.from` (`riven_string_from`) but with an
    # instance-method receiver shape. Two FFI decls aliasing the same
    # C symbol with different wire shapes trip E0722 by design. Until
    # the E0722 check is taught to compare at the wire level
    # (post-instance-self-prepend), `String_clone => riven_string_from`
    # stays in `codegen/runtime_table/mod.rs`. The runtime_table miss
    # path is the fallback when ffi_alias_map doesn't carry the
    # mangled callee, so leaving the entry there is a clean no-op.
    def trim as "riven_string_trim"(self) -> String
    def trim_start as "riven_string_trim_start"(self) -> String
    def trim_end as "riven_string_trim_end"(self) -> String
    def to_lower as "riven_string_to_lower"(self) -> String
    def to_upper as "riven_string_to_upper"(self) -> String
    def repeat as "riven_string_repeat"(self, n: Int) -> String
    def replace as "riven_string_replace"(self, from: &String, to: &String) -> String
    def as_str as "riven_string_as_str"(self) -> String
    def to_string as "riven_string_to_string"(self) -> String

    # ── Splitters / iterators ─────────────────────────────────────
    def chars as "riven_string_chars"(self) -> Array[Char]
    def lines as "riven_string_lines"(self) -> Array[String]
    def split as "riven_string_split"(self, delimiter: &String) -> Array[String]
    def splitn as "riven_string_splitn"(self, n: Int, delimiter: &String) -> Array[String]
    def bytes as "riven_string_bytes"(self) -> Array[Int]
    def into_bytes as "riven_string_into_bytes"(self) -> Array[Int]

    # ── Parsers (return tagged Result boxes — Int wire-compatible) ─
    def parse_int as "riven_string_parse_int"(self) -> Int
    def parse_float as "riven_string_parse_float"(self) -> Int

    # ── Mutating ops — MIR special-cases these for &mut String ────
    def push_str as "riven_string_push_str"(self, other: &String) -> String
    def push as "riven_string_push"(self, c: Char) -> String
    def clear as "riven_string_clear"(self)
    def truncate as "riven_string_truncate"(self, n: Int)
    def insert as "riven_string_insert"(self, i: Int, codepoint: Int) -> String
    def insert_str as "riven_string_insert_str"(self, i: Int, part: &String) -> String
    # `remove` returns a 16-byte {removed: Char, new_buffer: ptr} struct;
    # MIR reads field 0 for the returned Char and field 1 to update the
    # local. Declared as `Int` so the cranelift sig is one i64 register.
    def remove as "riven_string_remove"(self, i: Int) -> Int
  end
end
