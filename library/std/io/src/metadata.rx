## std::io::Metadata — flat-heap-struct accessor surface returned by
## `File.metadata()` / `fs.metadata(path)`. Declared in io (rather
## than fs) so File.metadata's lib decl can reference Metadata as a
## return type at parse time (fs.rx loads AFTER io.rx in
## BOOTSTRAP_FILES). The C runtime lives in fs.c so the lib path is
## cross-package (`../fs/runtime/fs.c`).
##
## Metadata is NOT in user_drop_classes — its spine carries no inner
## heap; the flat-struct accessors below read fixed offsets and
## scope-exit cleanup goes through the generic `ruxen_dealloc` path.
## `free` is a user-callable explicit release for callers holding a
## long-lived reference.
## `layout c` pins the Ruxen-side struct to the 3-int64 wire layout
## that `ruxen_fs_metadata` / `ruxen_file_metadata` fill via lstat(2) /
## fstat(2) (see `library/std/fs/runtime/fs.c`). Field order matches
## the C side's `meta[0]=size, meta[1]=modified, meta[2]=kind`. The
## `kind` field uses these tag values (mirroring RUXEN_METADATA_KIND_*
## in `library/std/core/runtime/runtime.h`):
##   0 = File, 1 = Dir, 2 = Symlink, 3 = Other
## All five accessors are pure-Ruxen field reads; the matching C
## `ruxen_metadata_{len,modified,is_file,is_dir,is_symlink}` were
## deleted in the same pass.
class Metadata
  size: Int
  modified_secs: Int
  kind: Int

  def len -> Int { self.size }

  def modified -> Int { self.modified_secs }

  def is_file -> Bool { self.kind == 0 }

  def is_dir -> Bool { self.kind == 1 }

  def is_symlink -> Bool { self.kind == 2 }

  lib "../fs/runtime/fs.c"
    def free as "ruxen_metadata_free" -> nil
  end
end
