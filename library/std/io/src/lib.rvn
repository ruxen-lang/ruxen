## std::io — stdio + File + buffered IO surface (partial migration).
##
## Wave 2 (#06.8) — partial migration:
## - 9 free fns (puts, eputs, print, println, eprintln, read_line,
##   stdin, stdout, stderr) fully migrated via the lib block below.
## - 7 class shells (Stdin, Stdout, Stderr, File, OpenOptions,
##   BufReader, BufWriter) migrated as bare `class Foo end` bodies;
##   methods still flow through the static-ctor + runtime_table
##   dispatch until T#20 / T#21 land.
##
## IoError + IoErrorKind + SeekFrom: all migrated in Wave 2 (#06.8)
## followup commits. Their variant-tag stability contracts are pinned
## by io_error_tag_stability and file_class_layout_stability
## respectively — both scan this file for declaration order (each
## variant's tag = its zero-based position in the enum body).
##
## println shares the riven_puts C symbol with puts (same trailing-
## newline behaviour); eprintln shares riven_eputs with eputs. The
## aliases here mirror that runtime_table convention.
##
## #06.95 Phase E Slice B.2 declares Stdin / Stdout / Stderr class
## methods (Result-typed reads and writes) via class-body lib decls.
## Those decls need `IoError` to be in scope at registration time,
## so the enum block precedes the class shells in this file. The
## io_error_tag_stability and file_class_layout_stability pin tests
## scan the enum bodies themselves — they are insensitive to the
## enum-vs-class ordering at the file level.

## IoError variants — variant order IS the load-bearing contract
## against `RIVEN_IO_ERROR_*` in library/runtime/io/io_error.c.
## DO NOT reorder. Append new variants at the END only. The
## `io_error_tag_stability` pin test scans this enum's declaration
## order (each variant's tag = its zero-based position).
enum IoError
  NotFound
  PermissionDenied
  AlreadyExists
  Interrupted
  WouldBlock
  InvalidInput
  UnexpectedEof
  BrokenPipe
  Other(message: String)
  ConnectionRefused(message: String)
  ConnectionReset(message: String)
  ConnectionAborted(message: String)
  NotConnected(message: String)
  AddrInUse(message: String)
  AddrNotAvailable(message: String)
  InvalidData(message: String)
  TimedOut(message: String)
  WriteZero(message: String)
  Unsupported(message: String)
  OutOfMemory(message: String)
end

## SeekFrom — three struct variants used as the second argument of
## `File.seek`. Each carries a single `offset: Int` field; the codegen
## lays the value out as a 16-byte tagged enum
## (`{i32 tag; i32 pad; i64 offset}`) which `riven_file_seek` reads
## directly. Tag values match `RIVEN_SEEK_FROM_*` in
## library/runtime/io/file.c — pinned by file_class_layout_stability,
## which scans this enum's declaration order.
enum SeekFrom
  Start(offset: Int)
  End(offset: Int)
  Current(offset: Int)
end

## IoErrorKind — sibling enum of 20 unit variants whose tag values
## match IoError 1:1. Returned by `IoError.kind()`; lets user code
## branch on the discriminant without inspecting the payload.
enum IoErrorKind
  NotFound
  PermissionDenied
  AlreadyExists
  Interrupted
  WouldBlock
  InvalidInput
  UnexpectedEof
  BrokenPipe
  Other
  ConnectionRefused
  ConnectionReset
  ConnectionAborted
  NotConnected
  AddrInUse
  AddrNotAvailable
  InvalidData
  TimedOut
  WriteZero
  Unsupported
  OutOfMemory
end

## Phase E-rest 4 of #06.95: instance methods on the IoError enum
## (`e.message()` / `e.kind()`) dispatched through runtime_table
## arms historically because Riven's enum bodies don't yet carry
## `lib` declarations. The workaround declares them here as bare
## top-level free fns whose names are LITERALLY the MIR-mangled
## callee shape — `IoError_message` / `IoError_kind`. The alias map
## populated from these `as "riven_io_error_*"` clauses rewrites
## the MIR callee before codegen consults runtime_table.
lib "runtime/io_error.c"
  def IoError_message as "riven_io_error_get_message"(err: IoError) -> String
  def IoError_kind as "riven_io_error_kind"(err: IoError) -> IoErrorKind
end

## std::io::Stdin — handle returned by the free fn `stdin()`. Wire
## shape is an opaque `void *` handle pointer. All read methods are
## Result-typed because the underlying read can fail.
##
## Migrated in #06.95 Phase E Slice B.2 from runtime_table.
class Stdin
  lib "runtime/stdio.c"
    def read_line as "riven_stdin_read_line"(self) -> Result[String, IoError]
    def read_to_string as "riven_stdin_read_to_string"(self) -> Result[String, IoError]
    def lines as "riven_stdin_lines"(self) -> Array[Result[String, IoError]]
  end
end

## std::io::Stdout — handle returned by `stdout()`. The Result-
## returning methods (`write_str`, `flush`) report a `WriteZero` /
## `Other` IoError on partial / failed writes; the `print` / `println`
## convenience pair swallow errors and return `()` — mirroring Rust's
## `print!` / `println!` macros at method-shape level.
##
## Migrated in #06.95 Phase E Slice B.2 from runtime_table.
class Stdout
  lib "runtime/stdio.c"
    def write_str as "riven_stdout_write_str"(self, s: &String) -> Result[(), IoError]
    def flush as "riven_stdout_flush"(self) -> Result[(), IoError]
    def print as "riven_stdout_print"(self, s: &String) -> ()
    def println as "riven_stdout_println"(self, s: &String) -> ()
  end
end

## std::io::Stderr — handle returned by `stderr()`. Same shape as
## Stdout: Result-typed `write_str` / `flush` plus error-swallowing
## `eprint` / `eprintln`.
##
## Migrated in #06.95 Phase E Slice B.2 from runtime_table.
class Stderr
  lib "runtime/stdio.c"
    def write_str as "riven_stderr_write_str"(self, s: &String) -> Result[(), IoError]
    def flush as "riven_stderr_flush"(self) -> Result[(), IoError]
    def eprint as "riven_stderr_eprint"(self, s: &String) -> ()
    def eprintln as "riven_stderr_eprintln"(self, s: &String) -> ()
  end
end

## std::io::Metadata — flat-heap-struct accessor surface returned by
## `File.metadata()` / `fs.metadata(path)`. Declared in io (rather
## than fs) so File.metadata's lib decl can reference Metadata as a
## return type at parse time (fs.rvn loads AFTER io.rvn in
## BOOTSTRAP_FILES). The C runtime lives in fs.c so the lib path is
## cross-package (`../fs/runtime/fs.c`).
##
## Metadata is NOT in user_drop_classes — its spine carries no inner
## heap; the flat-struct accessors below read fixed offsets and
## scope-exit cleanup goes through the generic `riven_dealloc` path.
## `free` is a user-callable explicit release for callers holding a
## long-lived reference.
class Metadata
  lib "../fs/runtime/fs.c"
    def len as "riven_metadata_len"(self) -> Int
    def modified as "riven_metadata_modified"(self) -> Int
    def is_file as "riven_metadata_is_file"(self) -> Bool
    def is_dir as "riven_metadata_is_dir"(self) -> Bool
    def is_symlink as "riven_metadata_is_symlink"(self) -> Bool
    def free as "riven_metadata_free"(self) -> ()
  end
end

## std::io::OpenOptions — fluent builder for `File.open_options`.
## Declared BEFORE File so File's `open_options` lib decl can
## reference it as a param type without a forward-reference miss.
##
## Setter `value` params declared as Int (not Bool) — the C runtime
## takes int8_t per setter, but Riven Bool emits as i64 at the
## call site (literal `true` is `i64 1`); declaring the lib decl
## param as Bool caused the cranelift verifier to reject the
## mismatched signature. Int matches the call ABI and the C side
## silently truncates the bottom byte (0 or 1).
class OpenOptions
  lib "runtime/file.c"
    def self.new as "riven_open_options_new"() -> OpenOptions
    def read as "riven_open_options_read"(self, value: Int) -> OpenOptions
    def write as "riven_open_options_write"(self, value: Int) -> OpenOptions
    def append as "riven_open_options_append"(self, value: Int) -> OpenOptions
    def truncate as "riven_open_options_truncate"(self, value: Int) -> OpenOptions
    def create as "riven_open_options_create"(self, value: Int) -> OpenOptions
    def create_new as "riven_open_options_create_new"(self, value: Int) -> OpenOptions
  end
end

## std::io::File — owning wrapper around a POSIX fd. The class-body
## lib block carries the static-ctor surface (`File.open` /
## `.create` / `.append` / `.open_options`) and the instance method
## surface (`read` / `write` / `seek` / `flush` / `close` / `drop`).
## Phase E-rest 1 of #06.95 moved these from `runtime_table` arms —
## the FFI alias map populated from `as "..."` clauses rewrites the
## MIR-mangled callee (`File_open` → `riven_file_open`) BEFORE
## codegen consults runtime_table.
##
## `File.metadata -> Result[Metadata, IoError]` stays on the
## runtime_table dispatch path because `Metadata` is declared in
## `library/std/fs/src/lib.rvn` which loads AFTER io.rvn — the
## forward reference would fail to resolve here. Migrating that one
## method needs Metadata to land in io.rvn (or fs to load earlier).
class File
  lib "runtime/file.c"
    def self.open as "riven_file_open"(path: &String) -> Result[File, IoError]
    def self.create as "riven_file_create"(path: &String) -> Result[File, IoError]
    def self.append as "riven_file_append"(path: &String) -> Result[File, IoError]
    def self.open_options as "riven_file_open_options"(path: &String, opts: &OpenOptions) -> Result[File, IoError]
    def read as "riven_file_read"(self, buf: &var Array[Int]) -> Result[Int, IoError]
    def read_to_string as "riven_file_read_to_string"(self) -> Result[String, IoError]
    def read_all as "riven_file_read_all"(self) -> Result[Array[Int], IoError]
    def write as "riven_file_write"(self, bytes: &Array[Int]) -> Result[Int, IoError]
    def write_all as "riven_file_write_all"(self, bytes: &Array[Int]) -> Result[(), IoError]
    def write_str as "riven_file_write_str"(self, s: &String) -> Result[(), IoError]
    def flush as "riven_file_flush"(self) -> Result[(), IoError]
    def seek as "riven_file_seek"(self, from: SeekFrom) -> Result[Int, IoError]
    def metadata as "riven_file_metadata"(self) -> Result[Metadata, IoError]
    def close as "riven_file_close"(self) -> Result[(), IoError]
    def drop as "riven_file_drop"(self) -> ()
  end
end

## BufReader / BufWriter classes moved to `library/std/bufio/src/lib.rvn`
## in Phase E.E of #06.95 — reshaped as `module BufReader { class File;
## class Tcp }` / `module BufWriter { class File; class Tcp }` to
## eliminate the MIR inner-arg-type sniff. The bufio package depends
## on both io (for File / IoError) and net (for TcpStream), so its
## .rvn loads after both in BOOTSTRAP_FILES.

## std::io kernel-level free fns — `puts` / `print` / `println` /
## `eputs` / `eprintln` / `read_line` / `stdin` / `stdout` / `stderr`
## stay GLOBAL like Ruby's Kernel#puts. Class-prefixing IO operations
## (`IO.puts(...)`) is non-idiomatic for a Ruby-flavored language and
## was rolled back in Phase C — only operation namespaces that don't
## have a Ruby-Kernel counterpart get class-prefixed (FS, Env, Path,
## Rand, Process, Time, Thread, Signal).
lib "runtime/stdio.c"
  def puts as "riven_puts"(value: &String) -> ()
  def eputs as "riven_eputs"(value: &String) -> ()
  def print as "riven_print"(value: &String) -> ()
  def println as "riven_puts"(value: &String) -> ()
  def eprintln as "riven_eputs"(value: &String) -> ()
  def read_line as "riven_read_line"() -> Result[String, IoError]
  def stdin as "riven_stdin"() -> Stdin
  def stdout as "riven_stdout"() -> Stdout
  def stderr as "riven_stderr"() -> Stderr
end
