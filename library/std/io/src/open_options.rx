## std::io::OpenOptions — fluent builder for `File.open_options`.
## Declared BEFORE File so File's `open_options` lib decl can
## reference it as a param type without a forward-reference miss.
##
## Setter `value` params declared as Int (not Bool) — the C runtime
## takes int8_t per setter, but Ruxen Bool emits as i64 at the
## call site (literal `true` is `i64 1`); declaring the lib decl
## param as Bool caused the cranelift verifier to reject the
## mismatched signature. Int matches the call ABI and the C side
## silently truncates the bottom byte (0 or 1).
class OpenOptions
  lib "runtime/file.c"
    def self.new as "ruxen_open_options_new" -> OpenOptions
    # Each C setter writes one flag in place and returns its receiver; the
    # fluent methods below hand the receiver itself back, so ownership of
    # the options passes along the chain (a builder that returns `self`).
    def set_read as "ruxen_open_options_read"(value: Int) -> OpenOptions
    def set_write as "ruxen_open_options_write"(value: Int) -> OpenOptions
    def set_append as "ruxen_open_options_append"(value: Int) -> OpenOptions
    def set_truncate as "ruxen_open_options_truncate"(value: Int) -> OpenOptions
    def set_create as "ruxen_open_options_create"(value: Int) -> OpenOptions
    def set_create_new as "ruxen_open_options_create_new"(value: Int) -> OpenOptions
  end

  def read(value: Bool) -> OpenOptions
    self.set_read(value as Int)
    self
  end

  def write(value: Bool) -> OpenOptions
    self.set_write(value as Int)
    self
  end

  def append(value: Bool) -> OpenOptions
    self.set_append(value as Int)
    self
  end

  def truncate(value: Bool) -> OpenOptions
    self.set_truncate(value as Int)
    self
  end

  def create(value: Bool) -> OpenOptions
    self.set_create(value as Int)
    self
  end

  def create_new(value: Bool) -> OpenOptions
    self.set_create_new(value as Int)
    self
  end
end
