## std::process — Command builder, ExitStatus, Output, exit().
##
## Wave 2 (#06.8) — partial migration. Same shape as net.rvn:
## - `exit(code) -> Never` is fully migrated (free fn via lib block;
##   c_symbol alias replaces the runtime_table entry).
## - `class Command end` / `class ExitStatus end` / `class Output end`
##   are class shells; their methods still flow through the
##   static-ctor + runtime_table dispatch in
##   mir/lower/expr/method_call.rs and codegen/runtime_table/mod.rs
##   until T#20 lands.
##
## `Command.spawn -> Child` (async-style handle with .wait / .kill /
## .try_wait) is explicitly DEFERRED to v2 per
## docs/prompts/v1/06_phase2_stdlib_io_fmt.md — v1 ships the blocking
## terminals (.status, .output) only.

## std::process namespace class — folds the `exit` free fn into
## `Process.exit`. Phase C of #06.95. Command / ExitStatus / Output
## remain separate classes (they're builder/result types, not
## namespace anchors). The bare `exit` lib block below is the
## transition shim — Ruby keeps a global `exit` too (Kernel#exit),
## so this shim is permanent, not strictly transitional.
class Process
  lib "runtime/process.c"
    def self.exit as "riven_process_exit"(code: Int) -> Never
  end
end

# Kernel-level `exit` (also available as Process.exit). Mirrors Ruby
# semantics — `exit` is global, Process.exit is the explicit
# namespaced spelling.
lib "runtime/process.c"
  def exit as "riven_process_exit"(code: Int) -> Never
end

class Command
end

## std::process::ExitStatus — flat-spine class wrapping a packed
## exit-code int (see `riven_exit_status_alloc` in
## library/std/process/runtime/process.c). Accessors read fixed
## offsets off the spine.
##
## Migrated in #06.95 Phase E Slice B.3 from runtime_table.
## ExitStatus is NOT in `user_drop_classes` (see
## mir/lower/collect.rs) — its scope-exit cleanup goes through
## the generic `riven_dealloc` path, NOT a `def drop` dispatch.
## The `free` method below is a user-callable explicit release;
## Output.status() returns a cloned ExitStatus that owns its own
## spine, so callers may want to release one early.
##
## Command / Output stay as bare class shells for now — adding
## class-body `def drop` decls to them triggered double-free /
## SIGABRT in stdlib_process fixtures (Slice B.3 first attempt,
## reverted). The interaction between a `def drop` lib decl and
## the `user_drop_classes` scope-exit pass needs a follow-up
## investigation before Command / Output can migrate.
class ExitStatus
  lib "runtime/process.c"
    def code as "riven_exit_status_code"(self) -> Int
    def success as "riven_exit_status_success"(self) -> Bool
    def free as "riven_exit_status_free"(self) -> ()
  end
end

class Output
end
