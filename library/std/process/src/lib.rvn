## std::process — Command builder, ExitStatus, Output, exit().
##
## Phase D-6 of #06.95: Command and Output gained their `def drop` lib
## decls and now drive the `user_drop_classes` auto-detect through the
## generic class-method walk in
## `mir/lower/collect.rs::collect_user_drop_classes` — no hardcoded
## compiler-side list entries required.
##
## Declaration order is load-bearing: `ExitStatus` and `Output` are
## declared BEFORE `Command` so the `Command.status -> Result[
## ExitStatus, IoError]` / `Command.output -> Result[Output, IoError]`
## return types resolve at bootstrap-merge time (forward-reference
## resolution isn't supported for lib-decl return types).
##
## `Command.spawn -> Child` (async-style handle with .wait / .kill /
## .try_wait) is explicitly DEFERRED to v2 per
## docs/prompts/v1/06_phase2_stdlib_io_fmt.md — v1 ships the blocking
## terminals (.status, .output) only.

## std::process namespace class — folds the `exit` free fn into
## `Process.exit`. Ruby keeps a global `exit` too (Kernel#exit), so
## the bare `exit` lib block below is permanent, not transitional.
class Process
  lib "runtime/process.c"
    def self.exit as "riven_process_exit"(code: Int) -> Never
  end
end

# Kernel-level `exit` (also available as Process.exit).
lib "runtime/process.c"
  def exit as "riven_process_exit"(code: Int) -> Never
end

## std::process::ExitStatus — flat-spine class wrapping a packed
## exit-code int. ExitStatus is NOT a drop class (no `def drop`); the
## generic `riven_dealloc` path handles spine cleanup. `free` is a
## user-callable explicit release.
class ExitStatus
  lib "runtime/process.c"
    def code as "riven_exit_status_code"(self) -> Int
    def success as "riven_exit_status_success"(self) -> Bool
    def free as "riven_exit_status_free"(self) -> ()
  end
end

## std::process::Output — captured stdout / stderr / status triple
## returned by `Command.output()`. The `def drop` lib decl drives the
## user_drop_classes auto-detect.
class Output
  lib "runtime/process.c"
    def stdout as "riven_output_stdout"(self) -> String
    def stderr as "riven_output_stderr"(self) -> String
    def status as "riven_output_status"(self) -> ExitStatus
    def drop as "riven_output_drop"(self) -> ()
  end
end

## std::process::Command — process-spawning builder. The terminal
## methods (`status`, `output`) consume self and return `Result`.
## Builder methods (`arg`, `args`, `env`, `current_dir`) mutate in
## place and return Self for chaining.
class Command
  lib "runtime/process.c"
    def self.new as "riven_command_new"(program: &String) -> Command
    def arg as "riven_command_arg"(self, arg: &String) -> Command
    def args as "riven_command_args"(self, args: &Array[String]) -> Command
    def env as "riven_command_env"(self, key: &String, value: &String) -> Command
    def current_dir as "riven_command_current_dir"(self, path: &String) -> Command
    def status as "riven_command_status"(self) -> Result[ExitStatus, IoError]
    def output as "riven_command_output"(self) -> Result[Output, IoError]
    def drop as "riven_command_drop"(self) -> ()
  end
end
