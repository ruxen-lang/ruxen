## --- AsyncReadLineFuture -----------------------------------------------
##
## Same shape as AsyncReadToStringFuture (library/std/async_fs/src/async_read_to_string_future.rx)
## except read terminates at '\n' or EOF rather than only at EOF, and the
## fd is implicit (0).
##
## State fields:
##   state_ptr — opaque pointer (as Int) to RuxenAsyncStdinState
##   handle    — reactor handle from register_fd_read; 0 when not
##               currently registered (re-armed on each fresh EAGAIN)
##   done      — 1 once poll has returned Ready
class AsyncReadLineFuture
  state_ptr: Int
  handle: Int
  done: Int
  include Future
  type Output = Result[String, IoError]

  def init
    self.state_ptr = ruxen_async_stdin_state_new()
    self.handle = 0
    self.done = 0
  end

  def var poll(cx: &var Context) -> Poll[Result[String, IoError]]
    if self.done == 0
      if ruxen_async_stdin_step(self.state_ptr) == 1
        let fd = ruxen_async_stdin_state_get_fd(self.state_ptr)
        self.handle = StepFuture.park_fd(cx, self.handle, fd, false)
        return Poll.Pending
      end
      self.handle = StepFuture.release(self.handle)
      self.done = 1
    end
    Poll.Ready(ruxen_async_stdin_state_take_result(self.state_ptr))
  end

  def drop
    self.handle = StepFuture.release(self.handle)
    if self.state_ptr != 0
      ruxen_async_stdin_state_free(self.state_ptr)
      self.state_ptr = 0
    end
  end
end
