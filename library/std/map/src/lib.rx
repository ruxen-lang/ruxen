## std::map — `Hash[K, V]` method surface (Ruby's Hash).
##
## `Hash` is NOT in `register_builtins`'s type-scope map — `let h:
## Hash[K, V]` resolves via the hardcoded arm in `resolve_type_expr`
## that builds `Ty::Map(_, _)` directly. The class below exists to
## register the FFI aliases (`Hash_<m>` → `ruxen_hash_<m>`) consumed
## by `Lowerer::resolve_ffi_alias_callee`.
##
## The internal `Ty::Map` variant and the `ruxen_hash_*` runtime
## symbols keep their legacy names; only the surface spelling is
## Ruby (`Hash`, never the Rust `Map` / `HashMap`).
class Hash
  lib "../hash/runtime/hash.c"
    def self.new as "ruxen_hash_new" -> Int
    def self.with_capacity as "ruxen_hash_with_capacity"(cap: Int) -> Int
    def size as "ruxen_hash_len" -> Int
    def empty? as "ruxen_hash_is_empty" -> Bool
    def get as "ruxen_hash_get"(key: Int) -> Int
    def key? as "ruxen_hash_contains_key"(key: Int) -> Bool
    def keys as "ruxen_hash_keys" -> Int
    def values as "ruxen_hash_values" -> Int
    def to_a as "ruxen_hash_entries" -> Int
    def insert as "ruxen_hash_insert"(key: Int, value: Int)
    def remove as "ruxen_hash_remove"(key: Int) -> Int
    def clear as "ruxen_hash_clear"
  end
end
