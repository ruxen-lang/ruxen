Tester.describe("Hash enumeration") do |t: &var Tester|
  t.it("reduce, select, all? and any? see key-value pairs") do
    let h: Hash[String, Int] = Hash.new
    h.insert("a", 1)
    h.insert("b", 2)
    h.insert("c", 3)
    let total = h.reduce(0) do |acc, kv| acc + kv.1 end
    t.expect(total).to_eq(6)
    let big = h.select do |kv| kv.1 >= 2 end
    t.expect(big.size).to_eq(2)
    t.expect(h.all? do |kv| kv.1 > 0 end).to_eq(true)
    t.expect(h.any? do |kv| kv.1 == 3 end).to_eq(true)
  end

  t.it("each_value and each_key") do
    var h: Hash[String, Int] = Hash.new
    h.insert("a", 1)
    h.insert("b", 2)
    var vsum = 0
    h.each_value do |v| vsum = vsum + v end
    t.expect(vsum).to_eq(3)
    var kcount = 0
    h.each_key do |_k| kcount = kcount + 1 end
    t.expect(kcount).to_eq(2)
  end
end
