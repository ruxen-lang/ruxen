## --- AsyncWriteFuture (B9) -----------------------------------------
##
## Persistent-fd-registration model: see AsyncReadFuture header for
## the full rationale. The AsyncTcpStream owns the edge-triggered
## write-readiness registration; this future just drives the step
## machine which loops until EAGAIN (drain-to-empty invariant required
## by edge-triggered).
class AsyncWriteFuture
  state_ptr: Int
  handle: Int
  done: Int
  include Future
  type Output = Result[Int, IoError]

  def init(fd: Int, content: &String, handle: Int)
    self.state_ptr = riven_async_tcp_write_state_new(fd, content)
    self.handle = handle
    self.done = 0
  end

  def var poll(cx: &var Context) -> Poll[Result[Int, IoError]]
    if self.done != 0
      return Poll.Ready(riven_async_tcp_write_state_take_result(self.state_ptr))
    end
    let step = riven_async_tcp_write_step(self.state_ptr)
    if step == 1
      let w = cx.waker
      riven_reactor_set_waker(riven_reactor_current_handle(), self.handle, w)
      return Poll.Pending
    end
    self.done = 1
    Poll.Ready(riven_async_tcp_write_state_take_result(self.state_ptr))
  end

  def drop
    if self.state_ptr != 0
      riven_async_tcp_write_state_free(self.state_ptr)
      self.state_ptr = 0
    end
  end
end
