## --- AsyncBindFuture (B6.5) ----------------------------------------
class AsyncBindFuture
  state_ptr: Int
  done: Int

  def init(addr: &String)
    self.state_ptr = ruxen_async_bind_state_new(addr)
    self.done = 0
  end

  def var poll(cx: &var Context) -> Poll[Result[AsyncTcpListener, IoError]]
    self.done = 1
    Poll.Ready(ruxen_async_bind_state_to_result(self.state_ptr))
  end

  def drop
    if self.state_ptr != 0
      ruxen_async_bind_state_free(self.state_ptr)
      self.state_ptr = 0
    end
  end

  include Future
end
