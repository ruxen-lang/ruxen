## --- AsyncReadFuture (B8) ------------------------------------------
class AsyncReadFuture
  state_ptr: Int
  handle: Int
  done: Int
  include Future
  type Output = Result[String, IoError]

  def init(fd: Int, max_bytes: Int)
    self.state_ptr = riven_async_tcp_read_state_new(fd, max_bytes)
    self.handle = 0
    self.done = 0
  end

  def var poll(cx: &var Context) -> Poll[Result[String, IoError]]
    if self.done != 0
      return Poll.Ready(riven_async_tcp_read_state_take_result(self.state_ptr))
    end
    let step = riven_async_tcp_read_step(self.state_ptr)
    if step == 1
      if self.handle == 0
        let fd = riven_async_tcp_read_state_get_fd(self.state_ptr)
        self.handle = riven_reactor_register_fd_read(riven_reactor_current_handle(), fd)
      end
      return Poll.Pending
    end
    if self.handle != 0
      riven_reactor_deregister(riven_reactor_current_handle(), self.handle)
      self.handle = 0
    end
    self.done = 1
    Poll.Ready(riven_async_tcp_read_state_take_result(self.state_ptr))
  end

  def drop
    if self.handle != 0
      riven_reactor_deregister(riven_reactor_current_handle(), self.handle)
      self.handle = 0
    end
    if self.state_ptr != 0
      riven_async_tcp_read_state_free(self.state_ptr)
      self.state_ptr = 0
    end
  end
end
