## --- AsyncConnectFuture (B7) ---------------------------------------
class AsyncConnectFuture
  state_ptr: Int
  handle: Int
  done: Int
  include Future
  type Output = Result[AsyncTcpStream, IoError]

  def init(addr: &String)
    self.state_ptr = ruxen_async_connect_state_new(addr)
    self.handle = 0
    self.done = 0
  end

  def var poll(cx: &var Context) -> Poll[Result[AsyncTcpStream, IoError]]
    if self.done == 0
      if ruxen_async_connect_step(self.state_ptr) == 1
        let fd = ruxen_async_connect_state_get_fd(self.state_ptr)
        self.handle = StepFuture.park_fd(cx, self.handle, fd, true)
        return Poll.Pending
      end
      self.handle = StepFuture.release(self.handle)
      self.done = 1
    end
    Poll.Ready(connect_state_to_result(self.state_ptr))
  end

  def drop
    self.handle = StepFuture.release(self.handle)
    if self.state_ptr != 0
      ruxen_async_connect_state_free(self.state_ptr)
      self.state_ptr = 0
    end
  end
end
