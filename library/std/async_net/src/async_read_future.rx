## --- AsyncReadFuture (B8) ------------------------------------------
##
## Persistent-fd-registration model: the AsyncTcpStream owns the
## edge-triggered read-readiness registration for the whole stream
## lifetime, so this future no longer registers or deregisters per
## poll. The `handle` field is retained for ABI symmetry with the
## other futures but is unused on the hot path; the persistent
## registration on the parent stream is what wakes park_current when
## fresh bytes arrive on the wire.
##
## Edge-triggered correctness: ruxen_async_tcp_read_step's inner loop
## drains read(2) until EAGAIN before returning 1, which is the
## edge-triggered drain-to-empty invariant. Returning Pending after
## EAGAIN is safe — the next edge (more bytes arriving) will wake the
## task. See reactor.c::ruxen_reactor_register_fd_read_persistent for
## the contract.
class AsyncReadFuture
  state_ptr: Int
  handle: Int
  done: Int

  def init(fd: Int, max_bytes: Int, handle: Int)
    self.state_ptr = ruxen_async_tcp_read_state_new(fd, max_bytes)
    self.handle = handle
    self.done = 0
  end

  def var poll(cx: &var Context) -> Poll[Result[String, IoError]]
    if self.done != 0
      return Poll.Ready(ruxen_async_tcp_read_state_take_result(self.state_ptr))
    end
    let step = ruxen_async_tcp_read_step(self.state_ptr)
    if step == 1
      let w = cx.waker
      ruxen_reactor_set_waker(ruxen_reactor_current_handle, self.handle, w)
      return Poll.Pending
    end
    self.done = 1
    Poll.Ready(ruxen_async_tcp_read_state_take_result(self.state_ptr))
  end

  def drop
    if self.state_ptr != 0
      ruxen_async_tcp_read_state_free(self.state_ptr)
      self.state_ptr = 0
    end
  end

  include Future
end
