## Demonstrates auto-synthesised Debug for structs. The compiler
## generates a printable representation usable in `:?` interpolation.

struct Point
  x: Int
  y: Int
end

struct Line
  from: Point
  to: Point
end

def main
  let origin = Point.new(0, 0)
  let target = Point.new(3, 4)
  let segment = Line.new(origin, target)
  puts "#{segment:?}"
end
